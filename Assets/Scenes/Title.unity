  m_text: "\uCC98\uC74C\uBD80\uD130 \uB05D\uAE4C\uC9C0 \uB9CC\uB4E4\uC5B4\uC11C \uAD6C\uAE00
    \uB9C8\uCF13\uC5D0 \uCD9C\uC2DC\uD574\uBCF8 \uCCAB \uBC88\uC9F8 \uAC8C\uC784\uC785\uB2C8\uB2E4\r\n\r\n\uB9CC\uB4E4\uBA74\uC11C
    \uC0DD\uAC01\uBCF4\uB2E4 \uB9CE\uC740 \uC2DC\uD589\uCC29\uC624\uB97C \uACAA\uC5C8\uACE0,\r\n\uAC00\uB054\uC740
    \uC815\uB9D0 \uC774\uAC78 \uC644\uC131\uD560 \uC218 \uC788\uC744\uAE4C \uACE0\uBBFC\uD558\uAE30\uB3C4
    \uD588\uC2B5\uB2C8\uB2E4\r\n\r\n\uC544\uC9C1 \uB9CE\uC774 \uBD80\uC871\uD55C
    \uAC8C\uC784\uC774\uC9C0\uB9CC, \r\n\uC5EC\uB7EC\uBD84\uB4E4\uC774 \uC774 \uAC8C\uC784\uC744
    \uBC1C\uACAC\uD558\uACE0 \uD50C\uB808\uC774 \uD574\uC8FC\uC2E0 \uAC83\uC740\r\n\uC815\uB9D0
    \uD76C\uBC15\uD55C, \uC218\uBC31\uB9CC \uBD84\uC758 1 \uD655\uB960\uC758 \uC6B0\uC5F0\uC774
    \uC544\uB2D0\uAE4C \uC0DD\uAC01\uD569\uB2C8\uB2E4.\r\n\r\n\uAC04\uB2E8\uD55C
    \uC120\uD0DD\uC9C0 \uBC29\uC2DD\uC73C\uB85C \uC2A4\uD1A0\uB9AC\uB97C \uAC10\uC0C1\uD558\uB294
    \uC791\uC740 \uAC8C\uC784\uC774\uC9C0\uB9CC \r\n\uC870\uAE08\uC774\uB77C\uB3C4

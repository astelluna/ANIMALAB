%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialogLocalizationTable_ko
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 555e031b6ab57ea47a26da4db4a1ebac, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 147044159660032
    m_Localized: "\uC73D... \uBA38\uB9AC\uAC00... \uC5EC\uAE34 \uC5B4\uB514\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044197408768
    m_Localized: "\uC8FC\uBCC0\uC5D0\uB294 \uBD89\uC740\uBE5B\uC758 \uBE44\uC0C1\uB4F1\uC774
      \uAE5C\uBE61\uC774\uBA70 \uBE5B\uC744 \uB0B4\uACE0 \uC788\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044197408769
    m_Localized: "\uC0DD\uAC01\uC774... \uC548 \uB098. \uB0B4\uAC00 \uC5EC\uAE30\uC11C
      \uBB58 \uD558\uACE0 \uC788\uC5C8\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044197408770
    m_Localized: "\uADF8\uB54C, \uBB38\uB4DD \uD558\uB098\uC758 \uAE30\uC5B5\uC774
      \uC2A4\uCCE4\uB2E4. \uB204\uAD70\uAC00\uC640 \uACA9\uB82C\uD558\uAC8C \uC2F8\uC6B0\uACE0
      \uC788\uC5C8\uACE0... \n\uC190\uC5D0 \uB4E4\uACE0 \uC788\uB358 \uCE58\uB8CC\uC81C
      \uC570\uD50C\uC774 \uAE68\uC84C\uB2E4. \uADF8 \uC774\uD6C4\uC758 \uAE30\uC5B5\uC740
      \uAE30\uC5B5\uC774 \uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797376
    m_Localized: "\uADF8 \uC21C\uAC04. \uCEF4\uD4E8\uD130 \uD654\uBA74\uC774 \uCF1C\uC9C0\uBA70
      \uBA54\uC138\uC9C0\uAC00 \uCD9C\uB825\uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797377
    m_Localized: "`===== \uBE44\uC0C1 \uC0DD\uBB3C\uC7AC\uD574 \uC2DC\uC2A4\uD15C
      \uAC00\uB3D9 =====\n\uC2DC\uC124 \uD3D0\uC1C4 \uC644\uB8CC. \uC678\uBD80 \uD1B5\uC2E0
      \uCC28\uB2E8. \uAC10\uC5FC\uC790 : 5\uBA85\n\uBC31\uC2E0 \uBCF4\uAD00 \uC704\uCE58
      : [\uC554\uD638\uD654\uB428], \uBC31\uC2E0 \uBCF4\uAD00 \uC218\uB7C9 : 2\n\uC2DC\uC124
      \uD574\uC81C \uCF54\uB4DC \uC785\uB825 \uB300\uAE30 \uC911...`"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797378
    m_Localized: "\u2026\u2026\uAC10\uC5FC\uC790 5\uBA85? \uAC10\uC5FC\uC790? \uBC31\uC2E0?
      \uB3C4\uB300\uCCB4 \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB09C \uAC70\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797379
    m_Localized: "\uC6C0\uC9C1\uC774\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797380
    m_Localized: "\uB098\uB294 \uCC9C\uCC9C\uD788 \uB4A4\uB97C \uB3CC\uC544\uBD24\uB2E4.
      \uC5F0\uAD6C\uC2E4 \uD55C\uCABD\uC5D0 \uB124 \uBA85\uC758 \uC5EC\uC131\uC774
      \uB098\uB97C \uBC14\uB77C\uBCF4\uACE0 \uC788\uC5C8\uB2E4. \n\uD558\uC9C0\uB9CC...
      \uADF8\uB4E4\uC758 \uBAA8\uC2B5\uC740 \uD3C9\uBC94\uD55C \uC778\uAC04\uACFC
      \uB2EC\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797381
    m_Localized: "\uD55C \uBA85\uC740 \uBA38\uB9AC \uC704\uC5D0 \uAC15\uC544\uC9C0
      \uAC19\uC740 \uADC0\uAC00 \uB3CB\uC544\uB098 \uC788\uC5C8\uB2E4. \n\uD55C \uBA85\uC740
      \uB0A0\uCE74\uB85C\uC6B4 \uC5EC\uC6B0 \uAC19\uC740 \uB208\uB9E4\uC640 \uADC0\uB97C
      \uAC00\uC9C0\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797382
    m_Localized: "\uD55C \uBA85\uC740 \uD1A0\uB07C\uCC98\uB7FC \uAE34 \uADC0\uAC00
      \uB5A8\uB9AC\uACE0 \uC788\uC5C8\uB2E4. \n\uADF8\uB9AC\uACE0 \uB9C8\uC9C0\uB9C9
      \uD55C \uBA85\uC740 \uBA38\uB9AC \uC704\uC5D0 \uC591\uCC98\uB7FC \uC0DD\uAE34
      \uBFD4\uC774 \uBCF4\uC600\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797383
    m_Localized: "\uB098\uB3C4 \uBAA8\uB974\uAC8C \uC190\uC744 \uBC14\uB77C\uBD24\uB2E4.
      \uC190\uB05D\uC774 \uC800\uB9BF\uD588\uB2E4. \uBD88\uC548\uD55C \uB9C8\uC74C\uC73C\uB85C
      \uADFC\uCC98 \uAE68\uC9C4 \uAC70\uC6B8\uC744 \uBC14\uB77C\uBCF4\uC558\uB2E4.
      \n\uADF8\uB9AC\uACE0. \uB0B4 \uBA38\uB9AC \uC704\uC5D0\uB3C4. \uBB34\uC5B8\uAC00\uAC00
      \uC790\uB77C\uB098 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797384
    m_Localized: "\uB2F9\uC2E0\u2026 \uAE68\uC5B4\uB0AC\uAD6C\uB098. \uB2E4\uD589\uC774\uC57C.
      \uB2F9\uC2E0\uC740 \uC5F0\uAD6C\uC6D0\uC774\uC796\uC544? \uC774\uAC8C \uC5B4\uB5BB\uAC8C
      \uB41C \uAC74\uC9C0 \uC54C\uACE0 \uC788\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797385
    m_Localized: "\uBD84\uBA85 \uAE30\uC5B5\uB098\uB294 \uAC74 \uC788\uC5B4. \uC6B0\uB9AC\uAC00
      \uC2E4\uD5D8 \uB54C\uBB38\uC5D0 \uC774 \uBC29\uC5D0 \uBAA8\uC600\uB2E4\uB294
      \uAC83. \n\uADF8\uB7F0\uB370 \uB208\uC744 \uB5A0\uBCF4\uB2C8 \uC2DC\uC124\uC740
      \uD3D0\uC1C4\uB418\uC5B4 \uC788\uACE0... \uBAB8\uC740 \uC774\uB807\uAC8C \uBCC0\uD574\uC788\uC5B4.
      \uC124\uBA85\uD574\uBD10. \uC5F0\uAD6C\uC6D0."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797386
    m_Localized: "\uD750\uC73D\u2026\u2026 \uC65C\u2026\u2026 \uC65C \uB2E4\uB4E4
      \uC774\uC0C1\uD558\uAC8C \uBCC0\uD55C \uAC70\uC57C? \uBB34\uC11C\uC6CC\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797387
    m_Localized: "\uC774\uAC74\u2026\u2026 \uC6D0\uB798 \uC5C6\uC5C8\uB294\uB370.
      \uC65C \uC774\uB7F0 \uAC8C \uC0DD\uAE34 \uAC70\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797388
    m_Localized: "\uB098\uB294 \uADF8\uB4E4\uC744 \uBC14\uB77C\uBD24\uB2E4. \uBD84\uBA85.
      \uB098\uB294 \uC774\uB4E4\uACFC \uAD00\uB828\uC774 \uC788\uC5C8\uB2E4. \n\uD558\uC9C0\uB9CC
      \uC544\uBB34\uB9AC \uAE30\uC5B5\uD558\uB824 \uD574\uB3C4 \uB5A0\uC624\uB974\uC9C0
      \uC54A\uC558\uB2E4. \uBAA8\uB450\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB0AF\uC124\uC9C0
      \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797389
    m_Localized: "\uC774 \uC911 \uB204\uAD70\uAC00\uC640 \uC2F8\uC6B0\uB2E4\uAC00
      \uBC14\uC774\uB7EC\uC2A4 \uC570\uD50C\uC774 \uAE68\uC9C4 \uAC78\uAE4C? \uD558\uC9C0\uB9CC
      \uB204\uAD6C\uC778\uC9C0. \n\uC65C \uB2E4\uB4E4 \uB0AF\uC124\uC9C0 \uC54A\uC740\uC9C0
      \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC558\uB2E4. \uB0B4 \uBA38\uB9BF\uC18D\uC740
      \uC5EC\uC804\uD788 \uD63C\uB780\uC2A4\uB7EC\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797390
    m_Localized: "\uBB50... \uC6B0\uB9AC \uC774\uACF3\uC5D0 \uAC07\uD78C \uBAA8\uC591\uC778\uB370
      \uC790\uAE30\uC18C\uAC1C\uB77C\uB3C4 \uD560\uAE4C? \uB098\uB294 \uC724\uC11C\uC9C4.
      \n\uC74C... \uAD73\uC774 \uC774\uB984\uAE4C\uC9C0 \uC678\uC6B8 \uAC74 \uC5C6\uACE0,
      \uADF8\uB0E5 \uC5EC\uC6B0\uB77C\uACE0 \uBD88\uB7EC\uB3C4 \uB3FC"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797391
    m_Localized: "\uC724\uC11C\uC9C4\uC774\uB77C\uACE0 \uC790\uC2E0\uC744 \uC18C\uAC1C\uD55C
      \uC0AC\uB78C\uC740 \uBA38\uB9AC \uC704\uC758 \uADC0\uB97C \uB9CC\uC9C0\uBA70
      \uBA4B\uCA4D\uC740 \uB4EF \uC790\uC2E0\uC744 \uC18C\uAC1C\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797392
    m_Localized: "\uC800\uB294 \uAC15\uC608\uB098\uC608\uC694... \uC74C, \uADF8\uB0E5
      \uAC15\uC544\uC9C0\uB77C\uAE30\uBCF4\uB2E8... \uB9AC\uD2B8\uB9AC\uBC84\uB77C\uACE0
      \uBD88\uB7EC\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797393
    m_Localized: "\uC804 \uB3C4\uC544\uB9B0\uC774\uC5D0\uC694\u2026 \uD1A0\uB07C\uB77C\uACE0
      \uBD88\uB7EC\uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797394
    m_Localized: "\uB098\uB9CC \uBFD4\uC774 \uB2EC\uB824 \uC788\uB124... \uC74C,
      \uB098\uB294 \uBC31\uC11C\uC724\uC774\uC57C. \uB531 \uBD10\uB3C4 \uC591\uC774\uC9C0?
      \uADF8\uB0E5 \uC591\uC774\uB77C\uACE0 \uBD88\uB7EC."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797395
    m_Localized: "\uADF8\uB798 \uADF8\uB798\uC11C \uB2F9\uC2E0\uC740 \uC5B4\uB54C?
      \uC774\uB984\uC774 \uBB50\uC57C? \n\uC5F0\uAD6C\uC6D0 \uAC19\uC544 \uBCF4\uC774\uB294\uB370
      \uC65C \uC5F0\uAD6C\uC2E4\uC774 \uD3D0\uC1C4\uB41C\uC9C0 \uC54C\uACE0\uC788\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797396
    m_Localized: "\uB2F9\uC2E0\uC758 \uCCAB \uBC18\uC751\uC740?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797397
    m_Localized: "\u2026\u2026\uAE30\uC5B5\uC774 \uC5C6\uC2B5\uB2C8\uB2E4. \uB9C8\uC9C0\uB9C9
      \uAE30\uC5B5\uC740 \uCE58\uB8CC\uC81C \uC570\uD50C\uC774 \uAE68\uC9C4 \uC21C\uAC04\uBFD0\uC785\uB2C8\uB2E4.
      \n\uC774 \uC2DC\uC124\uC5D0\uC11C \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB294\uC9C0
      \uB098\uB3C4 \uBAA8\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797398
    m_Localized: "\uAE30\uC5B5 \uC0C1\uC2E4? \uD765... \uD3B8\uB9AC\uD55C \uBCC0\uBA85\uC774\uAD70.
      \uC570\uD50C\uC774 \uAE68\uC84C\uB2E4\uB294 \uAC83\uB3C4 \uC758\uC2EC\uC2A4\uB7EC\uC6CC.
      \n\uC5F0\uAD6C\uC6D0\uC778 \uB2F9\uC2E0\uC774 \uBAA8\uB978\uB2E4\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797399
    m_Localized: "\uADF8\uB798\uB3C4\u2026\u2026 \uAC70\uC9D3\uB9D0\uD558\uB294 \uD45C\uC815\uC740
      \uC544\uB2CC \uAC83 \uAC19\uC544\uC694. \uC5EC\uAE30\uC5D0 \uB0A8\uC544\uC788\uB294
      \uC774\uC720\uAC00 \uBD84\uBA85 \uC788\uC744 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797400
    m_Localized: "\uC5EC\uC6B0\uB294 \uC5EC\uC804\uD788 \uC758\uC2EC\uC758 \uB208\uCD08\uB9AC\uB97C
      \uAC70\uB450\uC9C0 \uC54A\uC558\uC9C0\uB9CC \uB9AC\uD2B8\uB9AC\uBC84\uB294
      \uC870\uAE08 \uB204\uADF8\uB7EC\uC9C4 \uD45C\uC815\uC73C\uB85C \uB098\uB97C
      \uBC14\uB77C\uBD24\uB2E4. \n\uC591\uACFC \uD1A0\uB07C\uB294 \uBD88\uC548\uD55C
      \uC2DC\uC120\uC73C\uB85C \uC6B0\uB9AC\uB97C \uBC88\uAC08\uC544 \uBCF4\uC558\uB2E4.\n(\uBAA8\uB4E0
      \uCE90\uB9AD\uD130 \uD638\uAC10\uB3C4 +20)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797401
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797402
    m_Localized: "\uB9D0\uD560 \uC0DD\uAC01\uC774 \uC5C6\uB294 \uAC74\uAC00? \uC544\uB2C8\uBA74
      \uC815\uB9D0 \uBAA8\uB974\uB294 \uAC74\uAC00? \uC5B4\uB290 \uCABD\uC774\uB4E0
      \uC2E0\uB8B0\uD558\uAE30 \uC5B4\uB835\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797403
    m_Localized: "\u2026\u2026\uB9D0\uD574\uC904 \uC218 \uC5C6\uB098\uC694? \uB2F9\uC2E0\uC774
      \uC774\uACF3\uC758 \uC5F0\uAD6C\uC6D0\uC774\uB77C\uBA74... \uC6B0\uB9AC\uC5D0\uAC8C
      \uC54C\uB824\uC918\uC57C \uD560 \uC758\uBB34\uAC00 \uC788\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797404
    m_Localized: "\uB098\uC758 \uCE68\uBB35\uC5D0 \uC5EC\uC6B0\uC758 \uB208\uB9E4\uB294
      \uB354\uC6B1 \uB0A0\uCE74\uB85C\uC6CC\uC84C\uACE0 \uB9AC\uD2B8\uB9AC\uBC84\uC758
      \uD45C\uC815\uC5D0\uB294 \uC2E4\uB9DD\uAC10\uC774 \uC2A4\uCCE4\uB2E4. \n\uD1A0\uB07C\uB294
      \uB354\uC6B1 \uC6C0\uCE20\uB7EC\uB4E4\uC5C8\uACE0 \uC591\uC740 \uC54C \uC218
      \uC5C6\uB294 \uBBF8\uC18C\uB97C \uC9C0\uC5C8\uB2E4.\n(\uBAA8\uB4E0 \uCE90\uB9AD\uD130
      \uD638\uAC10\uB3C4 -20)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797405
    m_Localized: "\uB098\uB294 \uCEF4\uD4E8\uD130 \uD654\uBA74\uC744 \uB2E4\uC2DC
      \uBC14\uB77C\uBD24\uB2E4. \uBE44\uC0C1 \uC2DC\uC2A4\uD15C. \uC0DD\uC874\uC790.
      \uAC10\uC5FC\uC790. \uADF8\uB9AC\uACE0 \uBC31\uC2E0. \n\uC870\uAE08\uC529 \uAE30\uC5B5\uC758
      \uC870\uAC01\uC774 \uB9DE\uCDB0\uC9C0\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797406
    m_Localized: "\uC774\uACF3\uC740 \uB2E8\uC21C\uD55C \uC5F0\uAD6C\uC2DC\uC124\uC774
      \uC544\uB2C8\uC5C8\uB2E4. \uBD88\uCE58\uBCD1 \uCE58\uB8CC\uB97C \uC704\uD55C
      \uC5F0\uAD6C\uC2DC\uC124. \n\uD558\uC9C0\uB9CC \uCE58\uB8CC \uACFC\uC815\uC5D0\uC11C
      \uC608\uC0C1\uD558\uC9C0 \uBABB\uD55C \uBD80\uC791\uC6A9\uC774 \uBC1C\uACAC\uB410\uB2E4.\n\uC778\uAC04\uC758
      \uC2E0\uCCB4\uAC00 \uBCC0\uD654\uD558\uC5EC \uB3D9\uBB3C\uC758 \uD2B9\uC9D5\uC774
      \uB098\uD0C0\uB098\uB294 \uBCC0\uC774. \uC218\uC778\uD654. \uC544\uB9C8 \uCE58\uB8CC\uC81C
      \uC570\uD50C\uC774 \uAE68\uC9C0\uBA74\uC11C\u2026 \uC774 \uBCC0\uD654\uAC00
      \uC2DC\uC791\uB41C \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797407
    m_Localized: "\uC218\uC778\uD654\uC5D0 \uB300\uD574 \uC124\uBA85\uD560\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797408
    m_Localized: "\uB098\uB294 \uC228\uACA8\uC654\uB358 \uC0AC\uC2E4\uC744 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797409
    m_Localized: "\uB2F9\uC2E0\uB4E4\uC758 \uBCC0\uD654\uB294 \uCE58\uB8CC\uC81C\uC758
      \uBD80\uC791\uC6A9\uC77C \uAC00\uB2A5\uC131\uC774 \uB192\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797410
    m_Localized: "\uBD80\uC791\uC6A9\u2026\u2026? \uADF8\uAC8C \uBB34\uC2A8 \uB9D0\uC774\uC5D0\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797411
    m_Localized: "\uD1A0\uB07C\uB294 \uACE0\uAC1C\uB97C \uAC38\uC6B0\uB6B1\uD558\uBA70
      \uBAA8\uB974\uACA0\uB2E4\uB294 \uD45C\uC815\uC744 \uC9C0\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797412
    m_Localized: "\uD558... \uADF8\uB7FC \uC774 \uBAA8\uC2B5\uC774 \uCE58\uB8CC \uC2E4\uD328\uC758
      \uACB0\uACFC\uB77C\uB294 \uAC70\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797413
    m_Localized: "\uD558\uC9C0\uB9CC\u2026\u2026 \uBAB8 \uC0C1\uD0DC\uB294 \uC88B\uC544\uC84C\uC5B4\uC694.
      \uC804\uBCF4\uB2E4 \uC6C0\uC9C1\uC774\uAE30 \uD3B8\uD574\uC84C\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797414
    m_Localized: "\uADF8\uB7FC\u2026\u2026 \uBCD1\uC740 \uCE58\uB8CC\uB41C \uAC74\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797415
    m_Localized: "\uB098\uB294 \uACE0\uAC1C\uB97C \uC800\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797416
    m_Localized: "\uCE58\uB8CC\uB294 \uC131\uACF5\uD588\uC744 \uAC00\uB2A5\uC131\uC774
      \uC788\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uC774 \uBCC0\uD654\uB97C \uB418\uB3CC\uB9AC\uB824\uBA74\u2026\u2026
      \n\uB2E4\uB978 \uCE58\uB8CC\uC81C\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4.\n(\uBAA8\uB4E0
      \uCE90\uB9AD\uD130 \uD638\uAC10\uB3C4 +20)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797417
    m_Localized: "\uB098\uB294 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797418
    m_Localized: "\uC21C\uAC04 \uB124 \uBA85\uC758 \uC2DC\uC120\uC774 \uC870\uAE08\uC529
      \uBCC0\uD588\uB2E4.\uC758\uC2EC \uBD88\uC548 \uADF8\uB9AC\uACE0 \uBD88\uD3B8\uD55C
      \uCE68\uBB35.\n\uB0B4\uAC00 \uC544\uBB34\uAC83\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uB294
      \uAC83\uC774 \uC624\uD788\uB824 \uADF8\uB4E4\uC5D0\uAC8C\uB294 \uBB34\uC5B8\uAC00\uB97C
      \uC228\uAE30\uB294 \uAC83\uCC98\uB7FC \uBCF4\uC774\uB294 \uB4EF\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797419
    m_Localized: "\uC800... \uD639\uC2DC..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797420
    m_Localized: "\uC591\uC740 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uC790\uC2E0\uC758
      \uBA38\uB9AC \uC704\uC5D0 \uB3CB\uC544\uB09C \uBFD4\uC744 \uB9CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797421
    m_Localized: "\uC774\uAC74... \uC800\uD76C\uAC00 \uBC1B\uC558\uB358 \uBD88\uCE58\uBCD1
      \uCE58\uB8CC\uC81C\uC758 \uBD80\uC791\uC6A9 \uC544\uB2D0\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797422
    m_Localized: "\uADF8 \uB9D0\uC5D0 \uBAA8\uB450\uC758 \uC2DC\uC120\uC774 \uC7A0\uC2DC
      \uBA48\uCDC4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797423
    m_Localized: "\uBD80\uC791\uC6A9...? \uD655\uC2E4\uD788 \uC774\uC0C1\uD574\uC694.
      \uADF8\uB7F0\uB370... \uC774\uC0C1\uD560 \uC815\uB3C4\uB85C \uBAB8 \uC0C1\uD0DC\uAC00
      \uC88B\uC544\uC84C\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797424
    m_Localized: "\uBD80\uC791...\uC6A9? \uADF8\uAC8C... \uBB54\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797425
    m_Localized: "\uD1A0\uB07C\uB294 \uACE0\uAC1C\uB97C \uAC38\uC6C3\uAC70\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797426
    m_Localized: "...\uC7A0\uAE50. \uADF8\uAC8C \uC0AC\uC2E4\uC774\uB77C\uBA74 \uB108\uB294
      \uC54C\uACE0 \uC788\uC5C8\uB358 \uAC70 \uC544\uB2C8\uC57C?\n\uC6B0\uB9AC\uAC00
      \uC65C \uC774\uB807\uAC8C \uBCC0\uD588\uB294\uC9C0... \uC65C \uBAB8\uC774 \uC88B\uC544\uC84C\uB294\uC9C0...
      \uB108\uB77C\uBA74 \uC54C\uC558\uC744 \uD150\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797427
    m_Localized: "\uB098\uB294 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uBABB\uD588\uB2E4.
      \n(\uBAA8\uB4E0 \uCE90\uB9AD\uD130 \uD638\uAC10\uB3C4 -20)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797428
    m_Localized: "\uC591\uC758 \uCD94\uCE21\uC73C\uB85C \uC778\uD574 \uBAA8\uB450\uB294
      \uC218\uC778\uD654\uAC00 \uCE58\uB8CC\uC81C\uC758 \uBD80\uC791\uC6A9\uC77C
      \uAC00\uB2A5\uC131\uC744 \uAE68\uB2EC\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797429
    m_Localized: "\uD558\uC9C0\uB9CC \uB3D9\uC2DC\uC5D0 \uADF8 \uC0AC\uC2E4\uC744
      \uC54C\uACE0 \uC788\uC5C8\uC744\uC9C0\uB3C4 \uBAA8\uB974\uB294 \uC720\uC77C\uD55C
      \uC0AC\uB78C. \n\uC5F0\uAD6C\uC6D0\uC774\uC5C8\uB358 \uB098\uB97C \uD5A5\uD55C
      \uC758\uC2EC\uB3C4 \uCEE4\uC9C0\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797430
    m_Localized: "\uACB0\uAD6D \uCE58\uB8CC\uC81C\uB97C \uCC3E\uC544\uC57C \uD55C\uB2E4\uB294
      \uAC70\uC796\uC544? \uADF8\uB7F0\uB370 \uC788\uB294 \uAC70\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797431
    m_Localized: "\uCEF4\uD4E8\uD130\uC5D0 \uD45C\uC2DC\uB418\uC5B4 \uC788\uC744\uC9C0\uB3C4
      \uBAB0\uB77C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797432
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84\uAC00 \uC190\uC73C\uB85C \uAC00\uB974\uD0A8
      \uBC29\uD5A5\uC5D0\uB294 \uCEF4\uD4E8\uD130\uAC00 \uC788\uC5C8\uB2E4. \n\uB098\uB294
      \uCC9C\uCC9C\uD788 \uD654\uBA74\uC744 \uD655\uC778\uD588\uB2E4. \uADF8\uB9AC\uACE0...
      \uC22B\uC790\uB97C \uBC1C\uACAC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797433
    m_Localized: "\u3161\u3161\u3161\n\uBC31\uC2E0 \uCF54\uB4DC : VX-01\n\uBCF4\uAD00
      \uC218\uB7C9 : 2\n\uBCF4\uAD00 \uC0C1\uD0DC : \uC815\uC0C1\n\u3161\u3161\u3161"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797434
    m_Localized: "\uCE58\uB8CC\uC81C\uB294 2\uAC1C. \uB204\uAD70\uAC00\uB294 \uC6D0\uB798
      \uBAA8\uC2B5\uC73C\uB85C \uB3CC\uC544\uAC08 \uC218 \uC788\uB2E4. \uD558\uC9C0\uB9CC.
      \uB204\uAD70\uAC00\uB294 \uD3C9\uC0DD \uC774 \uBAA8\uC2B5\uC73C\uB85C \uC0B4\uC544\uAC00\uC57C
      \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797435
    m_Localized: "\uCE58\uB8CC\uC81C\uAC00 2\uAC1C\uBFD0\uC774\uB77C\uB294 \uAC83\uC744
      \uBC1D\uD790\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797436
    m_Localized: "\uCE58\uB8CC\uC81C\uB294\u2026\u2026 \uB450 \uAC1C\uBFD0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797437
    m_Localized: "\uC7A0\uC2DC \uCE68\uBB35\uC774 \uD758\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797438
    m_Localized: "\uB098\uB294 \uC774\uB7F0 \uBAA8\uC2B5\uC73C\uB85C \uC0B4 \uC0DD\uAC01
      \uC5C6\uC5B4. \uC808\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797439
    m_Localized: "\uD654\uB0B4\uC9C0 \uB9C8\uC694\u2026\u2026 \uC790! \uB2E8\uAC78
      \uBA39\uC73C\uBA74 \uAE30\uBD84\uC774 \uB098\uC544\uC9C8\uAC70\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797440
    m_Localized: "\uD1A0\uB07C\uB294 \uC5EC\uC6B0\uC5D0\uAC8C \uC0AC\uD0D5\uC744
      \uAC74\uB0C8\uACE0, \uC5EC\uC6B0\uB294 \uD669\uB2F9\uD55C \uD45C\uC815\uC73C\uB85C
      \uADF8\uB140\uB97C \uBC14\uB77C\uBD24\uB2E4. \n(\uBAA8\uB4E0 \uCE90\uB9AD\uD130
      \uD638\uAC10\uB3C4 +20)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797441
    m_Localized: "\u2026\u2026\uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797442
    m_Localized: "\uBE44\uCF1C."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797443
    m_Localized: "\uADF8\uB140\uAC00 \uB098\uB97C \uBC00\uCCE4\uB2E4. \uC5C4\uCCAD\uB09C
      \uD798\uC774\uC5C8\uB2E4. \uBD84\uBA85 \uBA70\uCE60 \uC804\uAE4C\uC9C0\uB9CC
      \uD574\uB3C4 \uC57D\uD588\uB358 \uBAB8\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797444
    m_Localized: "\uBB50\uC9C0\u2026\u2026? \uB0B4\uAC00 \uC774\uB807\uAC8C \uD798\uC774
      \uC14C\uB098? \uBBF8\uC548."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797445
    m_Localized: "\uC7A0\uAE50. \uC5EC\uAE30 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797446
    m_Localized: "\uD654\uBA74\uC5D0\uB294 \uBD84\uBA85\uD558\uAC8C \uD45C\uC2DC\uB418\uC5B4
      \uC788\uC5C8\uB2E4. '\uBC31\uC2E0 \uBCF4\uAD00 \uC218\uB7C9 : 2'"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797447
    m_Localized: "\u2026\u2026\uC18D\uC778 \uAC70\uAD70\uC694. \uC790\uC2E0\uC774
      \uCE58\uB8CC\uC81C\uB97C \uCC28\uC9C0\uD558\uB824\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797448
    m_Localized: "\uB108. \uCC98\uC74C\uBD80\uD130 \uC790\uAE30\uB9CC \uC0B4 \uC0DD\uAC01\uC774\uC5C8\uC5B4?.\n(\uBAA8\uB4E0
      \uCE90\uB9AD\uD130 \uD638\uAC10\uB3C4 -20)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797449
    m_Localized: "3\uBA85\uC740 \uB3D9\uBB3C\uC758 \uBAA8\uC2B5\uC73C\uB85C \uC0B4\uC544\uC57C\uD55C\uB2E4\uB2C8..
      \uC774\uAC74..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797450
    m_Localized: "\uC591\uC740 \uB9D0\uC744 \uD558\uB358 \uB3C4\uC911\uC5D0 \uC5B4\uB5A4
      \uC0DD\uAC01\uC744 \uD558\uB294 \uB4EF \uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797451
    m_Localized: "\uC88B\uAC8C \uC0DD\uAC01\uD558\uBA74 2\uBA85\uC740 \uB2E4\uC2DC
      \uC778\uAC04\uC774 \uB420\uC218 \uC788\uB2E4\uB294\uAC70\uC796\uC544? \uC11C\uB85C
      \uC2F8\uC6B8\uC218\uBC16\uC5D0 \uC5C6\uC744\uAC83\uAC19\uC740\uB370"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797452
    m_Localized: "\uC7A0\uAE50... \uC77C\uB2E8 \uCE58\uB8CC\uC81C\uB97C \uCC3E\uB294\uAC8C
      \uC911\uC694\uD558\uB2E4\uACE0 \uC0DD\uAC01\uD574\uC694... \uC2E4\uC81C\uB85C
      \uC788\uB294\uC9C0\uB3C4 \uC544\uC9C1 \uBAA8\uB974\uB2C8"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797453
    m_Localized: "\uADF8 \uC21C\uAC04. \uB098\uB294 \uC54C\uC558\uB2E4. \uC774\uACF3\uC5D0\uC11C
      \uAC00\uC7A5 \uC704\uD5D8\uD55C \uAC83\uC740 \uBC14\uC774\uB7EC\uC2A4\uAC00
      \uC544\uB2D0\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797454
    m_Localized: "\uC0AC\uB78C\uC758 \uB9C8\uC74C\uC744 \uAC08\uB77C\uB193\uB294
      \uAC83\uC740. \uC5B8\uC81C\uB098 \uC808\uB9DD\uC774\uC5C8\uB2E4.\n\uADF8\uB9AC\uACE0
      \uC6B0\uB9AC \uC55E\uC5D0\uB294. \uB2E8 \uB450 \uAC1C\uC758 \uCE58\uB8CC\uC81C\uAC00
      \uB193\uC5EC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797455
    m_Localized: "\uD0C8\uCD9C\uD558\uAE30 \uC704\uD574\uC11C\uB294 \uC2DC\uC124
      \uACF3\uACF3\uC5D0 \uC228\uACA8\uC9C4 \uBE44\uC0C1 \uC2DC\uC2A4\uD15C \uD574\uC81C
      \uCF54\uB4DC\uC758 \uB2E8\uC11C\uB97C \uCC3E\uC544\uC57C \uD55C\uB2E4. \n\uD558\uC9C0\uB9CC
      \uBB38\uC81C\uB294 \uADF8\uAC83\uBFD0\uB9CC\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797456
    m_Localized: "\uC6B0\uB9AC \uBAA8\uB450\uC758 \uBAB8\uC740 \uC870\uAE08\uC529
      \uBCC0\uD558\uACE0 \uC788\uC5C8\uB2E4. \uC2DC\uAC04\uC774 \uC9C0\uB0A0\uC218\uB85D
      \uBA85\uD655\uD574\uC84C\uB2E4. \uC774\uAC83\uC740 \uB2E8\uC21C\uD55C \uBCC0\uD654\uAC00
      \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797457
    m_Localized: "\uD558... \uC774\uAC70... \uC810\uC810 \uBAB8\uC774 \uC774\uC0C1\uD574\uC9C0\uACE0
      \uC788\uC5B4. \uACC4\uC18D \uAC00\uB824\uC6CC. \uD138\uC774 \uC790\uB77C\uB294
      \uB290\uB08C\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797458
    m_Localized: "\uC800\uB3C4... \uC2DC\uAC04\uC774 \uC9C0\uB0A0\uC218\uB85D \uC810\uC810
      \uB3D9\uBB3C\uC758 \uBAA8\uC2B5\uC774 \uB418\uC5B4\uAC00\uB294 \uAC83 \uAC19\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797459
    m_Localized: "\uADF8\uB7EC\uBA74... \uC644\uC804\uD788 \uB3D9\uBB3C\uC758 \uBAA8\uC2B5\uC774
      \uB420 \uC218\uB3C4 \uC788\uB2E4\uB294 \uAC70\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797460
    m_Localized: "\uC544\uBB34\uB3C4 \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4.
      \uBAA8\uB450\uC758 \uC2DC\uC120\uC774 \uB098\uC5D0\uAC8C \uD5A5\uD588\uB2E4.
      \uC5F0\uAD6C\uC6D0. \n\uC774 \uC2DC\uC124\uC744 \uC54C\uACE0 \uC788\uC744 \uAC00\uB2A5\uC131\uC774
      \uC788\uB294 \uC720\uC77C\uD55C \uC0AC\uB78C. \uD558\uC9C0\uB9CC \uB098\uB294
      \uACE0\uAC1C\uB97C \uC800\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797461
    m_Localized: "\uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4. \uAE30\uC5B5\uB098\uB294
      \uAC8C \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797462
    m_Localized: "\uB0B4 \uB300\uB2F5\uC5D0 \uC7A0\uC2DC \uC815\uC801\uC774 \uD758\uB800\uB2E4.
      \uBBFF\uC744 \uC218 \uC5C6\uB2E4\uB294 \uD45C\uC815. \n\uBD88\uC548\uD55C \uD45C\uC815.
      \uADF8\uB9AC\uACE0 \uC758\uC2EC. \uD1A0\uB07C\uB294 \uC790\uC2E0\uC758 \uBCC0\uD55C
      \uADC0\uB97C \uB9CC\uC9C0\uBA70 \uC791\uAC8C \uB5A8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797463
    m_Localized: "\uC2DC\uAC04\uC774 \uB9CE\uC9C0 \uC54A\uC558\uB2E4. \uC218\uC778\uD654\uAC00
      \uACC4\uC18D \uC9C4\uD589\uB41C\uB2E4\uBA74 \uC55E\uC73C\uB85C \uC5B4\uB5A4
      \uBCC0\uD654\uAC00 \uC77C\uC5B4\uB0A0\uC9C0 \uC54C \uC218 \uC5C6\uB2E4. \n\uC6B0\uB9AC\uB294
      \uC6B0\uC120 \uD769\uC5B4\uC838 \uC5F0\uAD6C\uC18C 1\uCE35\uC744 \uC870\uC0AC\uD558\uAE30\uB85C
      \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797464
    m_Localized: "\uC5EC\uAE30\uB294 \uB113\uC5B4. \uAC01\uC790 \uC6C0\uC9C1\uC774\uB294
      \uAC8C \uBE60\uB974\uACA0\uC5B4. \uC77C\uB2E8 \uB2E8\uC11C\uB97C \uCC3E\uACE0
      \uC5EC\uAE30\uB85C \uB3CC\uC544\uC624\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797465
    m_Localized: "1\uCE35\uC5D0\uB294 \uC5EC\uB7EC \uC2DC\uC124\uC774 \uC788\uC5C8\uB2E4.
      \uC5F0\uAD6C\uC2E4, \uC2E4\uD5D8\uC2E4, \uD734\uAC8C\uC2E4, \uCC3D\uACE0, \uC790\uB8CC
      \uBCF4\uAD00\uC2E4. \n\uB9AC\uD2B8\uB9AC\uBC84\uB294 \uC2E4\uD5D8\uC2E4\uC744
      \uC870\uC0AC\uD558\uAE30\uB85C \uD588\uB2E4. \uC5EC\uC6B0\uB294 \uD734\uAC8C\uC2E4\uB85C
      \uD5A5\uD588\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797466
    m_Localized: "\uD1A0\uB07C\uB294 \uC544\uC9C1 \uD63C\uC790 \uC6C0\uC9C1\uC774\uAE30
      \uC5B4\uB824\uC6CC \uC591\uACFC \uD568\uAED8 \uC774\uB3D9\uD558\uAE30\uB85C
      \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797467
    m_Localized: "\uD1A0\uB07C\uC57C, \uAC19\uC774 \uAC00\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797468
    m_Localized: "\uB124... \uC5B8\uB2C8\uB791 \uAC19\uC774 \uC788\uC73C\uBA74 \uAD1C\uCC2E\uC744
      \uAC83 \uAC19\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797469
    m_Localized: "\uB098\uB294 \uBA3C\uC800 \uAC00\uAE4C\uC6B4 \uCC3D\uACE0\uB97C
      \uC870\uC0AC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797470
    m_Localized: "\uD2B9\uBCC4\uD55C \uAC83\uC740 \uC5C6\uB124\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797471
    m_Localized: "\uC544\uC9C1 \uBAA8\uB450\uAC00 \uBAA8\uC774\uAE30\uB85C \uD588\uB358
      \uC2DC\uAC04\uAE4C\uC9C0\uB294 \uC5EC\uC720\uAC00 \uC788\uC5C8\uB2E4. \n\uB2E4\uB978
      \uC7A5\uC18C\uB97C \uC870\uC0AC\uD574\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797472
    m_Localized: "\uC5B4\uB514\uB97C \uBC29\uBB38\uD574\uBCFC\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797473
    m_Localized: "\uC2E4\uD5D8\uC2E4 \uBB38\uC744 \uC5F4\uC790, \uB0B4\uBD80\uB294
      \uCC98\uCC38\uD55C \uC0C1\uD0DC\uC600\uB2E4. \uAE68\uC9C4 \uBC30\uC591 \uC6A9\uAE30.
      \uBC14\uB2E5\uC5D0 \uD769\uC5B4\uC9C4 \uC720\uB9AC \uC870\uAC01. \n\uADF8\uB9AC\uACE0
      \uC815\uCCB4\uB97C \uC54C \uC218 \uC5C6\uB294 \uC561\uCCB4\uAC00 \uACF3\uACF3\uC5D0
      \uD758\uB7EC \uC788\uC5C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797474
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84\uB294 \uB098\uB97C \uBC1C\uACAC\uD558\uC790
      \uBAB8\uC744 \uC0B4\uC9DD \uAD73\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797475
    m_Localized: "\uC65C... \uC5EC\uAE30\uB85C \uC628 \uAC70\uC608\uC694?\" \uADF8\uB140\uC758
      \uBAA9\uC18C\uB9AC\uB294 \uC774\uC804\uACFC \uB2EC\uB9AC \uACBD\uACC4\uAC00
      \uC11E\uC5EC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797476
    m_Localized: "\uB2F9\uC5F0\uD55C \uBC18\uC751\uC774\uC5C8\uB2E4. \uC6B0\uB9AC\uB294
      \uC11C\uB85C\uB97C \uBBFF\uC9C0 \uBABB\uD558\uB294 \uC0C1\uD669\uC774\uC5C8\uB2E4.
      \n\uD2B9\uD788 \uB098\uB294 \uC774\uACF3\uC758 \uC5F0\uAD6C\uC6D0\uC774\uC5C8\uACE0,
      \uAE30\uC5B5\uAE4C\uC9C0 \uC783\uC740 \uC0C1\uD0DC\uC600\uB2E4. \uB9AC\uD2B8\uB9AC\uBC84\uB294
      \uCC9C\uCC9C\uD788 \uB0B4 \uC8FC\uBCC0\uC744 \uB9F4\uB3CC\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797477
    m_Localized: "\uC7A0\uAE50... \uBB54\uAC00 \uC774\uC0C1\uD55C \uB0C4\uC0C8\uAC00
      \uB098\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797478
    m_Localized: "\uADF8\uB140\uB294 \uC595\uAC8C \uC228\uC744 \uB4E4\uC774\uC26C\uBA70
      \uD754\uC801\uC744 \uCC3E\uACE0\uC788\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797479
    m_Localized: "\uD558\uC9C0\uB9CC \uC8FC\uBCC0\uC5D0\uB294 \uC57D\uAC04\uC758
      \uBA3C\uC9C0 \uB0C4\uC0C8 \uC678\uC5D0\uB294 \uB098\uC9C0\uC54A\uC558\uB2E4.
      \n\uB3D9\uBB3C\uB85C \uBCC0\uD558\uBA74\uC11C \uADF8\uB140\uB294 \uD6C4\uAC01\uC774
      \uBC1C\uB2EC\uD55C \uAC83\uC77C\uAE4C? "
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797480
    m_Localized: "\uC5EC\uAE30... \uD53C \uB0C4\uC0C8\uAC00 \uB098\uC694. \uADF8\uB9AC\uACE0\u2026
      \uB2F9\uC2E0\uC5D0\uAC8C\uC11C\uB3C4 \uAC19\uC740 \uB0C4\uC0C8\uAC00 \uB098\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797481
    m_Localized: "\uB098\uB294 \uC21C\uAC04 \uB2F9\uD669\uD588\uB2E4. \uB0B4 \uBAB8\uC744
      \uD655\uC778\uD558\uC790 \uC190\uBAA9 \uC544\uB798\uCABD\uC5D0 \uD76C\uBBF8\uD558\uAC8C
      \uC0C1\uCC98\uC640 \uAD73\uC740 \uD608\uD754\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4.
      \n\uC5B8\uC81C \uC0DD\uAE34 \uC0C1\uCC98\uC778\uC9C0 \uAE30\uC5B5\uB098\uC9C0
      \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797482
    m_Localized: "\uAE30\uC5B5\uC774 \uC548 \uB09C\uB2E4\uACE0 \uD588\uC8E0? \uADF8\uB7F0\uB370
      \uC774\uC0C1\uD558\uC9C0 \uC54A\uC544\uC694? \n\uB2F9\uC2E0\uC740 \uC0AC\uACE0\uAC00
      \uB09C \uC7A5\uC18C\uC5D0 \uC788\uC5C8\uACE0... \uC774 \uC5F0\uAD6C\uC2E4\uC5D0\uB294
      \uB2F9\uC2E0\uC758 \uD53C \uB0C4\uC0C8\uAC00 \uB0A8\uC544 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797483
    m_Localized: "\uADF8\uB140\uB294 \uBC14\uB2E5\uC744 \uC0B4\uD3C8\uB2E4. \uADF8\uB9AC\uACE0
      \uAE68\uC9C4 \uC2E4\uD5D8\uB300 \uC606\uC5D0\uC11C \uBB34\uC5B8\uAC00\uB97C
      \uBC1C\uACAC\uD588\uB2E4. \n\uCC22\uC5B4\uC9C4 \uC5F0\uAD6C\uBCF5 \uC870\uAC01.
      \uADF8\uACF3\uC5D0\uB294 \uB0B4 \uC774\uB984\uD45C\uAC00 \uBD99\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797484
    m_Localized: "...\uC774\uAC74 \uB2F9\uC2E0 \uAC70\uB124\uC694. \uC65C \uC5EC\uAE30
      \uCC22\uC5B4\uC9C4 \uCC44\uB85C \uC788\uB294 \uAC70\uC608\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797485
    m_Localized: "\uADF8\uB140\uC758 \uD45C\uC815\uC774 \uD754\uB4E4\uB838\uB2E4.
      \uBD84\uB178\uB77C\uAE30\uBCF4\uB2E4 \uD63C\uB780\uC5D0 \uAC00\uAE4C\uC6E0\uB2E4.
      \uB098\uB97C \uBBFF\uACE0 \uC2F6\uC9C0\uB9CC, \n\uB208\uC55E\uC758 \uC99D\uAC70\uB4E4\uC740
      \uACC4\uC18D \uB098\uB97C \uC758\uC2EC\uD558\uAC8C \uB9CC\uB4E4\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797486
    m_Localized: "\uC194\uC9C1\uD558\uAC8C \uB9D0\uD574\uC8FC\uC138\uC694. \uB2F9\uC2E0\uC774
      \uC774 \uC0AC\uACE0\uB97C \uC77C\uC73C\uD0A8 \uAC74 \uC544\uB2C8\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797487
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84\uC5D0\uAC8C \uC5B4\uB5BB\uAC8C \uBC18\uC751\uD560
      \uAC83\uC778\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797488
    m_Localized: "\uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uAC70\uC9D3\uB9D0\uC744
      \uD558\uACE0 \uC788\uB2E4\uBA74 \uC774\uB807\uAC8C \uB2F9\uC2E0\uB4E4\uC5D0\uAC8C
      \uC124\uBA85\uD558\uB824 \uD558\uC9C0 \uC54A\uC558\uC744 \uAC81\uB2C8\uB2E4.\n
      \uB098\uB3C4 \uC9C0\uAE08 \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB09C \uAC74\uC9C0
      \uC54C\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797489
    m_Localized: "\uAC70\uC9D3\uB9D0\uD558\uB294 \uAC83 \uAC19\uC9C4 \uC54A\uB124\uC694...
      \uD558\uAE34 \uAC70\uC9D3\uB9D0\uC774\uB77C\uACE0 \uD574\uB3C4 \uC54C \uBC29\uBC95\uC774
      \uC5C6\uB124\uC694 \n(\uB9AC\uD2B8\uB9AC\uBC84 \uD638\uAC10\uB3C4 +10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797490
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84\uB294 \uC5EC\uC804\uD788 \uC758\uC2EC\uC758
      \uB208\uCD08\uB9AC\uB97C \uAC70\uB450\uC9C0 \uBABB\uD588\uC9C0\uB9CC, \uB0B4
      \uC9C4\uC2EC\uC744 \uC5B4\uB290 \uC815\uB3C4 \uBC1B\uC544\uB4E4\uC774\uB294
      \uB4EF\uD588\uB2E4. \n\uADF8\uB140\uB294 \uC5F0\uAD6C\uBCF5 \uC870\uAC01\uC744
      \uB4E4\uACE0 \uC7A0\uC2DC \uC0DD\uAC01\uC5D0 \uC7A0\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797491
    m_Localized: "\uB098\uB294 \uBB34\uC758\uC2DD\uC801\uC73C\uB85C \uC5F0\uAD6C\uBCF5
      \uC870\uAC01\uC744 \uB4A4\uB85C \uC228\uACBC\uB2E4. \uADF8 \uC21C\uAC04 \uB9AC\uD2B8\uB9AC\uBC84\uC758
      \uADC0\uAC00 \uCAD1\uAE0B \uC6C0\uC9C1\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797492
    m_Localized: "...\uC65C \uC228\uACBC\uC5B4\uC694? \uBC29\uAE08 \uC804\uAE4C\uC9C0
      \uAE30\uC5B5\uC774 \uC5C6\uB2E4\uACE0 \uD588\uC796\uC544\uC694. \uADF8\uB7F0\uB370
      \uC65C \uC99D\uAC70\uAC00 \uB420 \uB9CC\uD55C \uAC78 \uC228\uAE30\uB294 \uAC70\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797493
    m_Localized: "\uADF8\uB140\uC758 \uB208\uBE5B\uC774 \uBCC0\uD588\uB2E4. \uB0B4
      \uD589\uB3D9\uC774 \uACBD\uACC4\uC2EC\uC744 \uB354\uC6B1 \uD0A4\uC6B0\uACE0
      \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797494
    m_Localized: "\uADF8\uAC70 \uC911\uC694\uD55C \uAC70\uC8E0? \uB0B4\uB194\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797495
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84\uB294 \uBE60\uB974\uAC8C \uB2E4\uAC00\uC640
      \uB0B4 \uC190\uC5D0\uC11C \uC5F0\uAD6C\uBCF5 \uC870\uAC01\uC744 \uAC00\uC838\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797496
    m_Localized: "...\uADF8\uB0E5 \uC870\uAC01\uC774\uB124. \uC8C4\uC1A1\uD574\uC694.
      \uC81C\uAC00 \uB108\uBB34 \uC608\uBBFC\uD574\uC84C\uB098 \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797497
    m_Localized: "\uADF8\uB140\uB294 \uB0C4\uC0C8\uB97C \uB9E1\uACE0 \uC790\uC138\uD788
      \uC0B4\uD3C8\uC9C0\uB9CC \uD2B9\uBCC4\uD55C \uAC83\uC740 \uCC3E\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797498
    m_Localized: "\uD558\uC9C0\uB9CC \uADF8\uB140\uC758 \uB208\uBE5B\uC5D0\uB294
      \uC774\uC804\uBCF4\uB2E4 \uAE4A\uC740 \uBD88\uC2E0\uC774 \uB0A8\uC544\uC788\uC5C8\uB2E4.
      \n(\uB9AC\uD2B8\uB9AC\uBC84 \uD638\uAC10\uB3C4 -10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797499
    m_Localized: "\uADF8\uB140\uAC00 \uB4E4\uACE0\uC788\uB294 \uC5F0\uAD6C\uBCF5
      \uC548\uCABD. \uD76C\uBBF8\uD558\uAC8C \uC801\uD78C \uC77C\uB828\uBC88\uD638\uAC00
      \uB208\uC5D0 \uB4E4\uC5B4\uC654\uB2E4. \n\uADF8\uB9AC\uACE0 \uC774\uC0C1\uD558\uAC8C\uB3C4...
      \uADF8 \uC22B\uC790\uB97C \uBCF4\uB294 \uC21C\uAC04. \uBA38\uB9BF\uC18D\uC5D0\uC11C
      \uBB34\uC5B8\uAC00 \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797500
    m_Localized: "\uD0C8\uCD9C\uAD6C\uC758...\uBE44\uBC00\uBC88\uD638?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797501
    m_Localized: "\uD734\uAC8C\uC2E4 \uBB38\uC744 \uC5F4\uC790 \uC548\uCABD\uC5D0\uC11C
      \uBB3C\uAC74\uC744 \uB4A4\uC9C0\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4.
      \n\uB204\uAD70\uAC00 \uC11C\uB78D\uC744 \uC5F4\uACE0, \uBCBD\uBA74\uC744 \uD655\uC778\uD558\uBA70
      \uBB34\uC5B8\uAC00\uB97C \uCC3E\uACE0 \uC788\uC5C8\uB2E4. \uC5EC\uC6B0\uC600\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797502
    m_Localized: "\uADF8\uB140\uB294 \uB0B4\uAC00 \uB4E4\uC5B4\uC628 \uAC83\uC744
      \uC54C\uC544\uCC28\uB9AC\uC790 \uCC9C\uCC9C\uD788 \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4.
      \uADC0\uAC00 \uBA3C\uC800 \uC6C0\uC9C1\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797503
    m_Localized: "...\uB2F9\uC2E0\uC774\uB124\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797504
    m_Localized: "\uC65C \uC5EC\uAE30 \uC654\uC5B4\uC694? \uC6B0\uC5F0\uD788 \uAE38\uC744
      \uC783\uC5C8\uB2E4\uACE0 \uD558\uAE30\uC5D4... \uB2F9\uC2E0\uC740 \uC5F0\uAD6C\uC6D0\uC774\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797505
    m_Localized: "\uBB54\uAC00 \uCC3E\uACE0 \uC788\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797506
    m_Localized: "\uD0C8\uCD9C \uBC29\uBC95. \uADF8\uB9AC\uACE0 \uCE58\uB8CC\uC81C."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797507
    m_Localized: "\uADF8\uB140\uB294 \uC790\uC2E0\uC758 \uD314\uC744 \uBC14\uB77C\uBCF4\uC558\uB2E4.
      \uD76C\uBBF8\uD558\uAC8C \uC62C\uB77C\uC628 \uD138. \uBCC0\uD574\uAC00\uB294
      \uC2E0\uCCB4. \uCC98\uC74C\uBCF4\uB2E4 \uD655\uC2E4\uD558\uAC8C \uC9C4\uD589\uB41C
      \uC218\uC778\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797508
    m_Localized: "\uC2DC\uAC04\uC774 \uBCC4\uB85C \uC5C6\uB294 \uAC83 \uAC19\uAC70\uB4E0\uC694.
      \uC194\uC9C1\uD788 \uB9D0\uD574\uC11C... \uB098\uB294 \uC774 \uBAA8\uC2B5\uC73C\uB85C
      \uD3C9\uC0DD \uC0B4\uC544\uAC08 \uC0DD\uAC01 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797509
    m_Localized: "\uADF8\uB140\uB294 \uB098\uB97C \uB611\uBC14\uB85C \uBC14\uB77C\uBD24\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797510
    m_Localized: "\uADF8\uB7F0\uB370 \uC774\uC0C1\uD558\uB124. \uB2F9\uC2E0\uB3C4
      \uAE30\uC5B5\uC774 \uC5C6\uB2E4\uBA74\uC11C... \uC65C \uC774\uB807\uAC8C \uD0DC\uC5F0\uD574\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797511
    m_Localized: "\uB098\uB294 \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4. \uC5EC\uC6B0\uB294
      \uC7A0\uC2DC \uB098\uB97C \uBC14\uB77C\uBCF4\uB2E4\uAC00 \uD55C\uC228\uC744
      \uB0B4\uC26C\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797512
    m_Localized: "\uB410\uC5B4\uC694. \uC9C0\uAE08 \uC2F8\uC6CC\uBD24\uC790 \uC758\uBBF8
      \uC5C6\uC73C\uB2C8\uAE4C. \uB300\uC2E0, \uC9C0\uCF1C\uBCFC\uAC70\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797513
    m_Localized: "\uADF8 \uC21C\uAC04. \uC5EC\uC6B0\uC758 \uADC0\uAC00 \uAC11\uC790\uAE30
      \uC6C0\uC9C1\uC600\uB2E4. \uADF8\uB140\uB294 \uB9D0\uC744 \uBA48\uCD94\uACE0
      \uD734\uAC8C\uC2E4 \uAD6C\uC11D\uC744 \uBC14\uB77C\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797514
    m_Localized: "...\uC774\uC0C1\uD558\uB124. \uBD84\uBA85 \uBB54\uAC00 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797515
    m_Localized: "\uBB58 \uB290\uB080 \uAC81\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797516
    m_Localized: "\uC18C\uB9AC. \uC544\uC8FC \uC791\uC9C0\uB9CC \uACC4\uC18D \uB4E4\uB9AC\uACE0
      \uC788\uC5B4.\uC800\uCABD. \uC800 \uAC00\uBC29\uC5D0\uC11C \uB098\uB294 \uC18C\uB9AC\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797517
    m_Localized: "\uD734\uAC8C\uC2E4 \uAD6C\uC11D. \uBA3C\uC9C0\uAC00 \uC313\uC778
      \uC624\uB798\uB41C \uC5F0\uAD6C\uC6A9 \uAC00\uBC29 \uD558\uB098\uAC00 \uB193\uC5EC
      \uC788\uC5C8\uB2E4. \n\uAC89\uBCF4\uAE30\uC5D0\uB294 \uBC84\uB824\uC9C4 \uBB3C\uAC74\uCC98\uB7FC
      \uBCF4\uC600\uC9C0\uB9CC, \uAC00\uAE4C\uC774 \uB2E4\uAC00\uAC00\uC790 \uB0B4\uBD80\uC5D0\uC11C
      \uD76C\uBBF8\uD55C \uC54C\uB9BC\uC774 \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797518
    m_Localized: "\uC774\uAC74 \uC77C\uBD80\uB7EC \uC228\uAE34 \uAC83 \uAC19\uC740\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797519
    m_Localized: "\uAC00\uBC29\uC744 \uC5F4\uC790 \uB0B4\uBD80\uC5D0\uB294 \uC624\uB798\uB41C
      \uD0DC\uBE14\uB9BF\uACFC \uBA87 \uAC00\uC9C0 \uC5F0\uAD6C \uC790\uB8CC\uAC00
      \uB4E4\uC5B4 \uC788\uC5C8\uB2E4. \n\uD0DC\uBE14\uB9BF \uD654\uBA74\uC5D0\uB294
      \uC554\uD638\uD654\uB41C \uD30C\uC77C \uD558\uB098\uAC00 \uD45C\uC2DC\uB418\uC5B4
      \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797520
    m_Localized: "```\n    Emergency Shutdown Code\n    \uBE44\uC0C1 \uC2DC\uC2A4\uD15C
      \uD574\uC81C \uCF54\uB4DC\n    \uAD00\uB9AC \uCC45\uC784\uC790 : [OOO]\n   
      ```"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797521
    m_Localized: "\uADF8\uB9AC\uACE0 \uADF8 \uC544\uB798. \uB0B4 \uC774\uB984\uC774
      \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797522
    m_Localized: "...\uC7AC\uBBF8\uC788\uB294 \uC774\uB984\uC774 \uC788\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797523
    m_Localized: "\uB0B4 \uC774\uB984?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797524
    m_Localized: "\uADF8\uB798. \uB2F9\uC2E0 \uC774\uB984. \uADF8\uB9AC\uACE0 \uC774
      \uC2DC\uC124 \uCC45\uC784\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797525
    m_Localized: "\uADF8\uB140\uB294 \uD0DC\uBE14\uB9BF\uACFC \uB098\uB97C \uBC88\uAC08\uC544
      \uBC14\uB77C\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797526
    m_Localized: "\uAE30\uC5B5\uC744 \uC783\uC5C8\uB2E4\uB294 \uB9D0. \uBBFF\uC5B4\uC57C
      \uD560\uAE4C? \uC544\uB2C8\uBA74... \uC54C\uBA74\uC11C \uBAA8\uB974\uB294 \uCC99\uD558\uB294
      \uAC78\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797527
    m_Localized: "\uC5EC\uC6B0\uC5D0\uAC8C \uC5B4\uB5BB\uAC8C \uBC18\uC751\uD560
      \uAC83\uC778\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797528
    m_Localized: "\uC800\uB3C4... \uC774\uAC8C \uC5B4\uB5BB\uAC8C \uB41C\uC77C\uC778\uC9C0
      \uC54C\uACE0\uC2F6\uC2B5\uB2C8\uB2E4. \n\uD558\uC9C0\uB9CC \uC81C\uAC00 \uAE30\uC5B5\uC774
      \uC874\uC7AC\uD55C\uB2E4\uBA74 \uB3D9\uBB3C\uB85C \uBCC0\uD558\uACE0 \uC788\uB294
      \uC774 \uD604\uC0C1\uBD80\uD130 \uAE09\uD558\uAC8C \uD574\uACB0\uD560\uAC81\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797529
    m_Localized: "\uC81C \uAC74\uAC15\uC5D0 \uC5B4\uB5A4 \uBB38\uC81C\uAC00 \uC0DD\uAE38\uC9C0
      \uBAA8\uB974\uB2C8"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797530
    m_Localized: "\uD558\uAE34... \uC54C\uACE0 \uC788\uC5C8\uB2E4\uBA74 \uD63C\uC790
      \uBAB0\uB798 \uBE60\uC838\uB098\uAC14\uACA0\uC9C0... \uC88B\uC544. \uC77C\uB2E8\uC740
      \uBBFF\uC5B4\uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797531
    m_Localized: "\uD558\uC9C0\uB9CC \uACC4\uC18D \uC228\uAE30\uB294 \uAC8C \uC788\uB2E4\uBA74...
      \uADF8\uB54C\uB294 \uB098\uB3C4 \uAC00\uB9CC\uD788 \uC788\uC9C0 \uC54A\uC744
      \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797532
    m_Localized: "\uC5EC\uC6B0\uB294 \uD0DC\uBE14\uB9BF\uC744 \uB4E4\uACE0 \uB098\uB97C
      \uACBD\uACC4\uD558\uBA70 \uD734\uAC8C\uC2E4\uC744 \uB098\uC130\uB2E4. \n(\uC5EC\uC6B0
      \uD638\uAC10\uB3C4 +10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797533
    m_Localized: "\uB098\uB294 \uC21C\uAC04\uC801\uC73C\uB85C \uADF8\uB140\uC758
      \uC6C0\uC9C1\uC784\uC744 \uC77D\uACE0 \uD0DC\uBE14\uB9BF\uC744 \uBE7C\uC557\uC73C\uB824
      \uB2EC\uB824\uB4E4\uC5C8\uB2E4. \n\uC218\uC778\uD654\uB85C \uD798\uACFC \uBC18\uC751\uC18D\uB3C4\uAC00
      \uC62C\uB77C\uAC14\uC9C0\uB9CC, \uC544\uC9C1 \uC644\uBCBD\uD558\uC9C0 \uC54A\uC740
      \uADF8\uB140\uB294 \uB300\uC751\uD558\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797534
    m_Localized: "\uD0DC\uBE14\uB9BF\uC740 \uBC14\uB2E5\uC5D0 \uB5A8\uC5B4\uC838
      \uC561\uC815\uC774 \uAE68\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797535
    m_Localized: "\uC7A0\uAE50... \uBB50 \uD558\uB294..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797536
    m_Localized: "\uADF8\uB140\uB294 \uBC14\uB2E5\uC5D0 \uC4F0\uB7EC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797537
    m_Localized: "...\uD558... \uC774\uC81C \uD655\uC2E4\uD788 \uC54C\uACA0\uB124.
      \uB2F9\uC2E0\uC740 \uC228\uAE30\uB294 \uAC8C \uC788\uB2E4\uB294 \uAC78."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797538
    m_Localized: "\uADF8\uB140\uB294 \uC77C\uC5B4\uB098\uC11C, \uACE7\uBC14\uB85C
      \uAE68\uC9C4 \uD0DC\uBE14\uB9BF\uC758 \uC0C1\uD0DC\uB97C \uD655\uC778\uD588\uB2E4.
      \uC544\uC27D\uAC8C\uB3C4 \uD0DC\uBE14\uB9BF\uC740 \uACE0\uC7A5\uB098\uC9C0
      \uC54A\uC558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797539
    m_Localized: "\uC5EC\uC6B0\uB294 \uAE68\uC9C4 \uD0DC\uBE14\uB9BF\uC744 \uB4E4\uACE0
      \uB098\uB97C \uB178\uB824\uBCF4\uBA70 \uD734\uAC8C\uC2E4\uC744 \uBE60\uC838\uB098\uAC14\uB2E4.
      \n\uADF8\uB140\uC758 \uB208\uBE5B\uC5D0\uB294 \uAE4A\uC740 \uBD88\uC2E0\uC774
      \uAC00\uB4DD\uD588\uB2E4. \n(\uC5EC\uC6B0 \uD638\uAC10\uB3C4 -10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797540
    m_Localized: "\uAC01\uC790\uC758 \uD0D0\uC0C9\uC744 \uB9C8\uCE5C \uC6B0\uB9AC\uB294
      \uB2E4\uC2DC \uC911\uC559 \uC5F0\uAD6C\uC2E4\uB85C \uBAA8\uC600\uB2E4. \n\uD558\uC9C0\uB9CC
      \uCC98\uC74C \uBAA8\uC600\uC744 \uB54C\uC640 \uBD84\uC704\uAE30\uB294 \uB2EC\uB77C\uC838
      \uC788\uC5C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797541
    m_Localized: "\uCC98\uC74C\uC5D0\uB294 \uB2E8\uC21C\uD788 \uC0B4\uC544\uB0A8\uAE30
      \uC704\uD574 \uBAA8\uC778 \uC0AC\uB78C\uB4E4\uC774\uC5C8\uC9C0\uB9CC, \uC810\uC810
      \uC11C\uB85C\uC758 \uD589\uB3D9\uC744 \uC758\uC2EC\uD558\uACE0 \uC788\uC5C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797542
    m_Localized: "\uC800\uB294 \uC2E4\uD5D8\uC2E4\uC5D0\uC11C \uC774\uAC78 \uCC3E\uC558\uC5B4\uC694.
      \uCC22\uC5B4\uC9C4 \uC5F0\uAD6C\uBCF5 \uC870\uAC01\uC778\uB370... \uC548\uCABD\uC5D0
      \uD39C\uC73C\uB85C \uBB54\uAC00 \uD45C\uC2DC\uAC00 \uB418\uC5B4 \uC788\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797543
    m_Localized: "\uB098\uB294 \uC774\uAC78 \uBC1C\uACAC\uD588\uC5B4. \uC228\uACA8\uC9C4
      \uD0DC\uBE14\uB9BF\uC778\uB370, \uC548\uC5D0 \uBE44\uC0C1 \uC2DC\uC2A4\uD15C
      \uD574\uC81C \uCF54\uB4DC \uAD00\uB828 \uD30C\uC77C\uC774 \uC788\uC5C8\uC5B4.
      \uBB38\uC81C\uB294 \uC554\uD638\uD654\uB418\uC5B4 \uC788\uB2E4\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797544
    m_Localized: "\uC800\uB294 \uD1A0\uB07C\uC640 \uD568\uAED8 \uCC3E\uC544\uBD24\uC9C0\uB9CC...
      \uD2B9\uBCC4\uD55C \uAC74 \uBC1C\uACAC\uD558\uC9C0 \uBABB\uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797545
    m_Localized: "...\uC5B8\uB2C8\uB4E4... \uC6B0\uB9AC \uC815\uB9D0 \uB2E4\uC2DC
      \uC778\uAC04\uC73C\uB85C \uB3CC\uC544\uAC08 \uC218 \uC788\uC744\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797546
    m_Localized: "\uD1A0\uB07C\uC758 \uC791\uC740 \uBAA9\uC18C\uB9AC\uC5D0 \uBAA8\uB450
      \uC7A0\uC2DC \uCE68\uBB35\uD588\uB2E4. \uC544\uBB34\uB3C4 \uD655\uC2E0\uD560
      \uC218 \uC5C6\uC5C8\uB2E4. \uCE58\uB8CC\uC81C\uAC00 \uD655\uC2E4\uD788 2\uAC1C
      \uC874\uC7AC\uD558\uB294\uC9C0\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797547
    m_Localized: "\uC874\uC7AC\uD55C\uB2E4\uBA74 \uB204\uAC00 \uC0AC\uC6A9\uD560
      \uC218 \uC788\uB294\uC9C0. \uADF8\uB9AC\uACE0... \uCE58\uB8CC\uC81C\uB97C \uC0AC\uC6A9\uD558\uC9C0
      \uBABB\uD558\uBA74 \uC5B4\uB5BB\uAC8C \uB418\uB294\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797548
    m_Localized: "\uBAA8\uB450\uC758 \uC2DC\uC120\uC774 \uB098\uC5D0\uAC8C \uD5A5\uD588\uB2E4.
      \uC5F0\uAD6C\uBCF5 \uC870\uAC01. \uC554\uD638\uD654\uB41C \uD0DC\uBE14\uB9BF
      \uD30C\uC77C. \uB450 \uAC1C\uC758 \uB2E8\uC11C\uB294 \uBD84\uBA85 \uC5F0\uACB0\uB418\uC5B4
      \uC788\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797549
    m_Localized: "\uD558\uC9C0\uB9CC \uB3D9\uC2DC\uC5D0, \uC774 \uB2E8\uC11C\uB4E4\uC740
      \uB0B4\uAC00 \uC774 \uC0AC\uAC74\uACFC \uAD00\uB828\uB418\uC5B4 \uC788\uB2E4\uB294
      \uC0AC\uC2E4\uB3C4 \uC99D\uBA85\uD558\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797550
    m_Localized: "\uB2E8\uC11C\uC5D0 \uB300\uD574 \uC544\uB294 \uAC83\uC744 \uB9D0\uD560\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797551
    m_Localized: "\uB098\uB294 \uC5F0\uAD6C\uBCF5 \uC870\uAC01\uC5D0 \uC801\uD78C
      \uD45C\uC2DC\uC640 \uD0DC\uBE14\uB9BF \uD30C\uC77C\uC758 \uAD6C\uC870\uB97C
      \uD655\uC778\uD588\uB2E4. \n\uADF8\uB9AC\uACE0 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uB294
      \uBD80\uBD84\uAE4C\uC9C0 \uC5B5\uC9C0\uB85C \uB5A0\uC62C\uB9AC\uBA70 \uC124\uBA85\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797552
    m_Localized: "\uC774 \uC22B\uC790\uB294... \uB0B4 \uC0DD\uC77C\uACFC \uAC19\uB124,
      \uADF8\uB9AC\uACE0 \uC774\uAC74... \uBB54\uAC00 \uC774\uB2C8\uC15C\uC778\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797553
    m_Localized: "\uC5F0\uAD6C\uBCF5 \uC870\uAC01\uC758 \uC554\uD638\uC758 \uC870\uD569\uC744
      \uB5A0\uC62C\uB9AC\uBA70 \uC5EC\uB7EC \uC77C\uB828\uBC88\uD638\uB97C \uC785\uB825\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797554
    m_Localized: "\uC54C\uACE0\uC788\uB294 \uC815\uBCF4\uB97C \uC870\uD569\uD558\uC5EC
      \uD0DC\uBE14\uB9BF\uC758 \uC554\uD638\uB97C \uD480 \uC218 \uC788\uC5C8\uB2E4\n(\uBAA8\uB4E0
      \uCE90\uB9AD\uD130 \uD638\uAC10\uB3C4 +20)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797555
    m_Localized: "\uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4. \uB098\uB3C4 \uC9C0\uAE08
      \uD63C\uB780\uC2A4\uB7EC\uC6B8 \uBFD0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797556
    m_Localized: "\uC774\uAC8C \uB9D0\uC774 \uB3FC? \uD0DC\uBE14\uB9BF \uD30C\uC77C
      \uC548\uC5D0 \uB2F9\uC2E0 \uC774\uB984\uC774 \uC788\uB294\uB370?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797557
    m_Localized: "\uD639\uC2DC... \uC54C\uACE0 \uC788\uB294\uB370 \uC228\uAE30\uACE0
      \uC788\uB294 \uAC74 \uC544\uB2D0\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797558
    m_Localized: "\uBBF8\uC548\uD558\uC9C0\uB9CC... \uC9C0\uAE08 \uC0C1\uD669\uC5D0\uC11C\uB294
      \uB2F9\uC2E0 \uD63C\uC790 \uC6C0\uC9C1\uC774\uAC8C \uB458 \uC218 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797559
    m_Localized: "\uC774\uB807\uAC8C \uACC4\uC18D \uBCC0\uD558\uBA74... \uB09C \uD3C9\uC0DD
      \uC774\uB7F0 \uBAA8\uC2B5\uC73C\uB85C \uC0B4\uC544\uC57C \uD558\uB294 \uAC78\uAE4C?
      \n(\uBAA8\uB4E0 \uCE90\uB9AD\uD130 \uD638\uAC10\uB3C4 -20)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797560
    m_Localized: "\uACC4\uC18D\uB418\uB294 \uCD94\uAD81\uC5D0 \uACB0\uAD6D \uB098\uB294
      \uB354 \uC774\uC0C1 \uC228\uAE38 \uC218 \uC5C6\uC5C8\uB2E4. \n\uAE30\uC5B5\uB098\uC9C0
      \uC54A\uB294 \uBD80\uBD84\uC744 \uC81C\uC678\uD558\uACE0, \uB0B4\uAC00 \uC54C\uACE0
      \uC788\uB294 \uC815\uBCF4\uB97C \uBAA8\uB450 \uC124\uBA85\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797561
    m_Localized: "\uD0DC\uBE14\uB9BF\uC758 \uC554\uD638\uAC00 \uD480\uB838\uB2E4.
      \uD654\uBA74\uC5D0\uB294 \uB2E4\uC74C\uACFC \uAC19\uC740 \uBB38\uAD6C\uAC00
      \uB098\uD0C0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797562
    m_Localized: "\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161\n\uBE44\uC0C1
      \uC2DC\uC2A4\uD15C \uD574\uC81C \uD544\uC694 \uC870\uAC74:\n- \uC5F0\uAD6C
      \uCC45\uC784\uC790 \uC778\uC99D\n- \uCD5C\uC885 \uBCF4\uC548 \uD0A4 \uD655\uC778\n\uC2DC\uC2A4\uD15C
      \uD574\uC81C\uB97C \uC704\uD574\uC11C \uBC29\uBB38\uD558\uC2ED\uC2DC\uC624:\n-
      2\uCE35 \uC5F0\uAD6C \uAE30\uB85D \uBCF4\uAD00\uC2E4\n\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797563
    m_Localized: "\uC88B\uC544\uC694... \uC774\uC81C \uB9C8\uC9C0\uB9C9 \uB2E8\uC11C\uB9CC
      \uCC3E\uC73C\uBA74 \uB418\uB294 \uAC70\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797564
    m_Localized: "\uC6B0\uB9AC\uB294 1\uCE35\uC5D0\uC11C \uC5BB\uC744 \uC218 \uC788\uB294
      \uC815\uBCF4\uB97C \uBAA8\uB450 \uBAA8\uC558\uB2E4. \n\uD558\uC9C0\uB9CC \uD0C8\uCD9C\uAD6C\uB294
      \uC5EC\uC804\uD788 \uAD73\uAC8C \uB2EB\uD600 \uC788\uC5C8\uB2E4. \uADF8\uB9AC\uACE0
      \uCE58\uB8CC\uC81C\uB294 \uB2E8 \uB450 \uAC1C. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797565
    m_Localized: "\uB204\uAD70\uAC00\uB294 \uC778\uAC04\uC73C\uB85C \uB3CC\uC544\uAC08
      \uC218 \uC5C6\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797566
    m_Localized: "\uC6B0\uB9AC\uB294 \uCC9C\uCC9C\uD788 2\uCE35\uC73C\uB85C \uD5A5\uD558\uB294
      \uACC4\uB2E8\uC744 \uC62C\uB77C\uAC14\uB2E4. \uBD89\uC740 \uBE44\uC0C1\uB4F1\uC740
      \uC5EC\uC804\uD788 \uAE5C\uBE61\uC774\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797567
    m_Localized: "\uADF8\uB9AC\uACE0 \uC544\uBB34\uB3C4 \uB208\uCE58\uCC44\uC9C0
      \uBABB\uD588\uB2E4. \uB0B4 \uC190\uB05D\uC758 \uBCC0\uD654\uAC00... \uB2E4\uB978
      \uB204\uAD6C\uBCF4\uB2E4 \uBE60\uB974\uAC8C \uC9C4\uD589\uB418\uACE0 \uC788\uB2E4\uB294
      \uAC83\uC744."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797568
    m_Localized: "2\uCE35\uC5D0 \uC62C\uB77C\uC624\uC790 \uBAA8\uB450\uC758 \uBC1C\uAC78\uC74C\uC774
      \uB208\uC5D0 \uB744\uAC8C \uB290\uB824\uC84C\uB2E4. \n\uC228\uC744 \uC274 \uB54C\uB9C8\uB2E4
      \uAC00\uC2B4\uC774 \uB2F5\uB2F5\uD588\uACE0, \uBAB8\uC18D \uC5B4\uB518\uAC00\uC5D0\uC11C
      \uB0AF\uC120 \uBCF8\uB2A5\uC774 \uAFC8\uD2C0\uAC70\uB838\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797569
    m_Localized: "...\uC7A0\uAE50. \uB2E4\uB4E4... \uAD1C\uCC2E\uC544? \uBAB8\uC774
      \uC870\uAE08 \uC6C0\uC9C1\uC774\uAE30 \uD798\uB4E4\uC5B4\uC84C\uB294\uB370"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797570
    m_Localized: "...\uC800\uB3C4 \uADF8\uB798\uC694. \uC190\uB05D\uC5D0 \uD798\uC774
      \uC548 \uB4E4\uC5B4\uAC00\uB124\uC694. \uC774\uAC83\uB3C4 \uBD80\uC791\uC6A9\uC778
      \uAC78\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797571
    m_Localized: "...\uBC30\uACE0\uD30C... \uC870\uAE08\uB9CC... \uC26C\uBA74 \uC548
      \uB420\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797572
    m_Localized: "...2\uCE35\uC5D0 \uBCD1\uC2E4\uC774 \uC788\uC5B4\uC694. \uC7A0\uAE50
      \uC26C\uACE0 \uAC00\uB294 \uAC8C \uC88B\uACA0\uC5B4\uC694. \uC774\uB300\uB85C\uB294
      \uB2E4\uB4E4 \uBC84\uD2F0\uAE30 \uD798\uB4E4\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797573
    m_Localized: "...\uC88B\uC544\uC694. \uC2DD\uB7C9\uBD80\uD130 \uCC59\uAE34 \uB4A4
      \uC7A0\uC2DC \uC27D\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797574
    m_Localized: "\uC6B0\uB9AC\uB294 \uC2DD\uB2F9\uC5D0\uC11C \uB0A8\uC544 \uC788\uB294
      \uD1B5\uC870\uB9BC\uACFC \uBB3C\uC744 \uCC59\uAE34 \uB4A4, \uAC01\uC790\uC758
      \uBCD1\uC2E4\uB85C \uD5A5\uD588\uB2E4. \n\uC7A0\uAE50\uC758 \uD734\uC2DD\uC744
      \uD558\uAE30\uB85C \uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797575
    m_Localized: "\uD558\uC9C0\uB9CC \uB204\uAD6C\uB3C4 \uD3B8\uD788 \uC274 \uC218\uB294
      \uC5C6\uC744 \uAC83\uC774\uB2E4. \uBA38\uB9BF\uC18D\uC774 \uBCF5\uC7A1\uD588\uB2E4.
      \n\uB204\uAD70\uAC00\uC640 \uB300\uD654\uB77C\uB3C4 \uB098\uB204\uACE0\uC2F6\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797576
    m_Localized: "\uB204\uAD6C\uC640 \uB300\uD654\uB97C \uB098\uB204\uC5B4\uBCFC\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797577
    m_Localized: "\uBB38\uC740 \uC0B4\uC9DD \uC5F4\uB824 \uC788\uC5C8\uB2E4. \uC548\uC740
      \uC758\uC678\uB85C \uAE54\uB054\uD588\uB2E4. \n\uCE68\uB300 \uC606 \uCC45\uC0C1
      \uC704\uC5D0\uB294 \uC624\uB798\uB41C \uAC00\uC871\uC0AC\uC9C4 \uD558\uB098\uAC00
      \uB193\uC5EC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797578
    m_Localized: "\uC0AC\uC9C4\uC744 \uB4A4\uC9D1\uC790 \uC791\uC740 \uAE00\uC528\uAC00
      \uC801\uD600 \uC788\uC5C8\uB2E4. '\uC2DC\uD55C\uBD80 6\uAC1C\uC6D4'. \uADF8
      \uC21C\uAC04. \uBB38\uC774 \uC5F4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797579
    m_Localized: "...\uBB50 \uD558\uC2DC\uB294 \uAC70\uC608\uC694? ...\uADF8\uAC70.
      \uAC74\uB4DC\uB9AC\uC9C0 \uB9D0\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797580
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84\uB294 \uB0B4 \uC190\uC758 \uC0AC\uC9C4\uC744
      \uAC00\uC838\uAC14\uACE0, \uB208\uB3D9\uC790\uAC00 \uD754\uB4E4\uB9AC\uACE0
      \uACBD\uACC4\uD558\uACE0\uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797581
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84\uC5D0\uAC8C \uC5B4\uB5BB\uAC8C \uBC18\uC751\uD560
      \uAC83\uC778\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797582
    m_Localized: "...\uBBF8\uC548\uD569\uB2C8\uB2E4. ...\uC18C\uC911\uD55C \uBB3C\uAC74\uC774\uC5C8\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797583
    m_Localized: "...\uC8C4\uC1A1\uD574\uC694. ...\uC694\uC998\uC740 \uAC10\uC815\uC744
      \uCC38\uAE30\uAC00 \uD798\uB4E4\uC5B4\uC694. \n...\uC774 \uC0AC\uC9C4\uC740
      \uBD80\uBAA8\uB2D8\uC774\uC5D0\uC694. ...\uB450 \uBD84 \uBAA8\uB450 \uC800\uC640
      \uAC19\uC740 \uBCD1\uC73C\uB85C... \uB3CC\uC544\uAC00\uC168\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797584
    m_Localized: "...\uADF8\uB798\uC11C... ...\uB9C8\uC9C0\uB9C9 \uD76C\uB9DD\uC774\uB77C\uACE0
      \uC0DD\uAC01\uD558\uACE0 \uC774 \uC2DC\uC124\uC5D0 \uC654\uC5B4\uC694. \n...\uC0B4\uC544\uB0A8\uAE34
      \uD588\uC9C0\uB9CC. ...\uC774\uB7F0 \uBAA8\uC2B5\uC774 \uB420 \uC904\uC740
      \uBAB0\uB790\uB124\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797585
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84\uB294 \uB208\uBB3C\uC744 \uB2E6\uACE0,
      \uC228\uC744 \uD06C\uAC8C \uB4E4\uC774\uC26C\uB354\uB2C8 \uB2E4\uC2DC \uC6C3\uB294
      \uD45C\uC815\uC744 \uC9C0\uC5C8\uB2E4 "
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797586
    m_Localized: "...\uADF8\uB798\uB3C4. \uC0B4\uC544\uC788\uB294 \uAC8C \uC911\uC694\uD558\uC9C0
      \uC54A\uC744\uAE4C\uC694? \uD76C\uB9DD\uC774 \uC788\uB2E4\uB294\uAC74 \uC88B\uC740\uAC70\uB2C8\uAE4C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797587
    m_Localized: "\uD558\uB8E8\uD558\uB8E8 \uC808\uB9DD\uD558\uB294 \uAC83 \uBCF4\uB2E4\uB294...
      \uD558\uB8E8\uB97C \uC990\uAC81\uACE0 \uD589\uBCF5\uD558\uAC8C \uC0B4\uAC70\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797588
    m_Localized: "\uC990\uAC81\uAC8C \uC0B4\uC544\uAC00\uAE30\uC5D0\uB3C4 \uC2DC\uAC04\uC774
      \uBD80\uC871\uD558\uB2C8\uAE4C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797589
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84\uB294 \uC560\uC368 \uBBF8\uC18C\uB97C
      \uC9C0\uC5C8\uC9C0\uB9CC, \uADF8\uB140\uC758 \uB208\uC5D0\uB294 \uC2AC\uD514\uC774
      \uAC00\uB4DD\uD588\uB2E4. \n\uB098\uB294 \uADF8\uB140\uC758 \uC5B4\uAE68\uB97C
      \uC870\uC6A9\uD788 \uB450\uB4DC\uB838\uB2E4.\n(\uB9AC\uD2B8\uB9AC\uBC84 \uD638\uAC10\uB3C4
      +10) "
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797590
    m_Localized: "...\uB194. ...\uB194!"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797591
    m_Localized: "\uC0AC\uC9C4\uC744 \uBE7C\uC557\uC73C\uB824 \uD558\uC790 \uB9AC\uD2B8\uB9AC\uBC84\uAC00
      \uACA9\uB82C\uD558\uAC8C \uC800\uD56D\uD588\uACE0. \n\uB098\uB294 \uACB0\uAD6D
      \uC0AC\uC9C4\uC744 \uBE7C\uC557\uC9C0 \uBABB\uD558\uACE0 \uBB3C\uB7EC\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797592
    m_Localized: "...\uC26C\uB294 \uACF3\uAE4C\uC9C0 \uCC3E\uC544\uC640\uC11C \uC774\uB7EC\uB294
      \uAC70\uC608\uC694? ...\uB098\uAC00 \uC8FC\uC138\uC694. \n...\uC9C0\uAE08\uC740...
      \uC544\uBB34\uB3C4 \uBCF4\uACE0 \uC2F6\uC9C0 \uC54A\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797593
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84\uB294 \uB098\uB97C \uB178\uB824\uBCF4\uBA70
      \uBC29 \uBB38\uC744 \uB2EB\uC544\uBC84\uB838\uB2E4. \n\uBB38 \uB108\uBA38\uC5D0\uC11C
      \uB0AE\uC740 \uC73C\uB974\uB801\uAC70\uB9BC\uC774 \uB4E4\uB824\uC654\uB2E4.
      \n(\uB9AC\uD2B8\uB9AC\uBC84 \uD638\uAC10\uB3C4 -10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797594
    m_Localized: "\uBB38 \uB108\uBA38\uC5D0\uC11C \uD750\uB290\uB07C\uB294 \uC18C\uB9AC\uAC00
      \uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797595
    m_Localized: "\uC9D1\uC5D0 \uAC00\uACE0 \uC2F6\uC5B4..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797596
    m_Localized: "\uD1A0\uB07C\uC5D0\uAC8C \uC5B4\uB5BB\uAC8C \uBC18\uC751\uD560
      \uAC83\uC778\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797597
    m_Localized: "\uAD1C\uCC2E\uB2C8? \uBB54\uAC00 \uD798\uB4E0\uC77C\uC774 \uC788\uB2E4\uBA74
      \uB9D0\uD574\uC92C\uC73C\uBA74 \uC88B\uACA0\uAD6C\uB098"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797598
    m_Localized: "\uD558\uC9C0\uB9CC... \uB0B4 \uBAB8\uC5D0 \uD138\uB3C4 \uB098\uC788\uACE0
      \uC774\uC0C1\uD574\uC84C\uB294\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797599
    m_Localized: "\uC774\uC0C1\uD558\uC9C0 \uC54A\uC544. \uB098\uD55C\uD14C\uB3C4
      \uD138\uC774 \uB098\uC788\uB294\uAC78"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797600
    m_Localized: "...\uC815\uB9D0? ...\uC548 \uC6C3\uC744 \uAC70\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797601
    m_Localized: "\uC7A0\uC2DC\uD6C4, \uBB38\uC774 \uC5F4\uB838\uACE0 \uD1A0\uB07C\uC758
      \uBAB8\uC740 \uD138\uB85C \uB36E\uC5EC \uC788\uC5C8\uB2E4. \n\uCEE4\uB2E4\uB780
      \uADC0\uB294 \uACC4\uC18D \uB5A8\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044205797602
    m_Localized: "...\uC5C4\uB9C8\uAC00... ...\uB0A0 \uBABB \uC54C\uC544\uBCF4\uBA74
      \uC5B4\uB5A1\uD558\uC9C0? \uB098...\uB3CC\uC544\uAC08 \uC218 \uC788\uC744\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380288
    m_Localized: "\uD1A0\uB07C\uB294 \uBD88\uC548\uD55C \uB208\uBE5B\uC73C\uB85C
      \uB098\uB97C \uC62C\uB824\uB2E4\uBD24\uB2E4. \uB098\uB294 \uD1A0\uB07C\uB97C
      \uC704\uB85C\uD574\uC92C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380289
    m_Localized: "\uACE0\uB9D9\uC2B5\uB2C8\uB2E4. \uC870\uAE08 \uB098\uC544\uC84C\uC5B4\uC694\"
      \n(\uD1A0\uB07C \uD638\uAC10\uB3C4 +10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380290
    m_Localized: "\uB098\uB294 \uC870\uC6A9\uD788 \uBB38\uC744 \uC5F4\uC5B4\uBCF4\uB824
      \uC2DC\uB3C4\uD588\uB2E4. \uCF85! \uD558\uB294 \uC18C\uB9AC\uC640 \uD568\uAED8
      \uBB38\uC774 \uD754\uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380291
    m_Localized: "\uAE84\uC544!! \uB3C4\uC640\uC918!!"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380292
    m_Localized: "\uD1A0\uB07C\uB294 \uB180\uB77C\uBC84\uB838\uACE0 \uADF8\uB140\uC758
      \uC6B8\uC74C\uC18C\uB9AC\uAC00 \uBCF5\uB3C4\uC5D0 \uC6B8\uB824 \uD37C\uC84C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380293
    m_Localized: ".. \uB204\uAD70\uAC00\uAC00 \uC624\uAE30 \uC804\uC5D0 \uB2E4\uB978
      \uACF3\uC73C\uB85C \uC774\uB3D9\uD558\uC600\uB2E4 \n(\uD1A0\uB07C \uD638\uAC10\uB3C4
      -10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380294
    m_Localized: "\uC5EC\uC6B0\uC758 \uBC29\uC740 \uC11C\uB958\uC640 \uC5F0\uAD6C\uC790\uB8CC\uB85C
      \uAC00\uB4DD\uD588\uB2E4. \n\uCC45\uC0C1 \uC704\uC5D0\uB294 \uC784\uC0C1\uC2DC\uD5D8
      \uB3D9\uC758\uC11C\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380295
    m_Localized: "\uADF8\uB9AC\uACE0. \uB0A1\uC740 \uB179\uC74C\uAE30 \uD558\uB098.
      \uC7AC\uC0DD \uBC84\uD2BC\uC744 \uB204\uB974\uC790. \n\uC775\uC219\uD55C \uBAA9\uC18C\uB9AC\uAC00
      \uD758\uB7EC\uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380296
    m_Localized: "(\uB179\uC74C):\uC774 \uCE58\uB8CC\uC81C\uB294 \uC778\uAC04\uC744
      \uC218\uC778\uC73C\uB85C \uBCC0\uD654\uC2DC\uD0A4\uB294 \uCE58\uBA85\uC801\uC778
      \uBD80\uC791\uC6A9\uC774 \uC788\uB2E4. \n...\uB2F9\uC7A5 \uC5F0\uAD6C\uB97C
      \uC911\uB2E8\uD574\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380297
    m_Localized: "\uC21C\uAC04. \uC5EC\uC6B0\uAC00 \uB4A4\uC5D0\uC11C \uB179\uC74C\uAE30\uB97C
      \uBE7C\uC557\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380298
    m_Localized: "\uB2E4\uB978 \uC0AC\uB78C\uC744 \uC18D\uC774\uB294\uAC74 \uC7AC\uBC0C\uC5C8\uC5B4?
      \uC544\uBB34\uAC83\uB3C4 \uBAA8\uB974\uB294 \uCC99 \uD558\uB354\uB2C8."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380299
    m_Localized: "\uC5EC\uC6B0\uC5D0\uAC8C \uC5B4\uB5BB\uAC8C \uBC18\uC751\uD560
      \uAC83\uC778\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380300
    m_Localized: "...\uAE30\uC5B5\uC740 \uC5C6\uC9C0\uB9CC. ...\uC800 \uBAA9\uC18C\uB9AC\uB294
      \uBD84\uBA85 \uC81C \uAC83\uC785\uB2C8\uB2E4. ...\uC81C\uAC00 \uCC45\uC784\uC9C0\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380301
    m_Localized: "...\uCC45\uC784? ...\uADF8\uAC8C \uB05D\uC774\uC57C? ...\uBD80\uC791\uC6A9\uC774
      \uC788\uC5C8\uB2E4\uBA74. ...\uACE0\uCE58\uBA74 \uB418\uB294 \uAC70\uC796\uC544.
      \n...\uC65C \uC804\uBD80 \uC5C6\uC560\uB824\uACE0 \uD588\uB294\uB370"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380302
    m_Localized: "\uCE58\uB8CC\uC81C\uAC00 \uC5C6\uC73C\uBA74... \uB3D9\uBB3C\uB85C
      \uBCC0\uD558\uB358 \uB9D0\uB358 \uC77C\uB2E8 \uC8FD\uB294\uAC70\uC796\uC544.
      \n\uB108\uB294 \uBD88\uCE58\uBCD1\uC5D0 \uAC78\uB9AC\uC9C0 \uC54A\uC544\uC11C
      \uC0C1\uAD00\uC774 \uC5C6\uB2E4 \uC774\uAC70\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380303
    m_Localized: "\uADF8\uB140\uB294 \uD765\uBD84\uD558\uBA70 \uB098\uB97C \uB0A0\uCE74\uB86D\uAC8C
      \uB178\uB824\uBCF4\uB354\uB2C8, \uC9C4\uC815\uD558\uBA70 \uB9D0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380304
    m_Localized: "\uADF8\uB798\uB3C4... \uC194\uC9C1\uD558\uAC8C \uB9D0\uD574\uC918\uC11C
      \uACE0\uB9D9\uB124. \n\uD558\uAE34 \uBD80\uC791\uC6A9\uB9CC \uACE0\uCE58\uBA74
      \uB418\uB294\uB370 \uD3D0\uAE30\uD588\uB2E4\uB294\uAC74 \uC5B4\uB5A4 \uBB38\uC81C\uAC00
      \uC788\uC5C8\uB2E4\uB294 \uAC70\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380305
    m_Localized: "\uCE58\uB8CC\uC81C\uBD80\uD130 \uCC3E\uC790. \uB098\uC911\uC5D0
      \uAE30\uC5B5\uC774 \uB3CC\uC544\uC624\uBA74 \uADF8\uB54C \uC65C \uADF8\uB7AC\uB294\uC9C0
      \uB9D0\uD574\uC918\uC57C\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380306
    m_Localized: "\uC5EC\uC6B0\uB294 \uB179\uC74C\uAE30\uB97C \uD488\uC5D0 \uC548\uACE0
      \uBC29\uC744 \uB098\uC130\uB2E4. \uADF8\uB140\uC758 \uB208\uBE5B\uC5D0\uB294
      \uC5EC\uC804\uD788 \uBD88\uC2E0\uC774 \uB0A8\uC544\uC788\uC5C8\uC9C0\uB9CC,\n
      \uCE58\uB8CC\uC81C\uC5D0 \uB300\uD55C \uC5F4\uB9DD\uC774 \uB354 \uAC15\uD574
      \uBCF4\uC600\uB2E4. \n(\uC5EC\uC6B0 \uD638\uAC10\uB3C4 +10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380307
    m_Localized: "\uB098\uB294 \uC21C\uAC04\uC801\uC73C\uB85C \uB179\uC74C\uAE30\uB97C
      \uBE7C\uC557\uC544 \uBC14\uB2E5\uC5D0 \uB0B4\uB358\uC84C\uB2E4. \n\uB179\uC74C\uAE30\uB294
      \uBD80\uC154\uC838 \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uAC8C \uB418\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380308
    m_Localized: "...\uBB50 \uD558\uB294 \uAC70\uC57C. ...\uC99D\uAC70\uB97C \uC5C6\uC560\uBA74.
      ...\uC5C6\uB358 \uC77C\uC774 \uB418\uB294 \uC904 \uC54C\uC544?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380309
    m_Localized: "\uADF8\uB140\uB294 \uBD84\uB178\uC5D0 \uCC2C \uB208\uC73C\uB85C
      \uB098\uB97C \uB178\uB824\uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380310
    m_Localized: "...\uD55C \uBC88\uB9CC \uB354 \uC774\uB7F0 \uC9D3 \uD558\uBA74.
      ...\uADF8\uB550 \uC815\uB9D0 \uCC38\uC9C0 \uC54A\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380311
    m_Localized: "\uC5EC\uC6B0\uB294 \uB098\uB97C \uBC00\uCCD0\uB0B8 \uB4A4 \uB4F1\uC744
      \uB3CC\uB838\uB2E4. \uADF8\uB140\uC758 \uB4F1\uC5D0\uC11C \uAF2C\uB9AC\uAC00
      \uACA9\uB82C\uD558\uAC8C \uD754\uB4E4\uB838\uB2E4. \n\uADF8\uB140\uC758 \uBD84\uB178\uAC00
      \uB290\uAEF4\uC84C\uB2E4. \n(\uC5EC\uC6B0 \uD638\uAC10\uB3C4 -10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380312
    m_Localized: "\uC591\uC758 \uBC29\uC740 \uB2E4\uB978 \uBC29\uB4E4\uACFC \uB2EC\uB9AC
      \uAE54\uB054\uD558\uAC8C \uC815\uB3C8\uB418\uC5B4 \uC788\uC5C8\uB2E4. \uCE68\uB300
      \uC704\uC5D0\uB294 \uC791\uC740 \uC77C\uAE30\uC7A5\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380313
    m_Localized: "\uC77C\uAE30\uC7A5\uC744 \uD3BC\uCE58\uC790, \uADF8\uB140\uC758
      \uC12C\uC138\uD55C \uD544\uCCB4\uB85C \uC4F0\uC778 \uAE00\uB4E4\uC774 \uB208\uC5D0
      \uB4E4\uC5B4\uC654\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380314
    m_Localized: "\uADF8\uB140\uC758 \uBD88\uCE58\uBCD1\uC5D0 \uB300\uD55C \uC808\uB9DD\uACFC,
      \uB2F9\uC2E0\uC758 \uC5F0\uAD6C\uC5D0 \uB300\uD55C \uD76C\uB9DD\uC774 \uAD50\uCC28\uD558\uB294
      \uB0B4\uC6A9\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380315
    m_Localized: "\uD558\uC9C0\uB9CC \uB9C8\uC9C0\uB9C9 \uD398\uC774\uC9C0\uC5D0\uB294
      \uC54C \uC218 \uC5C6\uB294 \uAE30\uD638\uC640 \uD568\uAED8 '\uC0C8\uB85C\uC6B4
      \uC138\uC0C1'\uC774\uB77C\uB294 \uBB38\uAD6C\uAC00 \uBC18\uBCF5\uB418\uC5B4
      \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380316
    m_Localized: "\uC77C\uAE30\uC7A5\uC744 \uB0B4\uB824\uB193\uACE0 \uC7A0\uC2DC
      \uC0DD\uAC01\uC744 \uD558\uACE0\uC788\uC744\uB54C, \uBB38\uC774 \uC5F4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380317
    m_Localized: "\uC5B4\uBA38? \uC5B8\uC81C \uC624\uC168\uC5B4\uC694? ...\uC81C
      \uBC29\uC5D0\uC11C. ...\uBB50 \uD558\uACE0 \uACC4\uC168\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380318
    m_Localized: "\uC591\uC740 \uC77C\uAE30\uC7A5\uC744 \uAE09\uD788 \uC228\uAE30\uACE0
      \uB0B4 \uB300\uB2F5\uC744 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380319
    m_Localized: "\uC591\uC5D0\uAC8C \uC5B4\uB5BB\uAC8C \uBC18\uC751\uD560 \uAC83\uC778\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380320
    m_Localized: "\uC77C\uAE30\uC7A5 \uB0B4\uC6A9\uC774 \uAD81\uAE08\uD558\uAD70\uC694.
      '\uC0C8\uB85C\uC6B4 \uC138\uC0C1'\uC740 \uBB34\uC5C7\uC744 \uC758\uBBF8\uD569\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380321
    m_Localized: "...\uC544\uC9C1\uB3C4 \uAE30\uC5B5 \uC548 \uB098\uC138\uC694? ...\uADF8
      \uC57D... \uB2F9\uC2E0\uC774 \uC5C6\uC560\uB824 \uD588\uC796\uC544\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380322
    m_Localized: "\uBB38\uB4DD \uAC00\uC7A5 \uCD5C\uADFC \uB5A0\uC624\uB974\uB294
      \uAE30\uC5B5\uC778 \uB204\uAD70\uAC00\uC640 \uC2F8\uC6B0\uB2E4\uAC00... \uC2E4\uD5D8\uC6A9
      \uCE58\uB8CC\uC81C\uB97C \uB5A8\uC5B4\uB728\uB9B0 \uAE30\uC5B5\uC774 \uB5A0\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380323
    m_Localized: "\uADF8\uB85C\uC778\uD574 \uC5F0\uAD6C\uC2E4\uC774 \uD3D0\uC1C4\uB418\uACE0\u2026
      \uC6B0\uB9AC\uAC00 \uC774\uB807\uAC8C \uBCC0\uD55C \uAC83\uC77C\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380324
    m_Localized: "\uC800\uC640 \uC2F8\uC6B0\uB358\uAC8C \uB2F9\uC2E0\uC774\uC5C8\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380325
    m_Localized: "...\uC65C \uD3D0\uAE30\uD558\uB824 \uD588\uC8E0? ...\uC6B0\uB9AC\uB294
      \uC8FD\uC5B4\uAC00\uACE0 \uC788\uC5C8\uB294\uB370. \uB0A8\uC740 \uD76C\uB9DD\uC740
      \uC774\uAC83\uBC16\uC5D0 \uC5C6\uC5C8\uB294\uB370\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380326
    m_Localized: "...\uBD80\uC791\uC6A9\uC740 ...\uACE0\uCE58\uBA74 \uB418\uB294
      \uAC70\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380327
    m_Localized: "...\uADF8\uB798\uB3C4. ...\uC800\uB294 \uC624\uD788\uB824 \uC9C0\uAE08\uC774
      \uC2EB\uC9C0 \uC54A\uC544\uC694... \uB3D9\uBB3C\uC740 \uC801\uC5B4\uB3C4 \uAC70\uC9D3\uB9D0\uC740
      \uC548\uD558\uB2C8\uAE4C"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380328
    m_Localized: "\uADF8\uB807\uAC8C \uB9D0\uD558\uB294 \uC591\uC5D0\uAC8C\uC11C\uB294
      \uC21C\uAC04 \uC12C\uB729\uD55C \uB290\uB08C\uC774 \uB290\uAEF4\uC84C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380329
    m_Localized: "...\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uB294. ...\uB9D0\uD558\uC9C0
      \uB9D0\uC544 \uC8FC\uC138\uC694. \n(\uC591 \uD638\uAC10\uB3C4 +10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380330
    m_Localized: "\uB098\uB294 \uADF8\uB140\uC758 \uBC29\uC744 \uB098\uC130\uB2E4.
      \uBB38\uD2C8 \uC0AC\uC774\uB85C \uC591\uC774 \uB098\uB97C \uBC14\uB77C\uBCF4\uACE0
      \uC788\uC5C8\uB2E4. \uB098\uB294 \uC11C\uB458\uB7EC \uBC16\uC73C\uB85C \uB098\uAC14\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380331
    m_Localized: "\uC544\uBB34\uAC83\uB3C4 \uBCF4\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
      \uADF8\uC800 \uC26C\uACE0 \uC788\uC744 \uBFD0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380332
    m_Localized: "...\uD6C4\uD6C4. \uB2E4\uD589\uC774\uB124\uC694. ...\uC800\uB294
      \uADF8\uC800... \uD3C9\uBC94\uD55C \uD658\uC790\uC77C \uBFD0\uC778\uAC78\uC694.
      \n(\uC591 \uD638\uAC10\uB3C4 +10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380333
    m_Localized: "\uC591\uC740 \uB2E4\uC2DC \uC21C\uC9C4\uD55C \uBBF8\uC18C\uB97C
      \uC9C0\uC5C8\uB2E4. \uD558\uC9C0\uB9CC \uADF8\uB140\uC758 \uB208\uBE5B\uC740
      \uC5EC\uC804\uD788 \uC54C \uC218 \uC5C6\uB294 \uBE5B\uC744 \uB760\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380334
    m_Localized: "\uB098\uB294 \uADF8\uB140\uC758 \uBC29\uC744 \uB098\uC130\uB2E4.
      \uBB38\uD2C8 \uC0AC\uC774\uB85C \uC591\uC774 \uB098\uB97C \uBC14\uB77C\uBCF4\uACE0
      \uC788\uC5C8\uB2E4. \n\uADF8\uB140\uC758 \uC774\uC911\uC801\uC778 \uBAA8\uC2B5\uC774
      \uB098\uB97C \uD63C\uB780\uC2A4\uB7FD\uAC8C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380335
    m_Localized: "\uC9E7\uC740 \uD734\uC2DD\uC740 \uB05D\uB0AC\uB2E4. \uBAB8\uC740
      \uC870\uAE08 \uD68C\uBCF5\uB410\uC9C0\uB9CC, \n\uC218\uC778\uD654\uB294 \uB354\uC6B1
      \uAE4A\uC5B4\uC9C0\uBA70 \uAC00\uB054\uC529 \uB9D0\uC744 \uD558\uB358 \uB3C4\uC911
      \uC9D0\uC2B9\uC758 \uC6B8\uC74C\uC774 \uC11E\uC5EC \uB098\uC654\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380336
    m_Localized: "...\uAC00\uC8E0. ...\uC774\uC81C. ...\uCE58\uB8CC\uC81C\uB97C \uCC3E\uC544\uC57C
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380337
    m_Localized: "\uC6B0\uB9AC\uB294 \uB2E4\uC2DC \uACC4\uB2E8\uC744 \uC62C\uB790\uB2E4.
      3\uCE35. \uADF8\uACF3\uC5D0\uC11C \uD76C\uB9DD\uC744 \uCC3E\uAE30\uB97C \uBC14\uB77C\uBA70"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380338
    m_Localized: "3\uCE35 \uBB38\uC740 \uC774\uC0C1\uD558\uAC8C\uB3C4 \uC7A0\uACA8\uC788\uC9C0
      \uC54A\uC558\uB2E4. \uD558\uC9C0\uB9CC \uBB38\uC744 \uC5EC\uB294 \uC21C\uAC04
      \uCC28\uAC00\uC6B4 \uACF5\uAE30\uAC00 \uD758\uB7EC\uB098\uC654\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380339
    m_Localized: "1\uCE35\uC774 \uC5B4\uB290\uC815\uB3C4 \uC815\uB3C8\uB41C \uC5F0\uAD6C
      \uACF5\uAC04\uC774\uC5C8\uB2E4\uBA74, 3\uCE35\uC740 \uB204\uAD70\uAC00 \uAE09\uD558\uAC8C
      \uB5A0\uB09C \uC7A5\uC18C\uCC98\uB7FC \uBCF4\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380340
    m_Localized: "\uC6B0\uB9AC\uB294 \uC774\uC81C, \uC644\uC804\uD788 \uB3D9\uBB3C\uC758
      \uBAA8\uC2B5\uC774 \uB418\uC5B4\uC788\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380341
    m_Localized: "...\uC5EC\uAE30\uB294 \uB300\uD53C\uD55C \uD754\uC801 \uAC19\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380342
    m_Localized: "\uC815\uB9D0 \uAE09\uD558\uAC8C \uB098\uAC04 \uAC83 \uAC19\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380343
    m_Localized: "\uBCBD\uBA74\uC5D0\uB294 \uBE44\uC0C1 \uC548\uB0B4 \uBA54\uC2DC\uC9C0\uAC00
      \uB0A8\uC544\uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380344
    m_Localized: "`===== \uAE34\uAE09 \uB300\uD53C \uC548\uB0B4 =====\n\uC0DD\uBB3C\uC7AC\uD574
      \uBC1C\uC0DD \uD655\uC778\n\uBAA8\uB4E0 \uC5F0\uAD6C\uC6D0 \uBC0F \uCE58\uB8CC
      \uB300\uC0C1\uC790\uB294\n\uC9C0\uC815\uB41C \uC548\uC804 \uAD6C\uC5ED\uC73C\uB85C
      \uC774\uB3D9\uD558\uC2ED\uC2DC\uC624.\n3\uCE35 \uC5F0\uAD6C \uAD6C\uC5ED \uC811\uADFC
      \uAE08\uC9C0\n========================"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380345
    m_Localized: "\uB098\uBA38\uC9C0 \uC0AC\uB78C\uB4E4\uC740 \uB2E4 \uB300\uD53C\uD55C
      \uAC78\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380346
    m_Localized: "\uC544\uBB34\uB3C4 \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4.
      \uD558\uC9C0\uB9CC \uD55C \uAC00\uC9C0\uB294 \uD655\uC2E4\uD574\uC84C\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380347
    m_Localized: "\uCE58\uB8CC\uC81C\uB97C \uCC3E\uC9C0 \uBABB\uD55C\uB2E4\uBA74
      \uC6B0\uB9AC\uB294 \uC678\uBD80\uC640 \uACA9\uB9AC\uB418\uC5B4 \uC774\uACF3\uC5D0
      \uAC07\uD790 \uC218\uBC16\uC5D0 \uC5C6\uB2E4\uB294 \uAC83\uC744."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380348
    m_Localized: "\uC810\uC810 \uBAB8 \uC0C1\uD0DC\uAC00 \uC88B\uC9C0 \uC54A\uB294
      \uAC83\uC774 \uB290\uAEF4\uC84C\uB2E4. \n\uC2DC\uAC04\uC808\uC57D\uC744 \uC704\uD574
      3\uCE35\uC5D0\uC11C\uB3C4 \uAC01\uC790 \uD769\uC5B4\uC838\uC11C \uD0D0\uC0C9\uC744
      \uD558\uAE30\uB85C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380349
    m_Localized: "\uAD1C\uCC2E\uACA0\uC5B4? \uC544\uC9C1 \uC5B4\uB9B0 \uB124\uAC00
      \uD63C\uC790\uC11C \uD0D0\uC0C9\uC744 \uD55C\uB2E4\uB2C8"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380350
    m_Localized: "\uAD1C\uCC2E\uC544\uC694. \uC800 \uD798\uC774 \uB9CE\uC774 \uC138\uC84C\uB294\uAC78\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380351
    m_Localized: "\uD1A0\uB07C\uB294 \uC8FC\uBCC0\uC758 \uB3CC\uC744 \uC8FC\uC6CC\uB4E4\uB354\uB2C8
      \uC950\uC5B4\uC11C \uB3CC\uC744 \uBD80\uC168\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380352
    m_Localized: "\uC74C... \uD655\uC2E4\uD788 \uC138\uAE34 \uD558\uB124\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380353
    m_Localized: "\uADF8\uB7FC \uD1A0\uB07C\uB294 \uD0D0\uC0C9\uD558\uAE30 \uC27D\uACE0
      \uC704\uD5D8\uD55C \uBB3C\uAC74\uC774 \uC5C6\uB294 \uD658\uC790 \uB300\uAE30\uC2E4\uC744
      \uC218\uC0C9\uD574\uC904\uC218 \uC788\uACA0\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380354
    m_Localized: "\uB124. \uBB34\uC2A8\uC77C\uC774 \uC788\uC73C\uBA74 \uB6F0\uC5B4\uC11C
      \uB3C4\uB9DD\uCE60\uAC8C\uC694 \uC800 \uB2EC\uB9AC\uAE30\uB3C4 \uBE68\uB77C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380355
    m_Localized: "\uC800\uB294 \uADF8\uB7FC \uBCF4\uC548\uC2E4\uC744 \uD0D0\uC0C9\uD560\uAC8C\uC694
      \uC9C0\uB3C4\uB97C \uBCF4\uBA74 \uD658\uC790 \uB300\uAE30\uC2E4\uACFC \uAC00\uAE4C\uC6B0\uB2C8
      \uBB34\uC2A8\uC77C\uC774 \uC788\uC73C\uBA74 \uD1A0\uB07C\uB97C \uB3C4\uC640\uC904\uC218
      \uC788\uACA0\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380356
    m_Localized: "\uADF8\uB798 \uC9C0\uB3C4\uB97C \uBCF4\uBA74 \uB098\uB791 \uB9AC\uD2B8\uB9AC\uBC84\uB294
      \uC880 \uBA40\uB9AC\uC11C \uC218\uC0C9\uC744 \uD574\uC57C\uACA0\uB124. \n\uC8FC\uBCC0\uC5D0
      \uB2E4\uB978 \uC0AC\uB78C\uC774 \uB0A8\uC544\uC788\uB294\uC9C0\uB3C4 \uD655\uC778
      \uD574\uBD10\uC57C\uACA0\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380357
    m_Localized: "\uBAA8\uB450 \uD769\uC5B4\uC9C0\uACE0, \uCC3D\uACE0\uB97C \uC218\uC0C9\uD558\uACE0
      \uB09C \uB4A4, \uC2DC\uAC04\uC774 \uB0A8\uC544\uC788\uB294 \uAC83\uC744 \uD655\uC778\uD558\uC600\uB2E4.
      \uC8FC\uBCC0\uC744 \uB4E4\uB9B4 \uC218 \uC788\uC744\uAC83\uAC19\uC740\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380358
    m_Localized: "\uC5B4\uB514\uB97C \uBC29\uBB38\uD574\uBCFC\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380359
    m_Localized: "\uBCF4\uC548\uC2E4\uC5D0 \uB3C4\uCC29\uD558\uC790 \uCEE4\uB2E4\uB780
      \uBAA8\uB2C8\uD130\uC5D0\uB294 CCTV\uC640... \uC0AC\uACE0 \uB2F9\uC2DC \uAE30\uB85D\uC774
      \uBC18\uBCF5 \uC7AC\uC0DD\uB418\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380360
    m_Localized: "[\uBE44\uC0C1 \uAE30\uB85D]\n\uBC1C\uC0DD \uC2DC\uAC04: ??\uC2DC
      ??\uBD84\n\uC704\uD5D8 \uBB3C\uC9C8 \uB204\uCD9C \uAC10\uC9C0\n\uC6D0\uC778:
      \uD655\uC778 \uD544\uC694\n\uB300\uC751: \uC2DC\uC124 \uBD09\uC1C4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380361
    m_Localized: "[\uCD9C\uC785 \uAE30\uB85D]\n3\uCE35 \uC5F0\uAD6C \uAD6C\uC5ED\n\uC811\uADFC\uC790:\n\uAD00\uB9AC
      \uCC45\uC784\uC790 1\uBA85\n\uCE58\uB8CC \uB300\uC0C1\uC790 1\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380362
    m_Localized: "\uC0AC\uACE0 \uB2F9\uC2DC \uAE30\uB85D\uC5D0\uB294 \uC591\uACFC
      \uB0B4\uAC00 \uB300\uD654\uB97C \uD558\uB2E4\uAC00 \uBC14\uB2E5\uC5D0 \uBC14\uC774\uB7EC\uC2A4
      \uC570\uD50C\uC774 \uAEA0\uC9C0\uACE0, \n\uC2DC\uC124\uC5D0 \uBE44\uC0C1\uC774
      \uAC78\uB9AC\uB294 \uACFC\uC815\uC774 \uAE30\uB85D\uB418\uC5B4\uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380363
    m_Localized: "...\uC9C0\uAE08\uC740 \uC5B4\uB5A4\uAC00\uC694? \uAE30\uC5B5\uC774
      \uB098\uAE30 \uC2DC\uC791\uD588\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380364
    m_Localized: "\uC5B4\uB290\uC0C8 \uB4A4\uB85C \uB2E4\uAC00\uC628 \uC591\uC774
      \uBB3C\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380365
    m_Localized: "\uADF8\uB7AC\uAD70\uC694... \uB204\uAD70\uAC00\uC640 \uB300\uD654\uB97C
      \uD558\uB2E4\uAC00 \uBC14\uC774\uB7EC\uC2A4\uAC00 \uC720\uCD9C\uB41C \uAE30\uC5B5\uC774
      \uC788\uB294\uB370 \uB2F9\uC2E0\uC774\uC5C8\uC2B5\uB2C8\uAE4C"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380366
    m_Localized: "\uD558\uC9C0\uB9CC \uC5EC\uC804\uD788 \uC911\uC694\uD55C \uBD80\uBD84\uB4E4\uC740
      \uC7A1\uD788\uC9C0 \uC54A\uB294\uB2E4. \uBA38\uB9BF\uC18D\uC5D0 \uC548\uAC1C\uAC00
      \uB080 \uAC83\uCC98\uB7FC \uBAA8\uB4E0 \uAC83\uC774 \uC544\uB4DD\uD558\uACE0
      \uD750\uB9BF\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380367
    m_Localized: "\uC74C... \uAE30\uC5B5\uC774 \uC548\uB098\uC2DC\uB098 \uBCF4\uB124\uC694...
      \uC774\uAC83\uB3C4 \uBD80\uC791\uC6A9\uC778\uAC00? \uD558\uC9C0\uB9CC \uC5B8\uC820\uAC04
      \uAD1C\uCC2E\uC544\uC9C0\uACA0\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380368
    m_Localized: "\uADF8\uB098\uC800\uB098, \uBB3C\uC5B4\uBCF4\uACE0 \uC2F6\uC740
      \uAC8C \uC788\uC5B4\uC694. \uC55E\uC73C\uB85C\uB3C4 \uC6B0\uB9AC\uAC00 \uC774\uB807\uAC8C...
      \uB3D9\uBB3C\uB85C \uC0B4\uC544\uAC04\uB2E4\uBA74 \uC5B4\uB5A8 \uAC83 \uAC19\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380369
    m_Localized: "\uC591\uC740 \uD765\uBBF8\uC9C4\uC9C4\uD55C \uB208\uBE5B\uC73C\uB85C
      \uB098\uB97C \uBC14\uB77C\uBCF4\uBA70 \uB300\uB2F5\uC744 \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380370
    m_Localized: "\uC591\uC758 \uB9D0\uC5D0 \uC5B4\uB5BB\uAC8C \uB300\uB2F5\uD560\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380371
    m_Localized: "\uC6B0\uB9AC\uB294 \uC778\uAC04\uC785\uB2C8\uB2E4. \uADF8\uB9AC\uACE0...
      \uB2E4\uB978 \uBD84\uB4E4\uC740 \uC6D0\uCE58 \uC54A\uAC8C \uB3D9\uBB3C\uC774
      \uB41C \uB9CC\uD07C, \n\uC800\uC5D0\uAC90 \uBAA8\uB450\uB97C \uB2E4\uC2DC \uC778\uAC04\uC73C\uB85C
      \uB418\uB3CC\uB824\uC57C \uD560 \uCC45\uC784\uC774 \uC788\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380372
    m_Localized: "\uD750\uC751... \uADF8\uB798\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380373
    m_Localized: "\uC591\uC740 \uBBF8\uC18C\uC9C0\uC73C\uBA70 \uB098\uC5D0\uAC8C
      \uB2E4\uAC00\uC654\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380374
    m_Localized: "\uD558\uC9C0\uB9CC \uB9CC\uC57D... \uC778\uAC04\uC73C\uB85C \uB3CC\uC544\uAC00\uACE0
      \uC2F6\uC9C0 \uC54A\uC740 \uC0AC\uB78C\uC774 \uC788\uB2E4\uBA74\uC694? \n\uC9C0\uAE08
      \uC774\uB300\uB85C\uAC00 \uB354 \uD589\uBCF5\uD558\uB2E4\uACE0 \uD558\uB294
      \uC0AC\uB78C\uC774 \uC788\uB2E4\uBA74, \uC5B4\uB5BB\uAC8C \uD560 \uAC74\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380375
    m_Localized: "\uADF8\uAC74... \uC548 \uB429\uB2C8\uB2E4. \uB05D\uAE4C\uC9C0 \uCE58\uB8CC\uB97C
      \uAC70\uBD80\uD55C\uB2E4\uBA74, \uC0AC\uD68C \uC548\uC804\uC744 \uC704\uD574\uC11C\uB77C\uB3C4
      \uACA9\uB9AC \uC870\uCE58\uB420 \uAC81\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380376
    m_Localized: "\uACA9\uB9AC\uB77C\uB2C8... \uD6C4\uD6C4, \uC5ED\uC2DC \uC0AC\uB78C\uC740
      \uCC38 \uC624\uB9CC\uD558\uACE0 \uC774\uAE30\uC801\uC774\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380377
    m_Localized: "\uACB0\uAD6D \uB2F9\uC2E0\uB4E4\uC774 \uB9D0\uD558\uB294 '\uC815\uC0C1'\uC5D0
      \uB9DE\uCD94\uC9C0 \uC54A\uC73C\uBA74, \uB610\uB2E4\uC2DC \uAC00\uB450\uACE0
      \uD1B5\uC81C\uD558\uACA0\uB2E4\uB294 \uAC70\uC796\uC544\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380378
    m_Localized: "\uADF8\uAC8C \uB2F9\uC2E0\uB4E4\uC774 \uADF8\uD1A0\uB85D \uC9C0\uD0A4\uACE0
      \uC2F6\uC5B4 \uD558\uB294 '\uC778\uAC04\uC758 \uC724\uB9AC'\uC778\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380379
    m_Localized: "\uC5B4\uCA4C\uBA74 \uC5B4\uB290\uC815\uB3C4\uB294 \uB3D9\uBB3C\uC758
      \uBAA8\uC2B5\uC774 \uC88B\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4\uB294 \uC0DD\uAC01\uC744
      \uD558\uAE30\uB294 \uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380380
    m_Localized: "\uD655\uC2E4\uD788 \uBD80\uC791\uC6A9\uC774\uAE34 \uD574\uB3C4
      \uBD88\uCE58\uBCD1\uC740 \uCE58\uB8CC\uAC00 \uB418\uC5C8\uACE0, \uAC10\uAC01\uC774\uB098
      \uC2E0\uCCB4 \uB2A5\uB825\uB3C4 \uD6E8\uC52C \uC88B\uC544\uC9C4\uAC8C \uB290\uAEF4\uC9C0\uB124\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380381
    m_Localized: "\uD750\uC751... \uADF8\uB798\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380382
    m_Localized: "\uC591\uC740 \uBBF8\uC18C\uC9C0\uC73C\uBA70 \uB098\uC5D0\uAC8C
      \uB2E4\uAC00\uC654\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380383
    m_Localized: "\uB9DE\uC544\uC694, \uBC14\uB85C \uADF8\uAC70\uC608\uC694! \uB2F9\uC2E0\uB3C4
      \uB290\uB07C\uACE0 \uC788\uC796\uC544\uC694? \n\uC2E0\uCCB4\uB294 \uAC74\uAC15\uD574\uC9C0\uACE0
      \uC624\uD788\uB824 \uBAA8\uB4E0 \uC0AC\uB78C\uB4E4\uC774 \uB3D9\uBB3C\uB85C
      \uBCC0\uD558\uB294\uAC8C \uC88B\uC9C0 \uC54A\uC744\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380384
    m_Localized: "\uCE58\uB8CC\uD560 \uBC29\uBC95\uC744 \uCC3E\uB294\uB2E4\uB2C8,
      \uADF8\uAC74 \uC21C\uC751\uC774 \uC544\uB2C8\uB77C '\uD1F4\uD654'\uC608\uC694.
      \n\uB2F9\uC2E0\uC740 \uC774\uBBF8 \uD55C \uB2E8\uACC4 \uB354 \uB6F0\uC5B4\uB09C
      \uC874\uC7AC\uB85C \uC9C4\uD654\uD55C \uAC70\uB77C\uACE0\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380385
    m_Localized: "\uADF8\uAC74... \uBB34\uC2A8 \uC18C\uB9AC\uC785\uB2C8\uAE4C? \uC6D0\uCE58
      \uC54A\uB294 \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uB3C4 \uB3D9\uBB3C\uB85C \uBCC0\uD654\uC2DC\uD0A8\uB2E4\uB294
      \uB9D0\uC785\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380386
    m_Localized: "\uC774 \uBD80\uC791\uC6A9\uC740 \uC7AC\uC559\uC774 \uC544\uB2C8\uB77C
      '\uAD6C\uC6D0'\uC774\uC5D0\uC694. \uC8FD\uC744\uB0A0\uB9CC \uAE30\uB2E4\uB9AC\uB358
      \uC800\uD76C\uB97C \uCE58\uB8CC\uD574\uC8FC\uACE0,\n \uBAA8\uB450\uAC00 \uAC70\uC9D3
      \uC5C6\uC774 \uC21C\uC218\uD574\uC9C0\uAC8C \uD560 \uC218\uC788\uB294..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380387
    m_Localized: "\uC774 \uBD80\uC791\uC6A9\uC774 \uAD6C\uC6D0\uC774\uB77C\uBA74
      \uC774\uAC78 \uB9CC\uB4E0 \uC800\uB294 \uAD6C\uC6D0\uC790\uB77C\uB294 \uAC81\uB2C8\uAE4C?
      \uADF8\uAC74 \uB9D0\uC774 \uC548\uB429\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380388
    m_Localized: "\uAD6C\uC6D0\uC790...?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380389
    m_Localized: "\uC591\uC740 \uB180\uB780 \uD45C\uC815\uC744 \uC9C0\uC73C\uBA70
      \uD718\uCCAD\uC774\uB2E4\uAC00 \uAE68\uB2EC\uC558\uB2E4\uB294 \uB4EF\uC774
      \uBB34\uB98E\uC744 \uAFC7\uACE0 \uBE64\uD788 \uBC14\uB77C\uBCF4\uC558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380390
    m_Localized: "\uADF8\uB798\uC694. \uC5B4\uCA4C\uBA74... \uB2F9\uC2E0\uC774? \uADF8\uB7F4\uC218\uB3C4
      \uC788\uACA0\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380391
    m_Localized: "\uC591\uC740 \uBA4D\uD55C \uD45C\uC815\uC73C\uB85C \uC549\uC544\uC788\uB2E4\uAC00
      \uC544\uBB34\uC77C\uB3C4 \uC5C6\uC5C8\uB2E4\uB294 \uB4EF\uC774 \uAE09\uD788
      \uB2E4\uC2DC \uC77C\uC5B4\uB098\uBC84\uB838\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380392
    m_Localized: "\uC5EC\uAE30\uB294 \uB2E4 \uCC3E\uC544\uBD24\uC5B4\uC694. \uC774\uC81C
      \uBC16\uC73C\uB85C \uB098\uAC08\uAE4C\uC694? (\uC591 \uD638\uAC10\uB3C4 + 10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380393
    m_Localized: "\uD658\uC790\uB4E4\uC774 \uC0AC\uACE0 \uC804 \uBA38\uBB3C\uB358
      \uACF5\uAC04\uC774\uC5C8\uB2E4. \uCE68\uB300 \uC606\uC5D0\uB294 \uD658\uC790\uB4E4\uC758
      \uAC1C\uC778 \uBB3C\uD488\uB4E4\uC774 \uB0A8\uC544\uC788\uC5C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380394
    m_Localized: "\uC8FC\uBCC0\uC5D0\uB294 \uD1A0\uB07C\uAC00 \uBB3C\uAC74\uB4E4\uC744
      \uBCF4\uBA70 \uC0DD\uAC01\uC5D0 \uC7A0\uAE34 \uB4EF \uBCF4\uC600\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380395
    m_Localized: "\uC8FC\uBCC0\uC758 \uC2A4\uCF00\uCE58\uBD81\uC5D0\uB294 \uC5B4\uB9B0\uC544\uC774\uAC00
      \uADF8\uB9B0 \uB4EF\uD55C \uADF8\uB9BC\uACFC \uD568\uAED8 \uC5EC\uB7EC \uC9E7\uC740
      \uAE00\uB4E4\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380396
    m_Localized: "`\uAC74\uAC15\uD558\uACE0 \uB2E4\uC2DC \uD559\uAD50\uC5D0 \uB098\uC640\uC57C\uD574!!`"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380397
    m_Localized: "\uAC70\uAE30\uC11C \uBB58 \uBCF4\uACE0 \uC788\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380398
    m_Localized: "\uB098... \uBCD1\uC6D0\uC5D0 \uC624\uAE30 \uC804\uC5D0\uB294 \uD559\uAD50\uC5D0
      \uB2E4\uB154\uC5B4. \uCE5C\uAD6C\uB4E4\uC774\uB791 \uB180\uACE0, \uC9D1\uC5D0\uC11C
      \uC0DD\uC77C \uCD95\uD558\uB3C4 \uD558\uACE0 \uAC74\uAC15\uD588\uC5C8\uB294\uB370 "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380399
    m_Localized: "\uC5B4\uB290 \uB0A0 \uAC11\uC790\uAE30 \uC228\uC774 \uCC28\uACE0
      \uD53D\uD53D \uC4F0\uB7EC\uC84C\uC5B4. \uC758\uC0AC \uC120\uC0DD\uB2D8\uC774
      \uB2E4\uB4E4 \uACE0\uAC1C\uB97C \uC813\uACE0... \uC5C4\uB9C8 \uC544\uBE60\uB294
      \uB9E4\uC77C \uC6B8\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380400
    m_Localized: "\uADF8\uB7EC\uB2E4 \uC5B4\uB5A4 \uC544\uC800\uC528\uAC00 \uADF8\uB7AC\uC5B4.
      \uC774 \uC5F0\uAD6C\uC18C\uC5D0 \uAC00\uBA74 \uC544\uD508 \uAC8C \uC2F9 \uB0AB\uC9C0\uB9CC
      \uB098\uC744\uB54C\uAE4C\uC9C0\uB294 \uB098\uAC08\uC218\uC5C6\uB2E4\uACE0... "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380401
    m_Localized: "\uADF8\uB798\uC11C \uC5C4\uB9C8 \uC544\uBE60\uAC00 \uB208\uBB3C\uC744
      \uD758\uB9AC\uBA74\uC11C \uB098\uB97C \uC5EC\uAE30\uB85C \uBCF4\uB0C8\uB294\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380402
    m_Localized: "\uC9C4\uC9DC\uB85C \uC548 \uC544\uD504\uAC8C \uB418\uAE34 \uD588\uC5B4.
      \uD0A4\uB3C4 \uC548 \uC790\uB77C\uACE0... \uADC0\uB3C4 \uAE38\uC5B4\uC9C0\uACE0...
      \uC9C4\uC9DC \uD1A0\uB07C\uAC00 \uB418\uC5B4\uBC84\uB838\uC9C0\uB9CC..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380403
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380404
    m_Localized: "\uC5C4\uB9C8 \uC544\uBE60\uAC00 \uBCF4\uACE0 \uC2F6\uC5B4. \uBCF4\uACE0
      \uC2F6\uC5B4\uC11C \uC8FD\uC744 \uAC83 \uAC19\uC740\uB370... \uC774\uB7F0 \uBAA8\uC2B5\uC73C\uB85C
      \uB3CC\uC544\uAC00\uBA74 \uC5C4\uB9C8\uAC00 \uB098\uB97C \uC54C\uC544\uBCF4\uAE30\uB294
      \uD560\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380405
    m_Localized: "\uB098... \uB3CC\uC544\uAC08\uC218 \uC788\uC744\uAE4C? \uC5B8\uB2C8\uB4E4\uC774
      \uADF8\uB7AC\uB294\uB370 \uC5F0\uAD6C\uC6D0\uC778 \uC544\uC800\uC528\uAC00
      \uC54C\uC218\uB3C4 \uC788\uB2E4\uACE0 \uD588\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380406
    m_Localized: "\uD1A0\uB07C\uC758 \uB9D0\uC5D0 \uC5B4\uB5BB\uAC8C \uB300\uB2F5\uD560\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380407
    m_Localized: "\uCE58\uB8CC\uC81C\uAC00 \uC788\uAE34 \uD558\uC9C0\uB9CC... 2\uAC1C\uBC16\uC5D0
      \uC5C6\uC5B4. \n\uC6B0\uB9AC\uB4E4\uC911 \uB204\uAD70\uAC00\uB294 \uB2E4\uC2DC
      \uCE58\uB8CC\uC81C\uB97C \uB9CC\uB4E4\uB54C\uAE4C\uC9C0\uB294 \uB3D9\uBB3C\uC758
      \uBAA8\uC2B5\uC73C\uB85C \uC0B4\uC544\uC57C\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380408
    m_Localized: "2\uAC1C... \uADF8\uB7FC \uB0B4\uAC00 \uC695\uC2EC\uC744 \uB0B4\uBC84\uB9AC\uBA74
      \uB2E4\uB978\uC0AC\uB78C\uB4E4\uC740 \uACC4\uC18D \uB3D9\uBB3C\uB85C \uC0B4\uC544\uC57C
      \uD558\uB294 \uAC70\uB124.."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380409
    m_Localized: "\uBD84\uBA85 \uC5B8\uB2C8\uB4E4\uB3C4 \uB098\uCC98\uB7FC \uC0AC\uB78C\uC73C\uB85C
      \uB3CC\uC544\uAC00\uACE0\uC2F6\uC744\uD150\uB370"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380410
    m_Localized: "\uD1A0\uB07C\uB294 \uC7A0\uC2DC \uC0DD\uAC01\uC744 \uD558\uB354\uB2C8
      \uC774\uB0B4 \uC791\uC740 \uC8FC\uBA39\uC744 \uC950\uBA70 \uC529\uC529\uD558\uAC8C
      \uB098\uB97C \uBC14\uB77C\uBCF4\uC558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380411
    m_Localized: "\uAD1C\uCC2E\uC544. \uB098 \uAE30\uB2E4\uB9B4\uC218 \uC788\uC5B4!
      \n\uC5C4\uB9C8\uC544\uBE60\uD55C\uD14C \uB9C8\uC9C0\uB9C9\uC5D0 \uC5F0\uB77D\uD588\uC744\uB54C\uB3C4
      \uC529\uC529\uD558\uAC8C \uC788\uACA0\uB2E4\uACE0 \uC57D\uC18D\uD588\uAC70\uB4E0
      \n(\uD1A0\uB07C \uD638\uAC10\uB3C4 +10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380412
    m_Localized: "\uB2F9\uC5F0\uD558\uC9C0, \uC6B0\uB9AC \uBAA8\uB450 \uC6D0\uB798\uB300\uB85C
      \uB3CC\uC544\uAC08\uC218 \uC788\uC5B4. \uAE08\uBC29 \uB098\uAC00\uAC8C \uB420\uAC70\uC57C"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380413
    m_Localized: "\uC815\uB9D0...? \uBAA8\uB450\uAC00 \uC0AC\uB78C\uC774 \uB418\uC5B4\uC11C
      \uBC16\uC5D0 \uB098\uAC08\uC218 \uC788\uB294\uAC70\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380414
    m_Localized: "... \uADF8\uB7FC \uBB3C\uB860\uC774\uC9C0 \uAE08\uBC29 \uBC29\uBC95\uB3C4
      \uCC3E\uACE0 \uB098\uAC08 \uC218\uC788\uC744\uAC70\uC57C \uAC71\uC815\uB9C8\uB834"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380415
    m_Localized: "... \uAC70\uC9D3\uB9D0"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380416
    m_Localized: "\uD1A0\uB07C\uC758 \uB208\uBE5B\uC774 \uCC28\uAC11\uAC8C \uC2DD\uC5B4
      \uB0B4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380417
    m_Localized: "\uC5B8\uB2C8\uB4E4\uD55C\uD14C \uB2E4 \uB4E4\uC5C8\uC5B4. \uC5B4\uCA4C\uBA74
      \uC6B0\uB9AC\uB294 \uB098\uAC00\uB354\uB77C\uB3C4 \uB3D9\uBB3C\uC758 \uBAA8\uC2B5\uC774\uB77C\uBA74
      \uC704\uD5D8\uD560 \uC218 \uC788\uB2E4\uACE0..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380418
    m_Localized: "\uC65C \uAC70\uC9D3\uB9D0\uD558\uB294\uAC70\uC57C? \uB098\uB294
      \uC5B4\uB9AC\uC9C0\uC54A\uC544. \uC544\uC800\uC528\uB3C4... \uCE58\uB8CC\uC81C\uAC00
      \uD0D0\uC774 \uB098\uB294\uAC70\uC57C?\" \n(\uD1A0\uB07C \uD638\uAC10\uB3C4
      -10)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380419
    m_Localized: "\uB098... \uBA3C\uC800 \uAC08\uAC8C. \uC5EC\uAE30\uB294 \uB2E4
      \uB458\uB7EC\uBD24\uAC70\uB4E0. \uC5B8\uB2C8\uB4E4 \uBB3C\uAC74\uB3C4 \uC880
      \uCC59\uACA8\uC11C \uC804\uD574\uC8FC\uACE0 \uC2F6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380420
    m_Localized: "\uD1A0\uB07C\uB294 \uB098\uB97C \uC2A4\uCCD0 \uC9C0\uB098\uCCD0
      \uB300\uAE30\uC2E4 \uBB38\uBC16\uC73C\uB85C \uAC78\uC5B4 \uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380421
    m_Localized: "3\uCE35 \uC218\uC0C9\uC774 \uB05D\uB098\uACE0 \uB9CC\uB098\uAE30\uB85C
      \uD55C \uC704\uCE58\uC5D0\uC11C \uB9CC\uB098\uAC8C \uB418\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380422
    m_Localized: "\uC0DD\uC874\uC790\uB294 \uC5C6\uC5C8\uC5B4... \uC544\uBB34\uB798\uB3C4
      \uB2E4 \uB300\uD53C\uD55C \uBAA8\uC591\uC774\uC57C"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380423
    m_Localized: "\uB300\uAE30\uC2E4\uC5D0\uB294 \uBCC4\uAC8C \uC5C6\uC5C8\uC5B4...
      \uC544 \uC5EC\uAE30 \uAC04\uC2DD\uC774\uB791 \uC5B8\uB2C8\uB4E4 \uBB3C\uAC74\uB3C4
      \uC788\uC5C8\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380424
    m_Localized: "\uD1A0\uB07C\uAC00 \uAC00\uBC29\uC5D0\uC11C \uACFC\uC790\uC640
      \uD39C\uACFC \uBE0C\uB85C\uCE58 \uAC19\uC740 \uAC1C\uC778 \uBB3C\uD488\uC744
      \uAEBC\uB0B4\uC11C \uAC74\uB0B4\uC8FC\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380425
    m_Localized: "\uBCF4\uC548\uC2E4\uC5D0\uB294 CCTV \uB370\uC774\uD130\uAC00 \uC804\uBD80
      \uC9C0\uC6CC\uC838\uC788\uC5C8\uC5B4\uC694 \uD558\uC9C0\uB9CC \uC5F0\uAD6C
      \uC9C0\uC6D0\uC2E4 \uBCF4\uC548 \uCF54\uB4DC\uB97C \uBC1C\uACAC\uD588\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380426
    m_Localized: "\uC800\uD76C\uAC00 \uC548\uAC00\uBCF8 \uC7A5\uC18C\uB294... \uADF8\uB7FC
      \uC5F0\uAD6C \uC9C0\uC6D0\uC2E4 \uBC16\uC5D0 \uC5C6\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380427
    m_Localized: "\uBAA8\uB450 \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uBA70 \uD0C8\uCD9C\uC744
      \uC704\uD55C \uB2E8\uC11C\uAC00 \uC788\uAE38 \uBC14\uB77C\uBA70 \uC5F0\uAD6C
      \uC9C0\uC6D0\uC2E4\uB85C \uD5A5\uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380428
    m_Localized: "\uC5F0\uAD6C \uC9C0\uC6D0\uC2E4\uC5D0\uB294 \uC0AC\uACE0 \uC9C1\uC804\uAE4C\uC9C0
      \uC0AC\uC6A9\uD588\uB358 \uAE30\uB85D\uB4E4\uC774 \uB0A8\uC544\uC788\uC5C8\uB2E4.
      \n\uD558\uC9C0\uB9CC \uB300\uBD80\uBD84\uC758 \uC790\uB8CC\uB294 \uC190\uC0C1\uB418\uC5B4
      \uD55C \uD30C\uC77C\uB9CC \uC5F4 \uC218 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380429
    m_Localized: "\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161\n\uCE58\uB8CC\uC81C
      \uAC1C\uBC1C \uC9C4\uD589 \uC0C1\uD669\n\uC2E0\uCCB4 \uBCC0\uD615 \uBCF5\uAD6C:
      \uBD88\uAC00\uB2A5 (\uB3D9\uBB3C\uC758 \uBAA8\uC2B5 \uC720\uC9C0)\n\uC774\uC131
      \uD68C\uBCF5: \uAC00\uB2A5 (\uC778\uAC04\uC758 \uC9C0\uB2A5\uACFC \uC790\uC544
      \uBCF4\uC874)\n\uD2B9\uC774\uC0AC\uD56D: \uD76C\uBC15\uD55C \uD655\uB960\uB85C
      \uCD94\uAC00 \uC2E0\uCCB4 \uBCC0\uD654 \uBC1C\uC0DD \uAC00\uB2A5.\n\uCD94\uAC00
      \uD655\uC778 \uD544\uC694\n\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161\u3161"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380430
    m_Localized: "...\uC774 \uCE58\uB8CC\uC81C \uC644\uBCBD\uD558\uC9C0\uB294 \uC54A\uC796\uC544?
      \uAC8C\uB2E4\uAC00... \uC2E0\uCCB4 \uBCC0\uD615 \uBCF5\uAD6C\uAC00 \uBD88\uAC00\uB2A5\uC774\uB77C\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380431
    m_Localized: "\uB2F9\uC2E0\uC740 \uC54C\uACE0 \uC788\uC5C8\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380432
    m_Localized: "\uB098\uB294 \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4. \uAE30\uC5B5\uC740
      \uC5C6\uC5C8\uC9C0\uB9CC, \uB0B4\uAC00 \uC774 \uC0AC\uC2E4\uC744 \uC54C\uACE0
      \uC788\uC5C8\uB358 \uAC83 \uAC19\uC740 \uB290\uB08C\uC774 \uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380433
    m_Localized: "\uC751...? \uC5EC\uAE30 \uBC14\uB2E5\uC5D0 \uD30C\uB780\uAC74 \uBB50\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380434
    m_Localized: "\uD1A0\uB07C\uB294 \uBC14\uB2E5\uC5D0\uC11C \uBB34\uC5B8\uAC00\uB97C
      \uC8FC\uC6E0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380435
    m_Localized: "\uC774\uAC74... \uC5F0\uAD6C\uC18C\uC5D0\uC11C \uC4F0\uB294 \uCE74\uB4DC\uD0A4\uC5D0\uC694!
      \uC544\uB9C8 \uD0A4\uAC00 \uC791\uC544\uC11C \uC774\uB7F0 \uAD6C\uC11D\uC5D0
      \uC788\uB294\uAC70\uB97C \uBC1C\uACAC\uD588\uB098\uBCF4\uB124\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380436
    m_Localized: "\uB098 \uD0A4 \uC548\uC791\uC544... \uD559\uAD50\uC5D0\uC11C\uB294
      \uB0B4\uAC00 \uC81C\uC77C \uCEF8\uB2E4\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380437
    m_Localized: "\uD1A0\uB07C\uB294 \uBC1C\uC744 \uB4E4\uC5B4 \uD0A4\uB97C \uD06C\uAC8C
      \uBCF4\uC774\uAC8C \uD558\uC600\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380438
    m_Localized: "\uADF8 \uC21C\uAC04, \uC591\uC774 \uB2E4\uAC00\uC640 \uB098\uC5D0\uAC8C
      \uB9D0\uC744 \uAC78\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380439
    m_Localized: "\uC774\uAC70, \uB9C8\uC9C0\uB9C9 \uBCF4\uC548 \uD574\uC81C \uCF54\uB4DC\uC5D0\uC694.
      \uC0AC\uC2E4 \uBCF4\uC548\uC2E4\uC5D0\uC11C \uCC3E\uC558\uC5B4\uC694. \n\uC6B0\uB9AC
      \uB458\uB9CC \uCE58\uB8CC\uC81C\uB97C \uAC00\uC9C0\uACE0 \uC788\uB294\uAC8C
      \uC5B4\uB54C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380440
    m_Localized: "\uC591\uC758 \uC81C\uC548\uC744 \uC218\uB77D\uD560\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380441
    m_Localized: "\uC6B0\uB9AC \uB458\uB9CC \uCE58\uB8CC\uC81C\uB97C \uB3C5\uC810\uD560\uC218\uB294
      \uC5C6\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380442
    m_Localized: "\uC7AC\uBC0C\uB124\uC694... \uC5B4\uCA4C\uBA74 \uC695\uC2EC\uC774
      \uC5C6\uB294\uAC78\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380443
    m_Localized: "\uB9C8\uC74C\uC774 \uBC14\uB00C\uC5C8\uC5B4\uC694. \uC774\uB7EC\uBA74
      \uB2F9\uC2E0\uC774 \uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C \uC81C\uAC00 \uCF54\uB4DC\uB97C
      \uAC00\uC9C0\uACE0 \uC788\uB2E4\uB294\uAC78 \uB9D0\uD558\uBA74 \uACE4\uB780\uD574\uC9C0\uB2C8\u2026\n\uC774\uAC70.
      \uB2F9\uC2E0\uC5D0\uAC8C \uB4DC\uB9B4\uAC8C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380444
    m_Localized: "(\uB9C8\uC9C0\uB9C9 \uBCF4\uC548\uD574\uC81C \uCF54\uB4DC \uD68D\uB4DD)"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380445
    m_Localized: "\uC5B4\uB5BB\uAC8C \uD65C\uC6A9\uD560\uC9C0\uB294 \uB2F9\uC2E0
      \uC790\uC720\uC608\uC694. \uAE30\uB300\uD574 \uBCFC\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380446
    m_Localized: "\uADF8\uB798\uC694? \uC544\uC8FC \uB9C8\uC74C\uC5D0 \uB4DC\uB294
      \uB2F5\uBCC0\uC774\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380447
    m_Localized: "\uC591\uC740 \uB9CC\uC871\uC2A4\uB7EC\uC6B4 \uBBF8\uC18C\uB97C
      \uC9C0\uC73C\uBA70 \uC790\uC2E0\uC758 \uC8FC\uBA38\uB2C8\uC5D0 \uBCF4\uC548
      \uCF54\uB4DC\uB97C \uCC59\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380448
    m_Localized: "\uC774 \uCF54\uB4DC\uB294 \uACC4\uC18D \uC81C\uAC00 \uBCF4\uAD00\uD558\uACE0
      \uC788\uC744\uAC8C\uC694. \n\uAE30\uD68C\uB97C \uBD10\uC11C \uB458\uC774\uC11C\uB9CC
      \uCC59\uACA8 \uB2EC\uC544\uB098\uC790\uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380449
    m_Localized: "\uC88B\uC544... \uADF8\uB7FC \uC774 \uCE74\uB4DC\uD0A4\uB85C \uC9C0\uD558\uB85C
      \uAC00\uBA74 \uB418\uACA0\uC5B4. \uAC00\uC790\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380450
    m_Localized: "\uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC740 \uC591\uACFC \uB098\uB204\uB294
      \uB300\uD654\uB97C \uB208\uCE58\uCC44\uC9C0 \uBABB\uD55C \uCC44 \uC9C0\uD558\uB85C
      \uD1B5\uD558\uB294 \uBE44\uC0C1 \uACC4\uB2E8\uC744 \uD5A5\uD574 \uAC78\uC74C\uC744
      \uC62E\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380451
    m_Localized: "\uC774\uC81C \uCE58\uB8CC\uC81C\uAC00 \uC788\uB294 \uC9C0\uD558\uB85C
      \uB3C4\uB2EC\uD558\uAC8C \uB418\uC5C8\uB2E4. \n\uD558\uC9C0\uB9CC \uD76C\uBC15\uD55C
      \uCE58\uB8CC\uC81C\uC758 \uBD80\uC791\uC6A9, \uD0C8\uCD9C\uC758 \uAC00\uB2A5\uC131.."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380452
    m_Localized: "\uC5EC\uB7EC \uAC00\uB2A5\uC131\uB4E4\uC774 \uB9C8\uC74C\uC5D0
      \uAC78\uB838\uC74C\uC5D0\uB3C4 \uBC1C\uAC78\uC74C\uC744 \uBA48\uCD9C\uC218\uB294
      \uC5C6\uC5C8\uB2E4. \uADF8\uACF3\uC5D0\uB294 \uC0AC\uAC74\uC758 \uB05D\uC774
      \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744 \uAC83\uC774\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380453
    m_Localized: "\uADF8\uB9AC\uACE0... \uB0B4 \uBCC0\uD654\uB294 \uC774\uC81C \uBA48\uCD9C
      \uC218 \uC5C6\uC744 \uC815\uB3C4\uB85C \uBE60\uB974\uAC8C \uC9C4\uD589\uB418\uACE0
      \uC788\uC5C8\uB2E4. \uB9C8\uCE58 \uB098 \uC790\uC2E0\uC774... \uB2E4\uB978
      \uC874\uC7AC\uB85C \uBCC0\uD574\uAC00\uACE0 \uC788\uB294 \uAC83\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380454
    m_Localized: "\uC9C0\uD558\uB85C \uB0B4\uB824\uC624\uC790 \uAC70\uB300\uD55C
      \uBC1C\uC804\uAE30\uAC00 \uAD49\uC74C\uC744 \uB0B4\uBA70 \uB3CC\uC544\uAC00\uACE0
      \uC788\uC5C8\uB2E4. \n\uC2B5\uD558\uACE0 \uCC28\uAC00\uC6B4 \uACF5\uAE30\uAC00
      \uD53C\uBD80\uB97C \uAC10\uC30C\uACE0, \uAE08\uC18D\uC131 \uB0C4\uC0C8\uAC00
      \uCF54\uB97C \uCC14\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380455
    m_Localized: "\uC774\uACF3\uC740 \uC2DC\uC124\uC758 \uC2EC\uC7A5\uBD80\uC774\uC790,
      \uBAA8\uB4E0 \uBE44\uBC00\uC774 \uC7A0\uB4E4\uC5B4 \uC788\uB294 \uACF3 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380456
    m_Localized: "...\uB4DC\uB514\uC5B4. \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uAD70\uC694.
      \uB098\uC758 \uAD6C\uC6D0\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380457
    m_Localized: "\uC591\uC740 \uBBF8\uC18C\uB97C \uC9C0\uC73C\uBA70 \uB098\uB97C
      \uBC14\uB77C\uBD24\uB2E4. \uADF8\uB140\uC758 \uB208\uBE5B\uC740 \uB354 \uC774\uC0C1
      \uC21C\uC9C4\uD558\uC9C0 \uC54A\uC558\uB2E4.\n\uADF8\uACF3\uC5D0\uB294 \uC624\uC9C1
      \uD655\uC2E0\uACFC \uAD11\uAE30\uB9CC\uC774 \uAC00\uB4DD\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380458
    m_Localized: "\uAD6C\uC6D0\uC790? \uADF8\uAC74 \uB610 \uBB34\uC2A8\uC18C\uB9AC\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380459
    m_Localized: "\uC800\uD76C\uB294 \uBAA8\uB450 \uBD88\uCE58\uBCD1\uC73C\uB85C
      \uC8FD\uC5B4\uAC00\uACE0\uC788\uC5C8\uC9C0\uB9CC... \uC800\uD76C\uB294 \uB2F9\uC2E0\uC774
      \uB9CC\uB4E0 \uC57D \uB355\uBD84\uC5D0 \uC0B4\uC544\uB0A8\uC558\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380460
    m_Localized: "\uADF8\uB9AC\uACE0... \uC544\uC9C1 \uB2F9\uC2E0\uC740 \uAE30\uC5B5\uC774
      \uC804\uBD80 \uB3CC\uC544\uC624\uC9C0\uB294 \uC54A\uC740 \uAC83 \uAC19\uB124\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380461
    m_Localized: "\uC774 \uC5F0\uAD6C\uC18C, \uC81C\uAC00 \uB9CC\uB4E4\uC5C8\uAC70\uB4E0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380462
    m_Localized: "\uC5F0\uAD6C\uC18C\uB97C?? ... \uADF8\uAC8C \uC5B4\uB5BB\uAC8C
      \uAC00\uB2A5\uD55C\uAC70\uC57C? \n\uB3C8\uB3C4, \uC2DC\uAC04\uB3C4... \uB4E4\uC5B4\uAC08
      \uAC8C \uD55C\uB450 \uAC00\uC9C0\uAC00 \uC544\uB2D0 \uD150\uB370?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380463
    m_Localized: "\uBD80\uBAA8\uB2D8\uC774 \uC0AC\uACE0\uB85C \uB3CC\uC544\uAC00\uC2E0
      \uB4A4... \uC720\uC0B0\uC774 \uC0DD\uACBC\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380464
    m_Localized: "\uCC98\uC74C\uC5D4, \uADF8\uC800 \uBD80\uBAA8\uB2D8\uC774 \uB0A8\uACA8\uC8FC\uC2E0
      \uBAA9\uC7A5\uACFC \uC7AC\uC0B0\uC744 \uC798 \uC9C0\uD0A4\uACE0 \uC2F6\uC5C8\uC5B4\uC694.
      \n\uC774\uB7F0 \uC5F0\uAD6C\uC18C\uB97C \uB9CC\uB4E4 \uC0DD\uAC01\uC740...
      \uC804\uD600 \uC5C6\uC5C8\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380465
    m_Localized: "\uD558\uC9C0\uB9CC \uC81C\uAC00 \uD63C\uC790 \uB0A8\uAC8C \uB418\uC790...
      \n\uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC774 \uD558\uB098\uB458\uC529 \uC81C\uAC8C
      \uAD00\uC2EC\uC744 \uBCF4\uC774\uAE30 \uC2DC\uC791\uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380466
    m_Localized: "\uCC98\uC74C\uC5D0\uB294 \uB2E4\uB4E4 \uC800\uB97C \uC9C4\uC2EC\uC73C\uB85C
      \uAC71\uC815\uD574\uC8FC\uB294 \uC904 \uC54C\uC558\uC8E0. \n\uADF8\uB7F0\uB370...
      \uC7A5\uB840\uC2DD\uC774 \uB05D\uB098\uAE30\uB3C4 \uC804\uC5D0 \uBCF8\uC0C9\uC744
      \uB4DC\uB7EC\uB0C8\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380467
    m_Localized: "\uBAA9\uC7A5\uC740 \uB204\uAC00 \uAD00\uB9AC\uD560 \uAC70\uB2C8?'\n'\uC720\uC0B0\uC740
      \uC5B4\uB5BB\uAC8C \uD560 \uC0DD\uAC01\uC774\uB2C8?'\n'\uB0B4\uAC00 \uB300\uC2E0
      \uAD00\uB9AC\uD574\uC8FC\uB9C8.' \uC640 \uAC19\uC740 \uAC70\uC9D3\uB9D0\uB4E4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380468
    m_Localized: "\uB2E4\uB4E4 \uBD88\uC30D\uD558\uB2E4\uB294 \uB208\uC73C\uB85C
      \uBC14\uB77C\uBD24\uC9C0\uB9CC... \uACB0\uAD6D \uC6D0\uD588\uB358 \uAC74 \uC81C
      \uB3C8\uACFC \uB545\uC774\uC5C8\uB358 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380469
    m_Localized: "\uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC774 \uD558\uB098\uB458 \uB2EC\uB824\uB4DC\uB294
      \uAC78 \uBCF4\uBA74\uC11C \uC54C\uC558\uC8E0. \uC0AC\uB78C\uB4E4\uC740 \uAC70\uC9D3\uB9D0\uB9CC
      \uD558\uACE0. \n\uB204\uAD6C\uB3C4 '\uB098'\uB77C\uB294 \uC0AC\uB78C\uC5D0\uAC90
      \uAD00\uC2EC\uC774 \uC5C6\uAD6C\uB098. \uB0B4\uAC00 \uAC00\uC9C4 \uAC83\uB9CC
      \uBCF4\uACE0 \uC788\uAD6C\uB098\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380470
    m_Localized: "\uB108\uBB34\uD574..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380471
    m_Localized: "\uAC8C\uB2E4\uAC00 \uC5BC\uB9C8 \uC9C0\uB098\uC9C0 \uC54A\uC544
      \uBD88\uCE58\uBCD1\uAE4C\uC9C0... \uC815\uB9D0 \uC138\uC0C1\uC774 \uC804\uBD80
      \uBB34\uB108\uC838 \uB0B4\uB9AC\uB294 \uAC83 \uAC19\uC558\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380472
    m_Localized: "\uC624\uC9C1 \uC0B4\uACE0 \uC2F6\uB2E4\uB294 \uB9C8\uC74C \uD558\uB098\uB85C
      \uC774 \uC5F0\uAD6C\uC18C\uB97C \uC138\uC6E0\uACE0, \uC81C \uC2A4\uC2A4\uB85C
      \uCCAB \uBC88\uC9F8 VIP \uD658\uC790\uAC00 \uB418\uC5C8\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380473
    m_Localized: "\uC591\uC740 \uB098\uB97C \uCCD0\uB2E4\uBCF4\uBA70 \uC54C\uC218\uC5C6\uB294
      \uD45C\uC815\uC73C\uB85C \uB9D0\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380474
    m_Localized: "\uADF8\uB7F0\uB370... \uBAA9\uC7A5\uC5D0 \uC788\uB358 \uC544\uC774\uB4E4\uC740
      \uB2EC\uB790\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380475
    m_Localized: "\uAC15\uC544\uC9C0\uB294 \uC81C\uAC00 \uC6B8\uBA74 \uB9D0\uC5C6\uC774
      \uACC1\uC744 \uC9C0\uCF1C\uC92C\uACE0, \uD1A0\uB07C\uB294 \uB2F9\uADFC \uD558\uB098\uC5D0\uB3C4
      \uC138\uC0C1\uC744 \uB2E4 \uAC00\uC9C4 \uB4EF \uD589\uBCF5\uD574\uD588\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380476
    m_Localized: "\uC5EC\uC6B0\uB294... \uC7A5\uB09C\uAE30\uAC00 \uB9CE\uC544 \uC120\uB73B
      \uB2E4\uAC00\uAC00\uAE34 \uC5B4\uB824\uC6E0\uC9C0\uB9CC, \n\uADF8\uC800 \uC9C0\uCF1C\uBCF4\uB294
      \uAC83\uB9CC\uC73C\uB85C\uB3C4 \uC990\uAC70\uC6E0\uACE0, \uC591\uB4E4\uC740...
      \uC544\uBB34\uB7F0 \uC870\uAC74 \uC5C6\uC774 \uADF8\uC800 \uC800\uB97C \uBBFF\uACE0
      \uB530\uB77C\uC654\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380477
    m_Localized: "\uAC70\uAE30\uC5D4 \uC695\uC2EC\uB3C4, \uBC30\uC2E0\uB3C4 \uC5C6\uC5C8\uB358
      \uAC70\uC608\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380478
    m_Localized: "...\uADF8\uB798\uC11C \uC0AC\uB78C\uB4E4\uC744 \uB3D9\uBB3C\uB85C
      \uB9CC\uB4E4\uACA0\uB2E4\uB294 \uAC70\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380479
    m_Localized: "\uC9C0\uAE08\uC740 \uB2E4\uB4E4 \uC5B4\uB5A4\uAC00\uC694? \uC608\uC804\uBCF4\uB2E4
      \uAC70\uC9D3\uB9D0\uC744 \uD558\uAE30\uAC00 \uC5B4\uB835\uC9C0 \uC54A\uB098\uC694?
      \uBAA8\uB450 \uC21C\uC218\uD574\uC9C0\uACE0 \uC788\uC796\uC544\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380480
    m_Localized: "...\uADF8\uAC74 \uBD80\uC791\uC6A9 \uB54C\uBB38\uC774\uC57C"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380481
    m_Localized: "\uBD80\uC791\uC6A9\uC774 \uC544\uB2C8\uC5D0\uC694. \uC6B0\uB9AC\uB294
      \uC9C4\uD654\uB97C \uD558\uACE0 \uC788\uB294\uAC70\uC8E0"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380482
    m_Localized: "...\uBBF8\uCCE4\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380483
    m_Localized: "\uADF8\uB7F4\uC9C0\uB3C4 \uBAA8\uB974\uC8E0... \uD558\uC9C0\uB9CC
      \uACB0\uC2EC\uD588\uC5B4\uC694. \uBAA8\uB450\uAC00 \uB3D9\uBB3C\uC774 \uB41C\uB2E4\uBA74...
      \n\uB2E4\uB978 \uB204\uAD6C\uB3C4 \uAC70\uC9D3\uB9D0 \uB54C\uBB38\uC5D0 \uC0C1\uCC98\uBC1B\uC9C0
      \uC54A\uC744 \uAC70\uB77C\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380484
    m_Localized: "\uC5B8\uB2C8\uAC00... \uC774\uC0C1\uD574..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380485
    m_Localized: "\uD6C4\uD6C4... \uB450\uB824\uC6CC\uD560 \uAC83 \uC5C6\uC5B4\uC694.
      \uACE7 \uB2F9\uC2E0\uB4E4\uB3C4 \uC9C4\uC815\uD55C \uC790\uC720\uB97C \uC5BB\uAC8C
      \uB420 \uD14C\uB2C8\uAE4C. \n\uC790, \uB098\uC758 \uAD6C\uC6D0\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380486
    m_Localized: "\uC774\uC81C \uB9C8\uC9C0\uB9C9 \uC120\uD0DD\uC744 \uD560 \uC2DC\uAC04\uC785\uB2C8\uB2E4.
      \n\uC800 \uAE08\uACE0 \uC548\uC5D0 \uCE58\uB8CC\uC81C\uC640 \uBE44\uC0C1 \uC2DC\uC2A4\uD15C
      \uD574\uC81C \uCF54\uB4DC\uAC00 \uC788\uC796\uC544\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380487
    m_Localized: "\uD568\uAED8, \uC778\uB958\uB97C \uC9C4\uD654\uC2DC\uD0A4\uB294\uAC70\uC5D0\uC694.
      \uB2F9\uC2E0\uC774 \uC120\uD0DD\uD558\uB294 \uB300\uB85C, \uC0C8\uB85C\uC6B4
      \uC138\uC0C1\uC774 \uC5F4\uB9B4 \uAC81\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380488
    m_Localized: "\uC591\uC740 \uAC70\uB300\uD55C \uAE08\uACE0\uB97C \uAC00\uB9AC\uCF30\uB2E4.
      \uAE08\uACE0\uC758 \uBB38\uC740 \uAD73\uAC8C \uB2EB\uD600 \uC788\uC5C8\uACE0,
      \n\uADF8 \uC704\uC5D0\uB294 \uBCF5\uC7A1\uD55C \uC554\uD638 \uC7A5\uCE58\uAC00
      \uB2EC\uB824 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380489
    m_Localized: "\uB098\uB294 \uB0B4 \uC190\uC744 \uBC14\uB77C\uBD24\uB2E4. \uB098\uC758
      \uC218\uC778\uD654\uB294 \uC774\uC81C \uAC70\uC758 \uC644\uC131 \uB2E8\uACC4\uC5D0
      \uC774\uB974\uB800\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380490
    m_Localized: "\uB0B4 \uC548\uC758 \uB3D9\uBB3C\uC801 \uBCF8\uB2A5\uC774 \uC774\uC131\uC744
      \uC7A0\uC2DD\uD558\uB824 \uD558\uACE0 \uC788\uC5C8\uB2E4. \uB098\uB294 \uC120\uD0DD\uD574\uC57C
      \uD588\uB2E4. \n\uC778\uAC04\uC131\uC744 \uC9C0\uD0AC \uAC83\uC778\uAC00, \uC544\uB2C8\uBA74
      \uC0C8\uB85C\uC6B4 \uC138\uC0C1\uC758 \uCC3D\uC870\uC8FC\uAC00 \uB420 \uAC83\uC778\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380491
    m_Localized: "\uCD5C\uD6C4\uC758 \uC120\uD0DD: \uC591\uC758 \uC81C\uC548\uC5D0
      \uB3D9\uC758\uD560\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380492
    m_Localized: "\uC591\uC758 \uB2EC\uCF64\uD55C \uC720\uD639\uC5D0 \uB098\uB294
      \uACB0\uAD6D \uBB34\uB98E\uC744 \uAFC7\uC5C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380493
    m_Localized: "\uADF8\uB798, \uC778\uAC04\uC740 \uCD94\uC545\uD574. \uCC28\uB77C\uB9AC
      \uC9D0\uC2B9\uC73C\uB85C \uC0AC\uB294 \uAC8C \uB098\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380494
    m_Localized: "\uB098\uB294 \uAE08\uACE0 \uC548\uC758 \uBC31\uC2E0\uC744 \uAEBC\uB0B4
      \uB4E4\uC5C8\uB2E4. \uB3D9\uB8CC\uB4E4\uC758 \uB208\uBE5B\uC740 \uC774\uBBF8
      \uC774\uC131\uC744 \uC783\uACE0 \uC788\uC5C8\uB2E4. \n\uB098\uB294 \uBC14\uB2E5\uC5D0
      \uC57D\uC744 \uB5A8\uC5B4\uB728\uB824 \uBD80\uC234\uBC84\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380495
    m_Localized: "\uC21C\uAC04, \uB054\uCC0D\uD55C \uACE0\uD1B5\uACFC \uD568\uAED8
      \uB9C8\uC9C0\uB9C9 \uB0A8\uC740 \uC774\uC131\uC758 \uB048\uC774 \uD22D \uB04A\uC5B4\uC84C\uB2E4.
      \n\uC6B0\uB9AC\uB294 \uC778\uAC04\uC758 \uC5B8\uC5B4\uB97C \uC644\uC804\uD788
      \uC0C1\uC2E4\uD558\uACE0 \uC9D0\uC2B9\uC758 \uC6B8\uC74C\uC18C\uB9AC\uB9CC\uC744
      \uB0B4\uBC49\uC73C\uBA70 \uBC14\uB2E5\uC744 \uAE30\uC5B4 \uB2E4\uB154\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380496
    m_Localized: "\uC591\uC740 \uBBF8\uC18C\uB97C \uC9C0\uC73C\uBA70 \uC774 \uAD11\uACBD\uC744
      \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380497
    m_Localized: "\uBCF4\uC138\uC694, \uC5BC\uB9C8\uB098 \uD3C9\uD654\uB86D\uACE0
      \uC21C\uC218\uD55C\uAC00\uC694..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380498
    m_Localized: "\uAC71\uC815 \uB9C8\uC138\uC694. \uC774 \uC644\uBCBD\uD55C \uB099\uC6D0\uC5D0\uC11C...
      \uC81C\uAC00 \uD3C9\uC0DD \uB2F9\uC2E0\uB4E4\uC744 \uC0AC\uB791\uD558\uACE0
      \uBCF4\uC0B4\uD3B4 \uC904\uAC8C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380499
    m_Localized: "\uC2DC\uC124\uC758 \uBB38\uC740 \uC601\uAD6C\uC801\uC73C\uB85C
      \uD3D0\uC1C4\uB418\uC5C8\uACE0, \uADF8\uACF3\uC740 \uC778\uAC04\uC758 \uC774\uC131\uC774
      \uBC30\uC81C\uB41C \uC644\uBCBD\uD55C \uC9D0\uC2B9\uB4E4\uC758 \uC694\uB78C\uC774
      \uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380500
    m_Localized: "\uB098\uB294 \uC591\uC758 \uB2EC\uCF64\uD55C \uC81C\uC548\uC744
      \uB2E8\uCE7C\uC5D0 \uAC70\uC808\uD588\uB2E4. \n\uD558\uC9C0\uB9CC \uAE08\uACE0\uB97C
      \uC5F4 \uC218 \uC788\uB294 \uBE44\uC0C1 \uC2DC\uC2A4\uD15C \uD574\uC81C \uCF54\uB4DC\uB294
      \uC591\uC5D0\uAC8C \uC788\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380501
    m_Localized: "\uC88B\uC544\uC694, \uC5F0\uAD6C \uCC45\uC784\uC790\uB2D8... \uADF8\uB7EC\uBA74
      \uC774 \uBE44\uC0C1 \uC2DC\uC2A4\uD15C \uD574\uC81C \uCF54\uB4DC\uB294 \uD3D0\uAE30\uD574\uC57C\uACA0\uB124\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380502
    m_Localized: "\uC591\uC740 \uC5B4\uB290\uC0C8 \uC6B0\uB9AC\uC5D0\uAC8C\uC11C
      \uBE60\uC838\uB098\uC640 \uCF54\uB4DC\uAC00 \uC801\uD78C \uC885\uC774\uB97C
      \uBA39\uC5B4\uBC84\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380503
    m_Localized: "\uADF8\uB9AC\uACE0\uB294 \uBBF8\uC18C\uB97C \uC9C0\uC73C\uBA70,
      \uCF54\uB4DC\uAC00 \uC801\uD78C \uC885\uC774\uB97C \uC0BC\uCF1C\uBC84\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380504
    m_Localized: "\uB0A8\uC740 \uBC29\uBC95\uC740 \uC5C6\uC5C8\uB2E4. \uD0C8\uCD9C\uD560
      \uBC29\uBC95\uB3C4 \uC5C6\uC5C8\uB2E4. \uB098\uB294 \uB3C4\uBC15\uC744 \uD574\uC57C\uB9CC
      \uD588\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380505
    m_Localized: "\uB098\uB294 \uB5A8\uB9AC\uB294 \uC190\uC73C\uB85C \uB0A8\uC740
      \uC2DC\uC57D\uC744 4\uB4F1\uBD84 \uD558\uC5EC \uB098\uC640 \uB3D9\uB8CC\uB4E4\uC758
      \uD608\uAD00\uC5D0 \uC870\uAE08\uC529 \uB098\uB204\uC5B4 \uC8FC\uC0AC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380506
    m_Localized: "\uBD88\uC644\uC804\uD558\uACE0 \uD131\uC5C6\uC774 \uBD80\uC871\uD55C
      \uC591\uC774\uC5C8\uB2E4. \uD558\uC9C0\uB9CC \uADF8 \uC9C0\uC625 \uAC19\uC740
      \uD1B5\uC99D \uC18D\uC5D0\uC11C... "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380507
    m_Localized: "\uC815\uB9D0 \uC624\uB79C \uC2DC\uAC04\uC774 \uAC78\uB824 \uC6B0\uB9AC\uB294
      \uAC04\uC2E0\uD788 '\uC778\uAC04\uC758 \uC774\uC131'\uB9CC\uC740 \uC783\uC9C0
      \uC54A\uC740 \uCC44\n \uBE44\uC0C1 \uC2DC\uC2A4\uD15C\uC744 \uD574\uC81C\uD558\uACE0
      \uD0C8\uCD9C\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380508
    m_Localized: "\uB208\uBD80\uC2E0 \uC9C0\uC0C1, \uADF8\uB9AC\uC6CC\uD558\uB358
      \uC778\uAC04\uB4E4\uC758 \uB9C8\uC744\uB85C \uB0B4\uB824\uAC14\uB2E4. \n\uD558\uC9C0\uB9CC
      \uC6B0\uB9AC\uB97C \uB9DE\uC544\uC900 \uAC83\uC740 \uAD6C\uC6D0\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380509
    m_Localized: "\uC0AC\uB78C\uB4E4\uC740 \uBE44\uBA85\uC744 \uC9C0\uB974\uBA70
      \uC6B0\uB9AC\uC5D0\uAC8C \uB3CC\uC744 \uB358\uC84C\uACE0, \n\uACE7\uC774\uC5B4
      \uC0AC\uC774\uB80C \uC18C\uB9AC\uC640 \uD568\uAED8 \uACBD\uCC30\uC774 \uCD9C\uB3D9\uD574
      \uC6B0\uB9AC\uB97C \uCCB4\uD3EC\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380510
    m_Localized: "\uC544\uC218\uB77C\uC7A5 \uC18D\uC5D0\uC11C \uD1A0\uB07C\uC640
      \uC5EC\uC6B0\uB294 \uC5B4\uB514\uB860\uAC00 \uB04C\uB824\uAC14\uB2E4. \n\uB098\uC640
      \uB9AC\uD2B8\uB9AC\uBC84\uB294 \uACA8\uC6B0 \uC5B4\uB461\uACE0 \uAE4A\uC740
      \uC0B0\uC18D\uC73C\uB85C \uB3C4\uB9DD\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380511
    m_Localized: "\uC591\uC758 \uB9D0\uC774 \uB9DE\uC558\uB2E4. \uAC70\uC9D3\uB41C
      \uC778\uAC04 \uC0AC\uD68C\uB294 \uC6B0\uB9AC\uB97C \uBC1B\uC544\uC8FC\uC9C0
      \uC54A\uC558\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380512
    m_Localized: "\uB098\uB294 \uC9D0\uC2B9\uC758 \uD138\uB85C \uB4A4\uB36E\uC778
      \uC190\uC744 \uBCF4\uBA70 \uC9D0\uC2B9\uCC98\uB7FC \uC6B8\uBD80\uC9D6\uC5C8\uB2E4.
      \n\uC6B0\uB9AC\uB294 \uC601\uC6D0\uD788 \uC778\uAC04 \uC0AC\uD68C\uC5D0\uC11C
      \uCD94\uBC29\uB41C \uCC44, \uC9D0\uC2B9\uC758 \uC0B6\uC744 \uC0B4\uC544\uAC00\uC57C
      \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380513
    m_Localized: "\uB2F9\uC2E0\uC740 \uD2C0\uB838\uC5B4. \uC774\uAC74 \uAD6C\uC6D0\uC774
      \uC544\uB2C8\uB77C \uD30C\uBA78\uC774\uC57C. \n\uC6B0\uB9AC\uAC00 \uC778\uAC04\uC73C\uB85C\uC11C
      \uC313\uC544\uC628 \uBAA8\uB4E0 \uAC78 \uBD80\uC815\uD558\uACE0 \uB3C4\uB9DD\uCE58\uB294
      \uAC83\uC5D0 \uBD88\uACFC\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380514
    m_Localized: "\uC5B4\uB9AC\uC11D\uAD70\uC694... \uACB0\uAD6D \uB2F9\uC2E0\uB3C4
      \uBB34\uC9C0\uD55C \uC800\uB4E4\uACFC \uB2E4\uB97C \uAC8C \uC5C6\uC5C8\uC5B4.
      \uC9C4\uC2E4\uB41C \uB3D9\uBB3C\uB85C \uC0B4\uC544\uAC00\uB294 \uAC8C \uAC70\uC9D3\uB41C
      \uC778\uAC04\uC73C\uB85C \uC0AC\uB294\uAC70\uBCF4\uB2E4 \uD6E8\uC52C \uB098\uC544!"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380515
    m_Localized: "\uAE08\uACE0\uC758 \uC554\uD638\uB97C \uD480\uACE0, \uADF8 \uC548\uC5D0\uC11C
      \uBC31\uC2E0\uC744 \uBC1C\uACAC\uD588\uB2E4. \uBC31\uC2E0\uC740 \uB2E8 2\uAC1C.
      \n\uD558\uC9C0\uB9CC \uB098\uB294 \uC5F0\uAD6C \uCC45\uC784\uC790\uB85C\uC11C
      \uCD94\uAC00 \uBC31\uC2E0\uC744 \uC0DD\uC0B0\uD560 \uBC29\uBC95\uC744 \uC54C\uACE0
      \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380516
    m_Localized: "\uADF8\uB54C, \uC591\uC740 \uBD84\uB178\uD558\uBA70 \uB098\uC5D0\uAC8C
      \uB2EC\uB824\uB4E4\uC5C8\uACE0, \uBC31\uC2E0 1\uAC1C\uAC00 \uAE68\uC838\uBC84\uB838\uB2E4.
      \n\uC5EC\uC6B0\uC640 \uB9AC\uD2B8\uB9AC\uBC84\uC5D0\uAC8C \uC81C\uC555\uB418\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380517
    m_Localized: "\uC790... \uC774\uC81C \uC5B4\uB5BB\uAC8C \uD560\uAC70\uC57C? \uADF8
      \uC911\uC694\uD55C \uC57D\uC774 1\uAC1C\uBC16\uC5D0 \uB0A8\uC9C0 \uC54A\uC558\uB124?
      \n\uC774\uC131\uC744 \uC783\uAE30\uC804\uC5D0 \uB2F9\uC5F0\uD788 \uB124\uAC00
      \uBA39\uB294\uAC8C \uC88B\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380518
    m_Localized: "\uC81C\uAC00... \uC774 \uC57D\uC744 \uBA39\uACE0 \uBAA8\uB450 \uC6D0\uB798\uB300\uB85C
      \uB3CC\uB824\uB193\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380519
    m_Localized: "\uBC31\uC2E0\uC774 \uD558\uB098\uB9CC \uB354 \uC788\uC5C8\uC5B4\uB3C4
      \uB0B4\uAC00 \uAC10\uC2DC\uD588\uC744\uD150\uB370 \uC544\uC27D\uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380520
    m_Localized: "\uB2F9\uC2E0\uC740 \uBBFF\uC744\uB9CC\uD55C \uC0AC\uB78C\uC774\uB2C8\uAE4C.
      \uBC18\uB4DC\uC2DC \uB418\uB3CC\uB824\uC904\uAC70\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380521
    m_Localized: "\uB098 \uC774\uC81C \uC5B4\uB9B0\uC774\uAC00 \uC544\uB2C8\uB2C8\uAE4C...
      \uC529\uC529\uD558\uAC8C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744\uAC8C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380522
    m_Localized: "\uB098\uB294 \uB098 \uC2A4\uC2A4\uB85C\uC5D0\uAC8C \uBC31\uC2E0\uC744
      \uD22C\uC5EC\uD588\uB2E4. \uBA38\uB9AC\uC18D\uC774 \uB9D1\uC544\uC9C0\uBA70
      \uC815\uC2E0\uC774 \uB3CC\uC544\uC624\uB294 \uB290\uB08C\uC774\uC5C8\uB2E4..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380523
    m_Localized: "\uADF8 \uC774\uD6C4\uB85C\uB294 \uC5F0\uAD6C \uB370\uC774\uD130\uAC00
      \uB2F4\uAE34 USB\uC744 \uD1B5\uD574 \uBBF8\uC644\uC131 \uCE58\uB8CC\uC81C\uC744
      \uCD94\uAC00 \uC0DD\uC0B0\uD558\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380524
    m_Localized: "\uB098\uB294 \uBAA8\uB450\uC5D0\uAC8C \uBC31\uC2E0\uC744 \uD22C\uC5EC\uD558\uC600\uACE0...
      \uB9C8\uC9C0\uB9C9\uC5D0\uB294 \uC591\uC5D0\uAC8C \uCE58\uB8CC\uC81C\uB97C
      \uD22C\uC5EC\uD558\uC600\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380525
    m_Localized: "\uC591, \uB2F9\uC2E0\uC774 \uBC14\uB77C\uB294 \uAC74 '\uC9C4\uC2E4\uB41C
      \uB3D9\uBB3C'\uB85C\uC11C \uC0AC\uB294 \uAC83\uC774\uB77C\uACE0 \uD588\uC9C0.
      \n\uD558\uC9C0\uB9CC \uC774\uC131\uC744 \uC783\uC740 \uC9D0\uC2B9\uC740 \uAD6C\uC6D0\uC774
      \uC544\uB2C8\uB77C \uD30C\uBA78\uC77C \uBFD0\uC774\uC57C. \n\uB098\uC640 \uD611\uC0C1\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380526
    m_Localized: "\uB2F9\uC2E0\uC758 \uC138\uB825\uACFC \uC790\uC6D0\uC744 \uC9C0\uC6D0\uD574
      \uC918. \uB098\uB294 \uC0AC\uB78C\uB4E4\uC774 \uC774\uC131\uC744 \uC783\uC9C0
      \uC54A\uB294 \uC218\uC778\uD654 \uC57D\uC744 \uC0DD\uC0B0\uD558\uACE0, \n\uCD5C\uC885\uC801\uC73C\uB85C\uB294
      \uC218\uC778\uC744 \uC644\uBCBD\uD55C \uC778\uAC04\uC73C\uB85C \uB418\uB3CC\uB9AC\uB294
      \uC9C4\uC9DC \uCE58\uB8CC\uC81C\uAE4C\uC9C0 \uAC1C\uBC1C\uD558\uACA0\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380527
    m_Localized: "\uC591\uC740 \uB098\uB97C \uCC28\uAC11\uAC8C \uBC14\uB77C\uBCF4\uB2E4\uAC00,
      \uC774\uB0B4 \uBE44\uD2C0\uB9B0 \uBBF8\uC18C\uB97C \uC9C0\uC73C\uBA70 \uB0B4
      \uC81C\uC548\uC744 \uBC1B\uC544\uB4E4\uC600\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380528
    m_Localized: "\uC88B\uC544\uC694, \uC5F0\uAD6C \uCC45\uC784\uC790\uB2D8... \uB2F9\uC2E0\uC758
      \uC5B4\uB514\uAE4C\uC9C0 \uB3C4\uB2EC\uD560 \uC218 \uC788\uB294\uC9C0 \uC9C0\uCF1C\uBCF4\uC8E0.
      \n\uB300\uC2E0, \uC57D\uC18D\uC740 \uBC18\uB4DC\uC2DC \uC9C0\uD0A4\uC154\uC57C
      \uD560 \uAC70\uC608\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380529
    m_Localized: "\uC591\uC758 \uC9C0\uC6D0 \uC544\uB798, \uC6B0\uB9AC \uC5F0\uAD6C\uC18C\uB294
      \uC678\uBD80\uC640 \uCCA0\uC800\uD788 \uCC28\uB2E8\uB41C \uCC44 \uB354\uC6B1
      \uBE44\uBC00\uB9AC\uC5D0 \uC5F0\uAD6C\uB97C \uC9C4\uD589\uD558\uAC8C \uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380530
    m_Localized: "\uC591\uC758 \uC790\uAE08\uB825\uACFC \uC790\uC6D0, \n\uADF8\uB9AC\uACE0
      \uBAA8\uB450\uC758 \uD611\uB825\uC774 \uB354\uD574\uC9C0\uC790 \uCE68\uCCB4\uB418\uC5B4
      \uC788\uB358 \uC5F0\uAD6C\uB294 \uBE60\uB974\uAC8C \uC9C4\uC804\uC744 \uBCF4\uC774\uAE30
      \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380531
    m_Localized: "\uC544\uC9C1\uC740 \uBCC0\uD574\uBC84\uB9B0 \uC2E0\uCCB4\uB97C
      \uC628\uC804\uD55C \uC778\uAC04\uC758 \uBAA8\uC2B5\uC73C\uB85C \uC644\uC804\uD788
      \uB3CC\uB824\uB193\uB294 \uBC29\uBC95\uC744 \uCC3E\uC9C0 \uBABB\uD588\uB2E4.
      \n\uC6B0\uB9AC\uB294 \uC5EC\uC804\uD788 \uB3D9\uBB3C\uC758 \uBAA8\uC2B5\uC744
      \uD55C \uCC44 \uC0B4\uC544\uAC00\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380532
    m_Localized: "\uD558\uC9C0\uB9CC... \uC6B0\uB9AC\uB294 \uBC18\uB4DC\uC2DC \uBC29\uBC95\uC744
      \uCC3E\uC544\uB0BC \uAC83\uC774\uB2E4. \uC783\uC5B4\uBC84\uB9B0 \uC6B0\uB9AC\uC758
      \uBAA8\uC2B5\uACFC, \n\uBE7C\uC557\uAE34 \uC778\uAC04\uC73C\uB85C\uC11C\uC758
      \uC0B6\uC744 \uB418\uCC3E\uC744 \uB54C\uAE4C\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380533
    m_Localized: "\uB098\uB294 \uB5A8\uB9AC\uB294 \uC190\uC73C\uB85C \uD558\uB098
      \uB0A8\uC740 \uBC31\uC2E0\uC744 \uB9AC\uD2B8\uB9AC\uBC84\uC5D0\uAC8C \uC0AC\uC6A9\uD588\uB2E4.
      \n\uBC31\uC2E0\uC774 \uC8FC\uC785\uB418\uC790, \uADF8\uB140\uC758 \uD63C\uD0C1\uD588\uB358
      \uB208\uBE5B\uC5D0 \uB9D1\uC740 \uC774\uC131\uC758 \uBE5B\uC774 \uB3CC\uC544\uC624\uAE30
      \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380534
    m_Localized: "...\uC5B4? \uC815\uC2E0\uC774... \uB3CC\uC544\uC624\uB294 \uAC83
      \uAC19\uC544\uC694. \uD558\uC9C0\uB9CC... \uC5B4\uC9F8\uC11C? \uD558\uB098\uBFD0\uC778
      \uC57D\uC744 \uC65C \uC800\uD55C\uD14C...?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380535
    m_Localized: "\uB0B4\uAC00 \uCC45\uC784\uC790\uC600\uC73C\uB2C8\uAE4C\uC694.
      \uBAA8\uB450\uB97C \uC9C0\uD0A4\uC9C0 \uBABB\uD55C \uB0B4 \uD0D3\uC785\uB2C8\uB2E4.
      \n\uB2F9\uC2E0\uC774\uB77C\uB3C4... \uC0B4\uC544\uB0A8\uC544 \uC774\uC131\uC744
      \uC9C0\uD0A4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380536
    m_Localized: "\uB098\uB294 \uC5F0\uAD6C\uC18C\uC5D0\uC11C \uBA40\uB9AC \uB5A8\uC5B4\uC9C4
      \uD3D0\uAC00\uC640 \uB3D9\uAD74\uC758 \uC704\uCE58\uAC00 \uC801\uD78C \uC8FC\uC18C\uB97C
      \uC801\uC5B4\uC8FC\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380537
    m_Localized: "\uCD5C\uC545\uC758 \uACBD\uC6B0 \uC774\uACF3\uC73C\uB85C \uAC00\uBA74\u2026
      \uC2DD\uB7C9\uACFC \uC740\uC2E0\uCC98 \uBB38\uC81C\uB97C \uD574\uACB0\uD560
      \uC218 \uC788\uC744\uAC81\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380538
    m_Localized: "\uC774\uC131\uC744 \uB418\uCC3E\uC740 \uB9AC\uD2B8\uB9AC\uBC84\uC758
      \uB208\uB3D9\uC790\uAC00 \uACA9\uB82C\uD558\uAC8C \uD754\uB4E4\uB838\uB2E4.
      \n\uC9D0\uC2B9\uC73C\uB85C \uBCC0\uD574\uAC00\uBA70 \uB290\uAF08\uB358 \uADF9\uC2EC\uD55C
      \uACF5\uD3EC, "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380539
    m_Localized: "\uADF8\uB9AC\uACE0 \uC790\uC2E0\uC744 \uC704\uD574 \uBAA9\uC228\uACFC\uB3C4
      \uAC19\uC740 \uC57D\uC744 \uC591\uBCF4\uD55C \uB2F9\uC2E0\uC5D0 \uB300\uD55C
      \uAC10\uC815\uC774 \n\uADF8\uB140\uC758 \uB1CC\uB9AC \uC18D\uC5D0\uC11C \uAE30\uBB18\uD558\uAC8C
      \uBE44\uD2C0\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380540
    m_Localized: "\uC9D0\uC2B9\uC774 \uB418\uC5B4\uAC00\uB358 \uC790\uC2E0\uC5D0\uAC8C,
      \uBCC4\uB2E4\uB978 \uCE5C\uBD84\uB3C4 \uC5C6\uB358 \uC774 \uC0AC\uB78C\uC774
      \n\uC790\uC2E0\uC758 \uBAA9\uC228\uC774\uB098 \uB2E4\uB984\uC5C6\uB294 \uBC31\uC2E0\uC744
      \uAE30\uAEBC\uC774 \uB118\uACA8\uC8FC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380541
    m_Localized: "\uADF8 \uC0AC\uC2E4\uC774 \uADF8\uB140\uC758 \uBB34\uB108\uC9C4
      \uB9C8\uC74C\uC5D0 \uAE30\uBB18\uD55C '\uAC01\uC778'\uC744 \uB0A8\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380542
    m_Localized: "\uC5B4\uC9F8\uC11C...? \uD63C\uC790 \uC0B4 \uC218 \uC788\uC5C8\uB294\uB370
      \uC65C \uB098\uD55C\uD14C... \n\uB0A8\uC744 \uC704\uD574\uC11C \uC774\uB807\uAC8C
      \uC27D\uAC8C \uC790\uAE30 \uC790\uC2E0\uC744 \uBC84\uB9B0\uAC74\uAC00\uC694?
      \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380543
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84\uB294 \uB098\uC9C1\uD558\uAC8C \uC911\uC5BC\uAC70\uB9AC\uB354\uB2C8,
      \uD55C\uCE35 \uAE4A\uC5B4\uC9C4 \uB208\uBE5B\uC73C\uB85C \n\uB0B4 \uC190\uBAA9\uC744
      \uC5B5\uC138\uAC8C \uC7A1\uC544\uCC58\uB2E4. \uAC70\uC808\uD560 \uC218 \uC5C6\uB294
      \uAC15\uD55C \uD798\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380544
    m_Localized: "\uC544\uC544... \uC54C\uACA0\uC5B4\uC694... \uB2F9\uC2E0 \uAC19\uC740
      \uC0AC\uB78C\uC740... \uB108\uBB34 \uB2E4\uC815\uD558\uACE0 \uBB3C\uB7EC\uC11C
      \uBB38\uC81C\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380545
    m_Localized: "\uC774 \uACE0\uD1B5\uC2A4\uB7EC\uC6B4 \uC138\uC0C1\uC5D0 \uB2F9\uC2E0\uC744
      \uD63C\uC790 \uB450\uC9C0 \uC54A\uC744 \uAC70\uC608\uC694. \n\uADF8\uB9AC\uACE0...
      \uB2F9\uC2E0\uAC19\uC740 \uCC29\uD55C \uC0AC\uB78C\uC774 \uB0A8\uC744 \uC704\uD574
      \uC2A4\uC2A4\uB85C\uB97C \uD76C\uC0DD\uD558\uAC8C \uB450\uC9C0\uB3C4 \uC54A\uC744
      \uAC70\uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380546
    m_Localized: "\uC774\uC81C \uC544\uBB34\uB3C4 \uB2F9\uC2E0\uC744 \uC2E4\uD5D8\uCCB4\uB85C
      \uC4F0\uC9C0 \uBABB\uD574\uC694. \uC774\uC6A9\uD560 \uC218\uB3C4 \uC5C6\uC8E0.
      \n\uB2F9\uC2E0\uC774 \uC54C\uB824\uC900 \uC774\uACF3\uC5D0\uC11C... \uC800\uC640
      \uD568\uAED8, \uD3C9\uC0DD \uC548\uC804\uD558\uAC8C \uC9C0\uB0B4\uB294 \uAC70\uC608\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380547
    m_Localized: "\uC778\uAC04\uC758 \uC9C0\uB2A5\uC744 \uB418\uCC3E\uC740 \uADF8\uB140\uC758
      \uC815\uAD50\uD568\uACFC, \uAC1C \uD2B9\uC720\uC758 \uB9F9\uBAA9\uC801\uC778
      \uCDA9\uC131\uC2EC\uC774 \uACB0\uD569\uD55C \uC9D1\uCC29. \n\uB098\uB294 \uADF8\uB140\uC758
      \uC190\uC5D0 \uC774\uB04C\uB824 \uC544\uBB34\uB3C4 \uCC3E\uC744 \uC218 \uC5C6\uB294
      \uC5B4\uB460 \uC18D\uC73C\uB85C \uB04C\uB824\uB4E4\uC5B4 \uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380548
    m_Localized: "\uADF8\uB140\uB294 \uB098\uB97C \uC644\uBCBD\uD558\uAC8C \uAC10\uAE08\uD558\uACE0
      \uC0AC\uC721\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4. \n\uADF8\uAC83\uC774 \uADF8\uB140\uAC00
      \uC0DD\uAC01\uD558\uB294 \uC720\uC77C\uD55C '\uBCF4\uC740'\uC774\uC790 '\uBCF4\uD638'\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380549
    m_Localized: "\uC57D\uC740 \uCC28\uAC00\uC6B4 \uBAB8\uC744 \uCE58\uB8CC\uD574
      \uC8FC\uC5C8\uC9C0\uB9CC, \n\uC774\uC131\uC744 \uC783\uC5B4\uAC00\uB358 \uC21C\uAC04
      \uB2F9\uC2E0\uC5D0\uAC8C \uC0C8\uACA8\uC9C4 \uB9F9\uBAA9\uC801\uC778 \uAC01\uC778\uACFC
      \uBB34\uB108\uC9C4 \uB9C8\uC74C\uAE4C\uC9C0 \uACE0\uCCD0\uC8FC\uC9C0\uB294
      \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380550
    m_Localized: "\uB098\uB294 \uB9AC\uD2B8\uB9AC\uBC84\uC758 \uC190\uC5D0 \uC774\uB04C\uB824
      \uAE4A\uC740 \uB3D9\uAD74 \uC18D\uC73C\uB85C \uB4E4\uC5B4\uAC14\uB2E4. \n\uADF8\uB140\uB294
      \uB098\uB97C \uC644\uBCBD\uD558\uAC8C \uAC10\uAE08\uD588\uB2E4. \uB098\uB294
      \uC774 \uC548\uC804\uD55C \uAC10\uC625\uC5D0\uC11C \uACC4\uC18D \uC0DD\uD65C\uD558\uAC8C
      \uB418\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380551
    m_Localized: "\uB098\uB294 \uB5A8\uB9AC\uB294 \uC190\uC73C\uB85C \uD558\uB098
      \uB0A8\uC740 \uBC31\uC2E0\uC744 \uC5EC\uC6B0\uC5D0\uAC8C \uC0AC\uC6A9\uD588\uB2E4.
      \n\uBC31\uC2E0\uC774 \uC8FC\uC785\uB418\uC790, \uADF8\uC758 \uD63C\uD0C1\uD588\uB358
      \uB208\uBE5B\uC5D0 \uB0A0\uCE74\uB85C\uC6B4 \uC774\uC131\uC758 \uBE5B\uC774
      \uB3CC\uC544\uC624\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380552
    m_Localized: "\uC774\uAC74... \uD558\uB098\uBC16\uC5D0 \uB0A8\uC9C0 \uC54A\uC740
      \uBC31\uC2E0\uC744... \uC65C \uB098\uD55C\uD14C \uC8FC\uB294 \uAC70\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380553
    m_Localized: "\uC5F0\uAD6C \uCC45\uC784\uC790\uB85C\uC11C \uBAA8\uB450\uB97C
      \uC774\uB807\uAC8C \uB9CC\uB4E0 \uCC45\uC784\uC774 \uC788\uC2B5\uB2C8\uB2E4...
      \n\uB2F9\uC2E0\uB9CC\uC774\uB77C\uB3C4 \uC774\uC131\uC744 \uC9C0\uD0A4\uACE0
      \uC5EC\uAE30\uC11C \uB098\uAC00\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380554
    m_Localized: "\uD558\uC9C0\uB9CC \uAC10\uB3D9\uB3C4 \uC7A0\uC2DC, \uC5EC\uC6B0\uB294
      \uAC11\uC790\uAE30 \uBA38\uB9AC\uB97C \uC6C0\uCF1C\uC950\uBA70 \uD5C9 \uC18C\uB9AC\uC640
      \uD568\uAED8 \uBC14\uB2E5\uC5D0 \uC5CE\uB4DC\uB7EC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380555
    m_Localized: "\uD06C\uC73D...! \uBA38\uB9AC\uAC00... \uBAB8\uC774 \uBD80\uC11C\uC9C8
      \uAC83 \uAC19\uC544...!"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380556
    m_Localized: "\uC5EC\uC6B0 \uC528! \uAD1C\uCC2E\uC2B5\uB2C8\uAE4C?! \uC774\uC131\uC774
      \uB3CC\uC544\uC624\uBA74\uC11C \uBC1C\uC0DD\uD558\uB294 \uBD80\uC791\uC6A9\uC77C\uAC81\uB2C8\uB2E4,
      \uC870\uAE08\uB9CC \uCC38\uC73C\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380557
    m_Localized: "\uADF9\uC2EC\uD55C \uD1B5\uC99D \uC18D\uC5D0\uC11C \uC774\uC131\uC744
      \uCC3E\uC740 \uC5EC\uC6B0\uC758 \uB208\uB3D9\uC790\uAC00 \uCC28\uAC11\uACE0
      \uC11C\uB298\uD558\uAC8C \uB4A4\uD2C0\uB838\uB2E4. \n\uC9C0\uC625 \uAC19\uC740
      \uBD80\uC791\uC6A9\uC758 \uD1B5\uC99D\uC774 \uADF8\uC758 \uBD88\uC2E0\uC5D0
      \uBD88\uC744 \uBD99\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380558
    m_Localized: "\uBB54\uAC00 \uC774\uC0C1\uD574... \uC544\uC9C1\uB3C4.. \uBA38\uB9AC\uAC00
      \uC544\uD30C... \uC774\uAC8C \uC815\uB9D0 \uBC31\uC2E0\uC774 \uB9DE\uB294\uAC70\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380559
    m_Localized: "\uB108... \uB0B4\uAC00 \uB098\uAC00\uBA74 \uBAB0\uB798 \uB2E4\uB978
      \uACF3\uC73C\uB85C \uD0C8\uCD9C\uD560 \uC0DD\uAC01\uC774\uC9C0? \uC544\uB2C8\uBA74
      \uD639\uC2DC \uBA40\uCA61\uD55C\uB370 \uC5F0\uAE30\uD558\uB294\uAC70 \uC544\uB2C8\uC57C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380560
    m_Localized: "\uC544\uB2D9\uB2C8\uB2E4! \uC815\uB9D0 \uC774\uC131\uC744 \uB418\uCC3E\uC544\uC8FC\uAE30
      \uC704\uD574...!"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380561
    m_Localized: "\uC785 \uB2E4\uBB3C\uC5B4! \uB0B4\uAC00 \uC774 \uD1B5\uC99D \uB54C\uBB38\uC5D0
      \uBC1C\uC744 \uBB36\uC778 \uC0AC\uC774, \n\uB10C \uC228\uACA8\uB454 \uC9C4\uC9DC
      \uCE58\uB8CC\uC81C\uB97C \uB9DE\uACE0 \uD63C\uC790 \uD288 \uC0DD\uAC01\uC774\uC5C8\uACA0\uC9C0!
      \uC548 \uADF8\uB798?!"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380562
    m_Localized: "\uBD88\uC548\uD574\uC11C \uC548 \uB418\uACA0\uC5B4... \uB110 \uADF8\uB0E5
      \uB450\uACE0 \uB098\uAC00\uBA74 \uBB34\uC2A8 \uC9D3\uC744 \uD560\uC9C0 \uBAB0\uB77C.
      \uBB36\uACE0 \uAC08\uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380563
    m_Localized: "\uBD80\uC791\uC6A9\uC758 \uD1B5\uC99D\uC73C\uB85C \uAD11\uAE30\uC5D0
      \uD729\uC2F8\uC778 \uC5EC\uC6B0\uB294 \uB0B4 \uB9D0\uC744 \uB4E4\uC73C\uB824
      \uD558\uC9C0\uB3C4 \uC54A\uC740 \uCC44 \n\uB098\uB97C \uAC15\uC81C\uB85C \uAE30\uB465\uC5D0
      \uB2E8\uB2E8\uD788 \uBB36\uC5B4\uBC84\uB838\uACE0, \uBE44\uD2C0\uAC70\uB9AC\uB294
      \uAC78\uC74C\uC73C\uB85C \uD63C\uC790 \uD0C8\uCD9C\uAD6C\uB97C \uD5A5\uD574
      \uC0AC\uB77C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380564
    m_Localized: "...\uC5BC\uB9C8\uB098 \uC2DC\uAC04\uC774 \uD758\uB800\uC744\uAE4C.
      \n\uC815\uC2E0\uC744 \uC783\uC5C8\uB2E4\uAC00 \uACA8\uC6B0 \uB208\uC744 \uB72C
      \uB098\uC758 \uADD3\uAC00\uC5D0 \uC591\uC758 \uB098\uC9C0\uB9C9\uD55C \uBAA9\uC18C\uB9AC\uAC00
      \uB4E4\uB824\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380565
    m_Localized: "\uD6C4\uD6C4\uD6C4... \uBCF4\uC168\uB098\uC694? \uB2F9\uC2E0\uC774
      \uBAA9\uC228 \uBC14\uCCD0 \uAD6C\uD574\uC8FC\uB824\uB358 '\uC778\uAC04'\uC774
      \uB2F9\uC2E0\uC744 \uC5B4\uB5BB\uAC8C \uBC84\uB838\uB294\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380566
    m_Localized: "\uACB0\uAD6D \uC778\uAC04\uC740 \uAC70\uC9D3\uB9D0\uACFC \uBC30\uC2E0\uC744
      \uD574..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380567
    m_Localized: "\uAC71\uC815 \uB9C8\uC138\uC694, \uAD6C\uC6D0\uC790\uB2D8. \uB2F9\uC2E0\uC740
      \uC81C\uAC00 \uC798 \uAD00\uB9AC\uD574 \uB4DC\uB9B4\uAC8C\uC694. \n\uC6B0\uB9AC...
      \uC55E\uC73C\uB85C \uC798 \uC9C0\uB0B4\uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380568
    m_Localized: "\uB098\uB294 \uC218\uC778\uD654\uB41C \uCC44\uB85C, \uC774\uC131\uB9C8\uC800
      \uB9C8\uBE44\uB418\uC5B4 \uC591\uC758 \uC190\uC5D0 \uAC70\uB450\uC5B4\uC84C\uB2E4.
      \n\uADF8\uB807\uAC8C \uB098\uB294 \uC601\uC6D0\uD788 \uC774 \uAE30\uAD34\uD55C
      \uC2DC\uC124\uC758 \uC218\uC9D1\uD488\uC73C\uB85C \uB0A8\uAC8C \uB418\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380569
    m_Localized: "\uB098\uB294 \uB5A8\uB9AC\uB294 \uC190\uC73C\uB85C \uD558\uB098
      \uB0A8\uC740 \uBC31\uC2E0\uC744 \uD1A0\uB07C\uC5D0\uAC8C \uC0AC\uC6A9\uD588\uB2E4.
      \uBC31\uC2E0\uC774 \uC8FC\uC785\uB418\uC790, \n\uADF8\uB140\uC758 \uBD88\uC548\uD558\uAC8C
      \uD754\uB4E4\uB9AC\uB358 \uB208\uB3D9\uC790\uC5D0 \uCC28\uBD84\uD55C \uC774\uC131\uC758
      \uBE5B\uC774 \uB3CC\uC544\uC624\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380570
    m_Localized: "...\uC5B4? \uBA38\uB9AC\uAC00... \uBD84\uBA85 \uC544\uBB34 \uC0DD\uAC01\uB3C4
      \uD560\uC218\uAC00 \uC5C6\uC5C8\uB294\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380571
    m_Localized: "\uB2E4\uD589\uC785\uB2C8\uB2E4... \uCE58\uB8CC\uC81C\uAC00 \uD6A8\uACFC\uAC00
      \uC788\uB294 \uBAA8\uC591\uC774\uAD70\uC694. \uC774\uC81C \uC774\uC131\uC744
      \uC9C0\uD0AC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380572
    m_Localized: "\uD558\uC9C0\uB9CC \uC628\uC804\uD55C \uC778\uAC04\uC758 \uC9C0\uB2A5\uC774
      \uB3CC\uC544\uC624\uC790\uB9C8\uC790, \uD1A0\uB07C\uC758 \uC5BC\uAD74\uC740
      \uCC3D\uBC31\uD574\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380573
    m_Localized: "\uADF8\uB807\uAC8C \uC6D0\uD55C \uCE58\uB8CC\uC81C\uB3C4 \uACB0\uAD6D
      \uBAB8\uC758 \uBCC0\uD654\uB97C \uB3CC\uB824\uC8FC\uC9C0\uB294 \uBABB\uD588\uB2E4.
      \n\uC8FC\uBCC0\uC5D0 \uBCF4\uC774\uB294 \uC774\uC131\uC744 \uC783\uACE0 \uC9D0\uC2B9\uC774
      \uB418\uC5B4\uAC00\uB294 \uC0AC\uB78C\uB4E4\uC744 \uBCF4\uBA70 \uC808\uB9DD\uC744
      \uB290\uB07C\uACE0 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380574
    m_Localized: "\uBAB8\uC774... \uC0AC\uB78C\uC73C\uB85C \uBCC0\uD558\uC9C0 \uC54A\uC558\uC5B4.
      \uBD84\uBA85 \uC5B8\uB2C8\uB4E4\uC774 \uC0AC\uB78C\uC774 \uC544\uB2C8\uB77C\uBA74
      \uC704\uD5D8\uD558\uB314\uB294\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380575
    m_Localized: "\uC800 \uBC16\uC740 \uC704\uD5D8\uD574... \uB108\uBB34 \uBB34\uC11C\uC6CC!
      \uC5EC\uAE38 \uB098\uAC00\uB3C4 \uC704\uD5D8\uD560\uAC70\uC57C... \n\uC5B4\uB518\uAC00\uC5D0\uC11C
      \uB098\uB97C \uC2E4\uD5D8\uD560\uC9C0\uB3C4 \uBAB0\uB77C. \uB2E4\uC2DC \uAC00\uB458
      \uAC70\uB77C\uACE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380576
    m_Localized: "\uD1A0\uB07C \uC528, \uC9C4\uC815\uD558\uC138\uC694! \uC800\uB294
      \uD798\uB4E4\uACA0\uC9C0\uB9CC \uB3C4\uC6C0\uC744 \uAD6C\uD560 \uC218 \uC788\uC744\uAC81\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380577
    m_Localized: "\uADF8\uB9AC\uACE0... \uB9CC\uC57D \uB3C4\uC6C0\uC744 \uAD6C\uD560
      \uC218 \uC5C6\uB2E4\uBA74 \uC774 \uCABD\uC9C0\uC5D0 \uC801\uD78C \uC704\uCE58\uB85C
      \uAC00\uBCF4\uC138\uC694. \n\uCD5C\uD6C4\uC758 \uC218\uB2E8\uC73C\uB85C \uC678\uB534
      \uC12C\uC5D0\uC11C \uC0B4\uC544\uAC08 \uC218 \uC788\uC744\uAC81\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380578
    m_Localized: "\uD1A0\uB07C\uB294 \uB2F9\uC2E0\uC758 \uC637\uC790\uB77D\uC744
      \uBD80\uB7EC\uB728\uB9B4 \uB4EF \uC6C0\uCF1C\uC950\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380579
    m_Localized: "\uC544\uB2C8\uC57C! \uBC16\uC740 \uC548\uB3FC! \uBBFF\uC744\uB9CC\uD55C
      \uC0AC\uB78C\uC774 \uD544\uC694\uD574... \n\uB2F9\uC2E0\uC740 \uB098\uC5D0\uAC8C
      \uD558\uB098\uBFD0\uC778 \uBC31\uC2E0\uC744 \uC900 \uC0AC\uB78C\uC774\uB2C8\uAE4C...
      \uBBFF\uC744 \uC218 \uC788\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380580
    m_Localized: "\uB098\uB791 \uAC19\uC774 \uAC00\uC790. \uC6B0\uB9AC \uC138\uC0C1\uC744
      \uD53C\uD574 \uC228\uB294\uAC70\uC57C"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380581
    m_Localized: "\uC774\uC131\uACFC \uC9C0\uB2A5\uC744 \uB418\uCC3E\uC740 \uD1A0\uB07C\uC758
      \uD310\uB2E8\uB825\uC740 \uC624\uC9C1 '\uC644\uBCBD\uD558\uAC8C \uC228\uAE30
      \uC704\uD55C \uACC4\uC0B0'\uC5D0\uB9CC \uC3E0\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4.
      \n\uADF8\uB140\uB294 \uB098\uB97C \uAC15\uC81C\uB85C \uB04C\uACE0 \uBE44\uC0C1
      \uD0C8\uCD9C\uB85C\uB97C \uD5A5\uD574 \uBBF8\uCE5C \uB4EF\uC774 \uB2EC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380582
    m_Localized: "...\uADF8 \uD6C4, \uD1A0\uB07C\uB294 \uC544\uBB34\uB3C4 \uCC3E\uC744
      \uC218 \uC5C6\uB294 \uC678\uB534\uC12C\uC758 \uD3D0\uAC00\uB85C \uB098\uB97C
      \uB04C\uACE0 \uB4E4\uC5B4\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380583
    m_Localized: "\uADF8\uB140\uB294 \uBC14\uAE65\uC138\uC0C1\uACFC \uD1B5\uD558\uB294
      \uBAA8\uB4E0 \uBB38\uACFC \uCC3D\uBB38\uC744 \uACB9\uACB9\uC774 \uBD09\uC1C4\uD558\uACE0,
      \n\uB0B4\uAC00 \uBB38\uBC16\uC73C\uB85C \uB098\uAC00\uC9C0 \uBABB\uD558\uB3C4\uB85D
      \uAC10\uAE08\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380584
    m_Localized: "\uB2E4\uD589\uC774\uC57C... \uC5EC\uAE34 \uC548\uC804\uD574. \uC544\uBB34\uB3C4
      \uC624\uC9C0 \uBABB\uD574. \uB2F9\uC2E0\uB3C4, \uB098\uB3C4... \uD3C9\uC0DD
      \uC5EC\uAE30\uC11C \uC548 \uB098\uAC00\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380585
    m_Localized: "\uBC31\uC2E0\uC740 \uC2E0\uCCB4\uC801\uC778 \uC218\uC778\uD654\uB97C
      \uBA48\uCD94\uACE0 \uC774\uC131\uC744 \uB418\uCC3E\uC544\uC8FC\uC5C8\uC9C0\uB9CC,
      \n\uC9C0\uB2A5\uACFC \uD568\uAED8 \uB3CC\uC544\uC628 \uAC70\uB300\uD55C \uACF5\uD3EC\uC640
      \uBB34\uB108\uC9C4 \uB9C8\uC74C\uAE4C\uC9C0 \uACE0\uCCD0\uC8FC\uC9C0\uB294
      \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380586
    m_Localized: "\uC6B0\uB9AC\uB294 \uADF8\uB807\uAC8C \uD3C9\uC0DD \uD3D0\uC1C4\uB41C
      \uC5B4\uB460 \uC18D\uC5D0\uC11C \uD568\uAED8 \uC0B4\uC544\uAC00\uAC8C \uB418\uC5C8\uC9C0\uB9CC,
      \n\uD1A0\uB07C\uC758 \uB208\uB3D9\uC790 \uC18D \uAE43\uB4E0 \uAE4A\uC740 \uACF5\uD3EC\uB294
      \uC601\uC6D0\uD788 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380587
    m_Localized: "\uC591\uC758 \uB2EC\uCF64\uD55C \uC720\uD639\uC5D0 \uB098\uB294
      \uACB0\uAD6D \uBB34\uB98E\uC744 \uAFC7\uC5C8\uB2E4. \"\uADF8\uB798, \uC778\uAC04\uC740
      \uCD94\uC545\uD574. \uCC28\uB77C\uB9AC \uC9D0\uC2B9\uC73C\uB85C \uC0AC\uB294
      \uAC8C \uB098\uC544.\" "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380588
    m_Localized: "\uBB50? \uC9C0\uAE08 \uBB34\uC2A8\uC18C\uB9AC\uC57C \uBAA8\uB450\uAC00
      \uB3D9\uBB3C\uC774 \uB418\uB294 \uC138\uC0C1\uC744 \uC6D0\uD55C\uB2E4\uACE0?
      \uB108 \uBBF8\uCE5C\uAC70\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380589
    m_Localized: "\uC5B4\uCA50\uC9C0 \uCC98\uC74C\uBD80\uD130 \uC704\uD654\uAC10\uC774
      \uB290\uAEF4\uC9C4\uB2E4 \uD588\uC5B4\uC694... \uB2F9\uC2E0, \uC81C\uC815\uC2E0\uC774
      \uC544\uB2C8\uAD70\uC694..."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380590
    m_Localized: "\uC5B4, \uC5B8\uB2C8\uB4E4... \uB098 \uBB34\uC11C\uC6CC... \uB3C4\uB300\uCCB4
      \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB098\uB294 \uAC70\uC57C...?"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380591
    m_Localized: "\uB354 \uC774\uC0C1 \uB9D0 \uD574\uBD24\uC790 \uC18C\uC6A9\uC5C6\uC5B4.
      \uC774 \uBC31\uC2E0\uC740 \uC6B0\uB9AC\uAC00 \uAC00\uC838\uAC04\uB2E4! \n\uC801\uC5B4\uB3C4
      \uC14B\uC774\uC11C \uB098\uB204\uC5B4 \uD22C\uC5EC\uD55C\uB2E4\uBA74 \uC5B4\uB5BB\uAC8C\uB4E0
      \uB418\uACA0\uC9C0!"
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380592
    m_Localized: "\uB098\uC640 \uC591\uC744 \uC81C\uC678\uD55C \uC778\uC6D0\uB4E4\uC740
      \uBC31\uC2E0\uC744 \uCC59\uACA8 \uAE09\uD788 \uB5A0\uB098\uBC84\uB838\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380593
    m_Localized: "\uBAA8\uB450\uAC00 \uB098\uB97C \uBC84\uB838\uB2E4. \uBC30\uC2E0\uC790\uB77C\uACE0
      \uC695\uD558\uBA70 \uB5A0\uB0AC\uB2E4. \n\uC808\uB9DD\uC5D0 \uBE60\uC9C4 \uB0B4\uAC8C
      \uC591\uC774 \uB2E4\uAC00\uC640 \uC190\uC744 \uB0B4\uBC00\uC5C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380594
    m_Localized: "\uBCF4\uC138\uC694... \uB2F9\uC2E0\uC744 \uC774\uD574\uD574 \uC8FC\uB294
      \uAC74 \uB098\uBFD0\uC774\uC5D0\uC694. \uC774 \uC138\uC0C1\uC744 \uBCC0\uD558\uAC8C
      \uD560 \uC218 \uC788\uB294 \uC720\uC77C\uD55C \uC0AC\uB78C\uC774\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380595
    m_Localized: "\uB2F9\uC2E0\uC740 \uB098\uC758 \uAD6C\uC6D0\uC790\uC57C. \uC774
      \uCD94\uC545\uD55C \uC138\uC0C1\uC744 \uCD08\uAE30\uD654\uD560 \uC218 \uC788\uB294
      \uC720\uC77C\uD55C \uC0AC\uB78C."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380596
    m_Localized: "\uB098\uB294 \uADF8 \uC190\uC744 \uC7A1\uC558\uB2E4. \uADF8\uB798,
      \uB0B4\uAC00 \uB9CC\uB4E0 \uC774 \uBC14\uC774\uB7EC\uC2A4\uB294 \uC2E4\uD328\uC791\uC774
      \uC544\uB2C8\uB77C \uC9C4\uD654\uC758 \uC5F4\uC1E0\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380597
    m_Localized: "\uC6B0\uB9AC\uB294 \uB098\uB97C \uBC84\uB9AC\uACE0 \uAC04 \uB3D9\uB8CC\uB4E4\uC744
      \uC7A1\uC544\uB4E4\uC5EC \uC2E4\uD5D8\uCCB4\uB85C \uC0BC\uC558\uB2E4. \n\uADF8\uB4E4\uC758
      \uBE44\uBA85\uC740 \uC544\uB984\uB2E4\uC6B4 \uB370\uC774\uD130\uAC00 \uB418\uC5C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380598
    m_Localized: "\uBA87 \uB144 \uD6C4. \uC6B0\uB9AC\uB294 \uC644\uBCBD\uD788 \uAC1C\uB7C9\uB41C
      \uC9C4\uD654 \uBC14\uC774\uB7EC\uC2A4\uB97C \uD0D1\uC7AC\uD55C \uB300\uD615
      \uD5EC\uAE30\uC5D0 \uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380599
    m_Localized: "\uD5EC\uAE30 \uCC3D\uBB38 \uC544\uB798\uB85C \uAE30\uACC4\uCC98\uB7FC
      \uBC14\uC058\uAC8C \uC0B4\uC544\uAC00\uB294 \uC778\uAC04\uB4E4\uC758 \uAE4C\uB9C8\uB4DD\uD55C
      \uBE4C\uB529 \uC232\uC774 \uB208\uC5D0 \uB4E4\uC5B4\uC654\uB2E4. \n\uB098\uC640
      \uC591\uC740 \uC11C\uB85C\uC758 \uC190\uC744 \uAF2D \uC7A1\uC740 \uCC44, \uBBF8\uC18C\uB97C
      \uC9C0\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 147044218380600
    m_Localized: "\uC0B4\uD3EC \uC2A4\uC704\uCE58 \uC704\uB85C \uC190\uAC00\uB77D\uC774
      \uC62C\uB77C\uAC14\uB2E4. \n\uB2E8 \uBA87 \uBD84 \uB4A4, \uB098\uB294 \uC774
      \uBBF8\uAC1C\uD55C \uC138\uACC4\uB97C \uB4A4\uC5CE\uACE0 \uC9D0\uC2B9\uC758
      \uC694\uB78C\uC744 \uC138\uC6B8 \uC0C8\uB85C\uC6B4 \uCC3D\uC870\uC8FC\uAC00
      \uB420 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 458421147475968
    m_Localized: "\uBC30\uB4DC\uC5D4\uB5291. \uC9D0\uC2B9\uC758 \uB099\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 458421189419008
    m_Localized: "\uBC30\uB4DC\uC5D4\uB5292. \uAC70\uC9D3\uB41C \uC0AC\uD68C\uC758
      \uCD94\uBC29\uC790\uB4E4"
    m_Metadata:
      m_Items: []
  - m_Id: 458421189419009
    m_Localized: "\uD2B8\uB8E8\uC5D4\uB529. \uB2E4\uC2DC \uD0DC\uC5B4\uB09C \uC778\uAC04"
    m_Metadata:
      m_Items: []
  - m_Id: 458421189419010
    m_Localized: "\uB178\uB9D0\uC5D4\uB529. \uB9F9\uBAA9\uC801\uC778 \uAC10\uAE08"
    m_Metadata:
      m_Items: []
  - m_Id: 458421189419011
    m_Localized: "\uB178\uB9D0\uC5D4\uB529. \uC758\uC2EC\uC758 \uB05D"
    m_Metadata:
      m_Items: []
  - m_Id: 458421189419012
    m_Localized: "\uB178\uB9D0\uC5D4\uB529. \uC644\uBCBD\uD55C \uC740\uC2E0\uCC98"
    m_Metadata:
      m_Items: []
  - m_Id: 458421189419013
    m_Localized: "\uD788\uB4E0\uC5D4\uB529. \uC0C8\uB85C\uC6B4 \uCC3D\uC870\uC8FC"
    m_Metadata:
      m_Items: []
  - m_Id: 458421189419014
    m_Localized: "\uD3C9\uD654\uB85C\uC6B4 \uB099\uC6D0\uC744 \uC120\uD0DD\uD588\uB2E4.
      \n\uB2E8, \uADF8 \uB300\uAC00\uB85C \uC778\uAC04\uC73C\uB85C\uC11C\uC758 \uBAA8\uB4E0
      \uAC83\uC744 \uC783\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 458421189419015
    m_Localized: "\uC778\uAC04\uC131\uC744 \uC9C0\uCF1C\uB0C8\uC9C0\uB9CC, \uC778\uAC04\uB4E4\uC740
      \uC6B0\uB9AC\uB97C \uC778\uAC04\uC73C\uB85C \uBD10\uC8FC\uC9C0 \uC54A\uC558\uB2E4.
      \n\uC6B0\uB9AC\uB294 \uACB0\uAD6D \uC5B4\uB290 \uACF3\uC5D0\uB3C4 \uC18D\uD558\uC9C0
      \uBABB\uD55C \uC874\uC7AC\uAC00 \uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 458421189419016
    m_Localized: "\uBAA8\uB450\uC758 \uC774\uC131\uC744 \uB418\uCC3E\uC740 \uC6B0\uB9AC\uB294
      \uC591\uACFC\uC758 \uD611\uB825\uC744 \uC120\uD0DD\uD588\uB2E4. \n\uC544\uC9C1
      \uC778\uAC04\uC758 \uBAA8\uC2B5\uC73C\uB85C \uB3CC\uC544\uAC00\uC9C0\uB294
      \uBABB\uD588\uC9C0\uB9CC, \uC5B8\uC820\uAC00 \uBAA8\uB4E0 \uAC83\uC744 \uB418\uB3CC\uB9B4
      \uAC83\uC774\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 458421189419017
    m_Localized: "\uADF8\uB140\uB97C \uAD6C\uD558\uAE30 \uC704\uD574 \uC790\uC720\uB97C
      \uD3EC\uAE30\uD588\uB2E4. \n\uB9AC\uD2B8\uB9AC\uBC84\uAC00 \uB9CC\uB4E4\uC5B4
      \uC900 \uC548\uC804\uD55C \uAC10\uC625\uC5D0\uC11C, \uB098\uB294 \uC601\uC6D0\uD788
      \uBCF4\uD638\uBC1B\uAC8C \uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 458421189419018
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uBC31\uC2E0\uC744 \uC591\uBCF4\uD574 \uC5EC\uC6B0\uC758
      \uC774\uC131\uC744 \uB418\uCC3E\uAC8C \uD588\uB2E4. \n\uD558\uC9C0\uB9CC \uADF8\uB140\uC758
      \uBD88\uC2E0\uC740 \uB098\uB97C \uBC84\uB838\uACE0, \uB098\uB294 \uC601\uC6D0\uD788
      \uC591\uACFC \uD568\uAED8 \uB0A8\uACA8\uC9C0\uAC8C \uB418\uC5C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 458421189419019
    m_Localized: "\uC774\uC131\uC744 \uB418\uCC3E\uC740 \uD1A0\uB07C\uB294 \uBC14\uAE65\uC138\uC0C1\uC744
      \uB450\uB824\uC6CC\uD588\uB2E4. \n\uC720\uC77C\uD558\uAC8C \uBBFF\uC744 \uC218
      \uC788\uB294 \uB098\uC640 \uD568\uAED8 \uC228\uAE30 \uC704\uD574, \uADF8\uB140\uB294
      \uC138\uC0C1\uACFC\uC758 \uBAA8\uB4E0 \uC5F0\uACB0\uC744 \uB04A\uC5B4\uBC84\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 458421189419020
    m_Localized: "\uB3D9\uB8CC\uB4E4\uC5D0\uAC8C \uBC84\uB9BC\uBC1B\uC740 \uB098\uB294
      \uC591\uACFC \uD568\uAED8 \uC0C8\uB85C\uC6B4 \uC138\uACC4\uB97C \uC120\uD0DD\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 860170857422848
    m_Localized: "\uAE30\uC5B5 \uC0C1\uC2E4\uC744 \uC194\uC9C1\uD558\uAC8C \uBC1D\uD788\uACE0
      \uC0C1\uD669 \uC124\uBA85\uC744 \uC694\uAD6C\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171584
    m_Localized: "\uCE68\uBB35\uD558\uBA70 \uC0C1\uD669\uC744 \uD30C\uC545\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171585
    m_Localized: "\uBAA8\uB450\uC5D0\uAC8C \uC124\uBA85\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171586
    m_Localized: "\uC124\uBA85\uD558\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171587
    m_Localized: "\uC0AC\uC2E4\uB300\uB85C \uB9D0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171588
    m_Localized: "\uCE58\uB8CC\uC81C\uAC00 \uC5C6\uB2E4\uACE0 \uAC70\uC9D3\uB9D0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171589
    m_Localized: "\uC2E4\uD5D8\uC2E4 \uD0D0\uC0C9 - \uB9AC\uD2B8\uB9AC\uBC84"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171590
    m_Localized: "\uD734\uAC8C\uC2E4 \uD0D0\uC0C9 - \uC5EC\uC6B0"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171591
    m_Localized: "\uAE30\uC5B5\uC774 \uB098\uC9C0 \uC54A\uB294\uB2E4\uACE0 \uC194\uC9C1\uD558\uAC8C
      \uB9D0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171592
    m_Localized: "\uC5F0\uAD6C\uBCF5 \uC870\uAC01\uC744 \uC228\uAE30\uB824 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171593
    m_Localized: "\uB0B4\uAC00 \uB9CC\uB4E0 \uAC8C \uB9DE\uC744 \uC218\uB3C4 \uC788\uC9C0\uB9CC,
      \uAE30\uC5B5\uC774 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171594
    m_Localized: "\uC5EC\uC6B0\uC758 \uD0DC\uBE14\uB9BF\uC744 \uBE7C\uC557\uC73C\uB824
      \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171595
    m_Localized: "\uC544\uB294 \uAC83\uC744 \uB9D0\uD574\uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171596
    m_Localized: "\uBAA8\uB974\uACA0\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171597
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84\uC758 \uBC29 \uD0D0\uC0C9"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171598
    m_Localized: "\uD1A0\uB07C\uC758 \uBC29 \uD0D0\uC0C9"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171599
    m_Localized: "\uC5EC\uC6B0\uC758 \uBC29 \uD0D0\uC0C9"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171600
    m_Localized: "\uC591\uC758 \uBC29 \uD0D0\uC0C9"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171601
    m_Localized: "\uC0AC\uACFC\uD558\uACE0 \uC704\uB85C\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171602
    m_Localized: "\uC0AC\uC9C4\uC744 \uBE7C\uC557\uC73C\uB824 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171603
    m_Localized: "\uBD80\uB4DC\uB7FD\uAC8C \uB9D0\uC744 \uAC74\uB128\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171604
    m_Localized: "\uBB38\uC744 \uC5F4\uC5B4 \uC0C1\uD0DC\uB97C \uD655\uC778\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171605
    m_Localized: "\uC790\uC2E0\uC758 \uBAA9\uC18C\uB9AC\uC784\uC744 \uC778\uC815\uD558\uACE0
      \uACE0\uB1CC\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171606
    m_Localized: "\uB179\uC74C\uAE30\uB97C \uBD80\uC218\uB824 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171607
    m_Localized: "\uC77C\uAE30\uC7A5\uC5D0 \uB300\uD574 \uBB3C\uC5B4\uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171608
    m_Localized: "\uC544\uBB34\uAC83\uB3C4 \uBCF4\uC9C0 \uBABB\uD55C \uCC99 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171609
    m_Localized: "\uBCF4\uC548 \uAD00\uB9AC\uC2E4 \uD0D0\uC0C9 - \uC591"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171610
    m_Localized: "\uD658\uC790 \uB300\uAE30\uC2E4 \uD0D0\uC0C9 - \uD1A0\uB07C"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171611
    m_Localized: "\uC778\uAC04\uC73C\uB85C \uB3CC\uC544\uAC00\uACE0 \uC2F6\uB2E4\uACE0
      \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171612
    m_Localized: "\uB3D9\uBB3C\uC758 \uBAA8\uC2B5\uB3C4 \uC88B\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171613
    m_Localized: "\uC194\uC9C1\uD558\uAC8C \uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171614
    m_Localized: "\uAC70\uC9D3\uB9D0\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171615
    m_Localized: "\uC6B0\uB9AC \uB458\uB9CC \uCE58\uB8CC\uC81C\uB97C \uB3C5\uC810\uD560\uC218\uB294
      \uC5C6\uB2E4\uACE0 \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171616
    m_Localized: "\uC591\uC758 \uC81C\uC548\uC744 \uC218\uB77D\uD558\uC5EC \uCE58\uB8CC\uC81C\uB97C
      \uB3C5\uC810\uD558\uAE30\uB85C \uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171617
    m_Localized: "\uC591\uC758 \uC81C\uC548\uC744 \uAC70\uC808\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171618
    m_Localized: "\uC778\uAC04\uC774 \uB418\uB294\uAC83\uC744 \uD3EC\uAE30\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171619
    m_Localized: "\uC591\uC758 \uB9D0\uC774 \uB9DE\uB2E4. \uBAA8\uB450 \uB3D9\uBB3C\uC774
      \uB418\uC5B4\uC57C \uD55C\uB2E4. (\uC591 \uC81C\uC678 \uC804\uCCB4 \uD638\uAC10\uB3C4
      40\uC774\uD558)"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171620
    m_Localized: "\uB0B4\uAC00 \uBA39\uACE0 \uCE58\uB8CC\uC81C \uAC1C\uBC1C\uC744
      \uC57D\uC18D\uD55C\uB2E4 (\uC591 \uC81C\uC678 \uC804\uCCB4 \uD638\uAC10\uB3C4
      50\uC774\uC0C1)"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171621
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84\uC5D0\uAC8C \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171622
    m_Localized: "\uC5EC\uC6B0\uC5D0\uAC8C \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171623
    m_Localized: "\uD1A0\uB07C\uC5D0\uAC8C \uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 860170895171627
    m_Localized: "\uD638\uAC10\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 862505767739392
    m_Localized: "\uB9AC\uD2B8\uB9AC\uBC84"
    m_Metadata:
      m_Items: []
  - m_Id: 862505776128000
    m_Localized: "\uC5EC\uC6B0"
    m_Metadata:
      m_Items: []
  - m_Id: 862505776128001
    m_Localized: "\uD1A0\uB07C"
    m_Metadata:
      m_Items: []
  - m_Id: 862505776128002
    m_Localized: "\uC591"
    m_Metadata:
      m_Items: []
  - m_Id: 862505776128003
